UCHAR CurrDisplayFrontBack;
UCHAR OldDisplayLeftRight;
UCHAR CurrDisplayLeftRight;

//++, 221212 ysm, FSCU
UCHAR OldDisplaySeatBelt;
UCHAR CurrDisplaySeatBelt;

UCHAR SeatBeltAlarm_Count = 0;
