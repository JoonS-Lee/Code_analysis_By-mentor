#define GEAR_CHANGE_ALARM 		0x04
#define CLUTCH_PROTECTION_ALARM	0x08
#define MAST_ALARM				0x10
#define ANGLE_FB_ALARM			0x20
#define ANGLE_LR_ALARM			0x40
#define AUTOSHIFT_ALARM			0x80



