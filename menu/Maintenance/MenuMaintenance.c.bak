#include "FLV_Cluster_APP.h"

extern UCHAR		nOldPageCount;
UCHAR gMaintenanceItem;
extern st_Maintenance Maintenance_Data[];
extern USHORT temp_interval;
extern unsigned char Engine_Type;
extern EEPROM_MODEL_DATA1 InfoModel1;
extern unsigned char FaultCodeCount_ECM_Current;

void DisplayMenuMaintenance()
{
	USHORT y_Pos[] = {48, 90, 132};

	switch(ScreenIndex)
	{
		case SCREEN_STATE_MENU_MAINTENANCE_PW:									
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_CURRENT:					
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_NEW:						
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_RETYPE:				
			if(OldScreenIndex != ScreenIndex)
			{
				InitializeDisplayPassword(NUMBER_INFO_ENTER);
				DrawMenuFull();
			}
			break;		
		case SCREEN_STATE_MENU_MAINTENANCE_PW_POPUP:		
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_CURRENT_POPUP:					
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_NEW_POPUP:						
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_RETYPE_POPUP:				
			DisplayPasswordPopup();
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_TOP:		
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_TOP:
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_TOP:						
			if(OldScreenIndex != ScreenIndex)
			{
				if((OldScreenIndex != SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_TOP)
					&& (OldScreenIndex != SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_TOP)
					&& (OldScreenIndex != SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_TOP))
				{
					SetListString3(67, 68, 69);
					DisplayListPage(1,2);
					DisplayListAll(((ScreenIndex&0x0F000000)>>24)-1);
					DrawMenuFull();
				}
				else if(OldScreenIndex != ScreenIndex)
				{
					DisplayList(((ScreenIndex&0x0F000000)>>24)-1);
				}
			}
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_TOP:			
			if(OldScreenIndex != ScreenIndex)
			{
				if((OldScreenIndex != SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_TOP))
				{
					SetListString1(70);
					DisplayListPage(2,2);
					DisplayListAll(((ScreenIndex&0x0F000000)>>24)-4);
					DrawMenuFull();
				}
				else if(OldScreenIndex != ScreenIndex)
				{
					DisplayList(((ScreenIndex&0x0F000000)>>24)-4);
				}
			}
			break;

		//++, 221129 ysm, FSCU
		#if 0
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_TOP:			
			if(OldScreenIndex != ScreenIndex)
			{
				if(COUNT_FLAG.Flag_FLT_Check == 1)
				{
					if((OldScreenIndex != SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP)
						&& (OldScreenIndex != SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_TOP))
					{
						SetListString_2(StringMachine[0], StringMachine[3] );
						if(ScreenIndex == SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP)
							DisplayListAll(1);
						else
							DisplayListAll(2);
						
						DrawMenuFull();

						ReadFLTFault(REQ_ERR_ENGINE_ACTIVE);
						ReadFLTFault(REQ_ERR_ENGINE_LOGGED);

						GUI_DisplayRightStringAt_Value2(FaultCodeCount_ECM_Current, 142, y_Pos[0]+9,  60, COLOR_WHITE);
						GUI_DisplayRightStringAt_Value2(HCESPN.H1526, 142, y_Pos[1]+9,  60, COLOR_WHITE);

						
					}
					else if(OldScreenIndex != ScreenIndex)
					{
						
						if(ScreenIndex == SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP)
							DisplayList(1);
						else
							DisplayList(2);

						GUI_DisplayRightStringAt_Value2(FaultCodeCount_ECM_Current, 142, y_Pos[0]+9,  60, COLOR_WHITE);
						GUI_DisplayRightStringAt_Value2(HCESPN.H1526, 142, y_Pos[1]+9,  60, COLOR_WHITE);
						
						
					}
				}
				else
				{
					if(OldScreenIndex != SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP)
					{
						SetListString_1(StringMachine[0]);					
						DisplayListAll(1);
						DrawMenuFull();
						GUI_DisplayRightStringAt_Value2(FaultCodeCount_ECM_Current, 142, y_Pos[0]+9,  60, COLOR_WHITE);
					}
					else
					{
						DisplayList(1);
						GUI_DisplayRightStringAt_Value2(FaultCodeCount_ECM_Current, 142, y_Pos[0]+9,  60, COLOR_WHITE);
					}

				}			

			}
			break;
		#else
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_TOP:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_TOP:
			if(OldScreenIndex != ScreenIndex)
			{
				if((COUNT_FLAG.Flag_FLT_Check == 1)&&(COUNT_FLAG.Flag_FSCU_Enable == 1))
				{
					if((OldScreenIndex != SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP)
						&& (OldScreenIndex != SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_TOP)
						&& (OldScreenIndex != SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_TOP))
					{
						SetListString_3(StringMachine[0], StringMachine[3], StringMachine[4] );
						if(ScreenIndex == SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP)
							DisplayListAll(1);
						else if(ScreenIndex == SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_TOP)
							DisplayListAll(2);
						else
							DisplayListAll(3);
						
						DrawMenuFull();

						ReadFLTFault(REQ_ERR_ENGINE_ACTIVE);
						ReadFLTFault(REQ_ERR_ENGINE_LOGGED);
						ReadFSCUFault(REQ_ERR_ENGINE_ACTIVE);
						ReadFSCUFault(REQ_ERR_ENGINE_LOGGED);

						GUI_DisplayRightStringAt_Value2(FaultCodeCount_ECM_Current, 142, y_Pos[0]+9,  60, COLOR_WHITE);
						GUI_DisplayRightStringAt_Value2(HCESPN.H1526, 142, y_Pos[1]+9,  60, COLOR_WHITE);
						GUI_DisplayRightStringAt_Value2(HCESPN.H1528, 142, y_Pos[2]+9,  60, COLOR_WHITE);

						
					}
					else if(OldScreenIndex != ScreenIndex)
					{
						
						if(ScreenIndex == SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP)
							DisplayList(1);
						else if(ScreenIndex == SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_TOP) 
							DisplayList(2);
						else
							DisplayList(3);

						GUI_DisplayRightStringAt_Value2(FaultCodeCount_ECM_Current, 142, y_Pos[0]+9,  60, COLOR_WHITE);
						GUI_DisplayRightStringAt_Value2(HCESPN.H1526, 142, y_Pos[1]+9,  60, COLOR_WHITE);
						GUI_DisplayRightStringAt_Value2(HCESPN.H1528, 142, y_Pos[2]+9,  60, COLOR_WHITE);
						
						
					}
				}
				else if((COUNT_FLAG.Flag_FLT_Check == 1)&&(COUNT_FLAG.Flag_FSCU_Enable == 0))
				{
					if((OldScreenIndex != SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP)
						&& (OldScreenIndex != SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_TOP))
					{
						SetListString_2(StringMachine[0], StringMachine[3] );
						if(ScreenIndex == SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP)
							DisplayListAll(1);
						else
							DisplayListAll(2);
						
						DrawMenuFull();

						ReadFLTFault(REQ_ERR_ENGINE_ACTIVE);
						ReadFLTFault(REQ_ERR_ENGINE_LOGGED);

						GUI_DisplayRightStringAt_Value2(FaultCodeCount_ECM_Current, 142, y_Pos[0]+9,  60, COLOR_WHITE);
						GUI_DisplayRightStringAt_Value2(HCESPN.H1526, 142, y_Pos[1]+9,  60, COLOR_WHITE);

						
					}
					else if(OldScreenIndex != ScreenIndex)
					{
						
						if(ScreenIndex == SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP)
							DisplayList(1);
						else
							DisplayList(2);

						GUI_DisplayRightStringAt_Value2(FaultCodeCount_ECM_Current, 142, y_Pos[0]+9,  60, COLOR_WHITE);
						GUI_DisplayRightStringAt_Value2(HCESPN.H1526, 142, y_Pos[1]+9,  60, COLOR_WHITE);
						
						
					}
				}
				else if((COUNT_FLAG.Flag_FLT_Check == 0)&&(COUNT_FLAG.Flag_FSCU_Enable == 1))
				{
					if((OldScreenIndex != SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP)
						&& (OldScreenIndex != SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_TOP))
					{
						SetListString_2(StringMachine[0], StringMachine[4] );
						if(ScreenIndex == SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP)
							DisplayListAll(1);
						else
							DisplayListAll(2);
						
						DrawMenuFull();

						ReadFSCUFault(REQ_ERR_ENGINE_ACTIVE);
						ReadFSCUFault(REQ_ERR_ENGINE_LOGGED);

						GUI_DisplayRightStringAt_Value2(FaultCodeCount_ECM_Current, 142, y_Pos[0]+9,  60, COLOR_WHITE);
						GUI_DisplayRightStringAt_Value2(HCESPN.H1528, 142, y_Pos[1]+9,  60, COLOR_WHITE);

						
					}
					else if(OldScreenIndex != ScreenIndex)
					{
						
						if(ScreenIndex == SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP)
							DisplayList(1);
						else
							DisplayList(2);

						GUI_DisplayRightStringAt_Value2(FaultCodeCount_ECM_Current, 142, y_Pos[0]+9,  60, COLOR_WHITE);
						GUI_DisplayRightStringAt_Value2(HCESPN.H1528, 142, y_Pos[1]+9,  60, COLOR_WHITE);
						
						
					}
				}
				else
				{
					if(OldScreenIndex != SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP)
					{
						SetListString_1(StringMachine[0]);					
						DisplayListAll(1);
						DrawMenuFull();
						GUI_DisplayRightStringAt_Value2(FaultCodeCount_ECM_Current, 142, y_Pos[0]+9,  60, COLOR_WHITE);
					}
					else
					{
						DisplayList(1);
						GUI_DisplayRightStringAt_Value2(FaultCodeCount_ECM_Current, 142, y_Pos[0]+9,  60, COLOR_WHITE);
					}

				}			

			}
			break;
		#endif
		//--, 221129 ysm, FSCU			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_CURRENT_TOP:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_TOP:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_DELETE_TOP:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_CURRENT_LIST:	
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_CURRENT_DETAIL:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_DETAIL:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_DELETE:
			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_CURRENT_TOP:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_TOP:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_DELETE_TOP:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_CURRENT_LIST:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_CURRENT_DETAIL:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_LIST:		
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_DETAIL:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_DELETE:

		//++, 221129 ysm, FSCU
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_CURRENT_TOP:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_TOP:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_DELETE_TOP:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_CURRENT_LIST:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_CURRENT_DETAIL:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_LIST:		
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_DETAIL:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_DELETE:
		//--, 221129 ysm, FSCU			
			DisplayFaultHistory();
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST:
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST_HISTORY:
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_HISTORY_DETAIL:
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST_REPLACE:
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_REPLACE_POPUP:
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST_CYCLE:
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_CHANGE_CYCLE:
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_CYCLE_POPUP:
			DisplayManagement();
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_ANALOG_TOP:	
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALINPUT_TOP:				
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALOUTPUT_TOP:
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_ANALOG_LIST:	
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALINPUT_LIST:		
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALOUTPUT_LIST:
			DisplaySignalStatus();
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_COMPLETE:			
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_NOT_COMPLETE:	
			DisplayPopupStringComplete();
			break;

	}
}

///////////////////////////////////////////////////////////////////////////
void LeftKeyEventMenuMaintenance()
{
	unsigned char i, index_total;
	
	switch(ScreenIndex)
	{
		case SCREEN_STATE_MENU_MAINTENANCE_TOP:			
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_TOP);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_PW:									
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_CURRENT:					
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_NEW:						
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_RETYPE:				
			LeftKeyEventNumberInput();
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_TOP:		
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_TOP);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_TOP:
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_TOP:						
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_TOP:						
			SetScreenIndex(((((ScreenIndex&0xFF000000)>>24)-1)<<24));
			break;
			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP:
			if(COUNT_FLAG.Flag_FLT_Check == 1)
				SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_TOP);		
			//++, 221129 ysm, FSCU
			else if(COUNT_FLAG.Flag_FSCU_Enable == 1)
				SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_TOP);
			//--, 221129 ysm, FSCU			
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_TOP:			
			//++, 221129 ysm, FSCU
			#if 0
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP);
			#else
			if(COUNT_FLAG.Flag_FSCU_Enable == 1)
				SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_TOP);
			else	
				SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP);
			#endif
			//--, 221129 ysm, FSCU	
			break;			
		//++, 221129 ysm, FSCU
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_TOP:		
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP);		
			break;
		//--, 221129 ysm, FSCU			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_CURRENT_TOP:			
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_DELETE_TOP);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_CURRENT_TOP:			
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_DELETE_TOP);
			break;
		//++, 221129 ysm, FSCU
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_CURRENT_TOP:			
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_DELETE_TOP);
			break;
		//--, 221129 ysm, FSCU			
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_ANALOG_TOP:				
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALOUTPUT_TOP);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_TOP:				
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_CURRENT_TOP);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_DELETE_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_TOP);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_TOP:				
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_CURRENT_TOP);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_DELETE_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_TOP);
			break;

		//++, 221129 ysm, FSCU
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_TOP:				
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_CURRENT_TOP);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_DELETE_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_TOP);
			break;
		//--, 221129 ysm, FSCU
			
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALINPUT_TOP:		
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALOUTPUT_TOP:				
			SetScreenIndex(((((ScreenIndex&0xFFF00000)>>20)-1)<<20));
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_CURRENT_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_CURRENT_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_LIST:
		//++, 221129 ysm, FSCU
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_CURRENT_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_LIST:
		//--, 221129 ysm, FSCU			
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_ANALOG_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALINPUT_LIST:		
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALOUTPUT_LIST:		
			if(nOldPageCount == 0)
				CurserIndex = 0;
 			else if(CurserIndex > 0)
				CurserIndex--;
			else
				CurserIndex = nOldPageCount -1;
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST:
			if(CurserIndex > 0)
				CurserIndex--;
			else
			{
				index_total = 0;
				for (i = 0; i < MAINTENANCE_TOTAL; i++)
				{
					if(Maintenance_Data[i].Maintenance_Interval != 0xff)
						index_total++;
				}
				
				if(index_total < 1)
					index_total = 1;
				
				CurserIndex = index_total-1;
			}
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST_HISTORY:
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST_CYCLE);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST_REPLACE:
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST_CYCLE:
			SetScreenIndex(((((ScreenIndex&0xFFFF0000)>>16)-1)<<16));
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_HISTORY_DETAIL:
			if((Maintenance_Data[gMaintenanceItem].Maintenance_Replacement_Count != 0xff)
				&& (Maintenance_Data[gMaintenanceItem].Maintenance_Replacement_Count > 3))
			{
				if(CurserIndex > 0)
					CurserIndex--;
				else
					CurserIndex = (Maintenance_Data[gMaintenanceItem].Maintenance_Replacement_Count-1)/3;
			}
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_CHANGE_CYCLE:
			CurserIndex = CURSER_UP_LEFT;
			if(temp_interval <= 50)
				temp_interval = 50;
			else
				temp_interval -=50;
			KeyUIcnt100ms = 0;
			break;			
			
	}
}

void RightKeyEventMenuMaintenance()
{
	unsigned char i, index_total;
	
	switch(ScreenIndex)
	{
		case SCREEN_STATE_MENU_MAINTENANCE_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_DISPLAYSETTING_TOP);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_PW:									
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_CURRENT:					
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_NEW:						
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_RETYPE:				
			RightKeyEventNumberInput();
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_TOP:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_TOP:		
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_TOP:						
			SetScreenIndex(((((ScreenIndex&0xFF000000)>>24)+1)<<24));
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_TOP:						
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_TOP);
			break;
			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP:
			if(COUNT_FLAG.Flag_FLT_Check == 1)
				SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_TOP); 	
			//++, 221129 ysm, FSCU
			else if(COUNT_FLAG.Flag_FSCU_Enable == 1)
				SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_TOP); 
			//--, 221129 ysm, FSCU
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_TOP:			
			//++, 221129 ysm, FSCU
			#if 0
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP);
			#else
			if(COUNT_FLAG.Flag_FSCU_Enable == 1)
				SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_TOP); 
			else
				SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP);
			#endif
			//--, 221129 ysm, FSCU
			break;		

		//++, 221129 ysm, FSCU
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_TOP:		
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP);
			break;	
		//--, 221129 ysm, FSCU					
			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_DELETE_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_CURRENT_TOP);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_DELETE_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_CURRENT_TOP);
			break;
			
		//++, 221129 ysm, FSCU
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_DELETE_TOP: 
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_CURRENT_TOP);
			break;
		//--, 221129 ysm, FSCU			
			
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALOUTPUT_TOP:				
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_ANALOG_TOP);
			break;
			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_CURRENT_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_TOP);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_DELETE_TOP);
			break;

		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_CURRENT_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_TOP);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_DELETE_TOP);
			break;

		//++, 221129 ysm, fSCU
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_CURRENT_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_TOP);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_DELETE_TOP);
			break;
		//--, 221129 ysm, fSCU	

			
			
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_ANALOG_TOP:	
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALINPUT_TOP:
			SetScreenIndex(((((ScreenIndex&0xFFF00000)>>20)+1)<<20));
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_CURRENT_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_CURRENT_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_LIST:
		//++, 221129 ysm, FSCU
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_CURRENT_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_LIST:
		//--, 221129 ysm, FSCU				
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_ANALOG_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALINPUT_LIST:		
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALOUTPUT_LIST:		
			if(nOldPageCount == 0)
				CurserIndex = 0;
			else if(CurserIndex < (nOldPageCount-1))
				CurserIndex++;
			else
				CurserIndex = 0;
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST:

			index_total = 0;
			for (i = 0; i < MAINTENANCE_TOTAL; i++)
			{
				if(Maintenance_Data[i].Maintenance_Interval != 0xff)
					index_total++;
			}

			if(index_total > MAINTENANCE_TOTAL)
				index_total = 1;

			if(CurserIndex < (index_total-1))
				CurserIndex++;
			else
				CurserIndex = 0;			

			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST_HISTORY:
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST_REPLACE:
			SetScreenIndex(((((ScreenIndex&0xFFFF0000)>>16)+1)<<16));
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST_CYCLE:
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST_HISTORY);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_HISTORY_DETAIL:
			if((Maintenance_Data[gMaintenanceItem].Maintenance_Replacement_Count != 0xff)
				&& (Maintenance_Data[gMaintenanceItem].Maintenance_Replacement_Count > 3))
			{
				if(CurserIndex < ((Maintenance_Data[gMaintenanceItem].Maintenance_Replacement_Count-1)/3))
					CurserIndex++;
				else
					CurserIndex = 0;
			}
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_CHANGE_CYCLE:
			CurserIndex = CURSER_DOWN_RIGHT;
			if(temp_interval > 10000)
				temp_interval = 10000;
			else
				temp_interval +=50;
			KeyUIcnt100ms = 0;
			break;
	}

}

void ESCKeyEventMenuMaintenance()
{
	switch(ScreenIndex)
	{
		case SCREEN_STATE_MENU_MAINTENANCE_TOP:	
			SetScreenIndex(SCREEN_STATE_MAIN_TOP);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_PW:			
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_CURRENT:					
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_NEW:						
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_RETYPE:				
			ESCKeyEventNumberInput();
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_PW_POPUP:		
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_CURRENT_POPUP:					
			SetScreenIndex(ScreenIndex&0xFFFFFFF0);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_NEW_POPUP:						
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_NEW);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_RETYPE_POPUP:				
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_RETYPE);
			break;
			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_TOP:		
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_TOP:
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_TOP:						
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_TOP:						
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_TOP);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP:				
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_TOP:	
		//++, 221129 ysm, FSCU
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_TOP:
		//--, 221129 ysm, fSCU
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_TOP);
			break;	
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_CURRENT_TOP:				
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_TOP:				
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_DELETE_TOP:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_CURRENT_TOP:				
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_TOP:				
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_DELETE_TOP:
		//++, 221129 ysm, FSCU
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_CURRENT_TOP:				
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_TOP:				
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_DELETE_TOP:
		//--, 221129 ysm, FSCU
			SetScreenIndex(ScreenIndex&0xFFF00000);
			break;			
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_ANALOG_TOP:				
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALINPUT_TOP:				
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALOUTPUT_TOP:				
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST:
			SetScreenIndex(ScreenIndex&0xFF000000);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST_HISTORY:
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST_REPLACE:
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST_CYCLE:
			//CurserIndex = gMaintenanceItem;
			if(((InfoModel1.ModelInfo >= MODEL_35L_9)&&(InfoModel1.ModelInfo <= MODEL_50L_9))
				||((InfoModel1.ModelInfo >= MODEL_25LC_9)&&(InfoModel1.ModelInfo <= MODEL_33LC_9)))
			{
				if(gMaintenanceItem < 5)
					CurserIndex = gMaintenanceItem;
				else
					CurserIndex = gMaintenanceItem-1;
			}
			else if(((InfoModel1.ModelInfo >= MODEL_35D_9S)&&(InfoModel1.ModelInfo <= MODEL_50D_9S))
				||((InfoModel1.ModelInfo >= MODEL_25D_9HDI)&&(InfoModel1.ModelInfo <= MODEL_50DN_9HDI)))
			{
				CurserIndex = gMaintenanceItem;

			}
			else if((InfoModel1.ModelInfo >= MODEL_25L_9A)&&(InfoModel1.ModelInfo <= MODEL_35LN_9A))
			{

				if(gMaintenanceItem < MAINTENANCE_FAN_BELT)
					CurserIndex = gMaintenanceItem;
				else if(gMaintenanceItem == MAINTENANCE_BRAKE_COOLING_OIL_FILTER)
					CurserIndex = 6;
				else
					CurserIndex = gMaintenanceItem-1;		

			}
			else
			{
				if(gMaintenanceItem <= 11)
					CurserIndex = gMaintenanceItem;
				else
					CurserIndex = 12;
			}						
			SetScreenIndex(ScreenIndex&0xFFF00000);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_CURRENT_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_LIST:				
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_DELETE:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_CURRENT_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_LIST:				
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_DELETE:
		//++, 221129 ysm, FSCU	
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_CURRENT_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_LIST:				
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_DELETE:
		//--, 221129 ysm, FSCU	
			SetScreenIndex(ScreenIndex&0xFFFF0000);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_ANALOG_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALINPUT_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALOUTPUT_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_COMPLETE:			
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_NOT_COMPLETE:	
			SetScreenIndex(ScreenIndex&0xFFF00000);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_CURRENT_DETAIL:					
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_DETAIL:		
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_CURRENT_DETAIL:					
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_DETAIL:
		//++, 221129 ysm, FSCU	
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_CURRENT_DETAIL:					
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_DETAIL:
		//--, 221129 ysm, FSCU			
			SetScreenIndex(ScreenIndex&0xFFFFF000);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_HISTORY_DETAIL:
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_REPLACE_POPUP:
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_CHANGE_CYCLE:
			SetScreenIndex(ScreenIndex&0xFFFF0000);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_CYCLE_POPUP:
			SetScreenIndex(ScreenIndex&0xFFFFF000);
			break;
			
	}
}

void EnterKeyEventMenuMaintenance()
{
	switch(ScreenIndex)
	{
		case SCREEN_STATE_MENU_MAINTENANCE_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_PW);
			break;

		case SCREEN_STATE_MENU_MAINTENANCE_PW:									
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_CURRENT:					
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_NEW:						
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_RETYPE:				
			EnterKeyEventNumberInput();
			break;
			
		case SCREEN_STATE_MENU_MAINTENANCE_PW_POPUP:		
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_CURRENT_POPUP:					
			SetScreenIndex(ScreenIndex&0xFFFFFFF0);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_TOP:
			OldCurserIndex = 0xff;
			CurserIndex = 0;
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_TOP:
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_TOP:						
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_TOP:						
			SetScreenIndex(ScreenIndex|0x00100000);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST:
			if(((InfoModel1.ModelInfo >= MODEL_35L_9)&&(InfoModel1.ModelInfo <= MODEL_50L_9))
				||((InfoModel1.ModelInfo >= MODEL_25LC_9)&&(InfoModel1.ModelInfo <= MODEL_33LC_9)))
			{
				if(CurserIndex < 5)
					gMaintenanceItem = CurserIndex;
				else
					gMaintenanceItem = CurserIndex+1;
			}
			else if(((InfoModel1.ModelInfo >= MODEL_35D_9S)&&(InfoModel1.ModelInfo <= MODEL_50D_9S))
				||((InfoModel1.ModelInfo >= MODEL_25D_9HDI)&&(InfoModel1.ModelInfo <= MODEL_50DN_9HDI)))
			{
				gMaintenanceItem = CurserIndex;

			}
			else if((InfoModel1.ModelInfo >= MODEL_25L_9A)&&(InfoModel1.ModelInfo <= MODEL_35LN_9A))
			{
				if(CurserIndex < MAINTENANCE_FAN_BELT)
					gMaintenanceItem = CurserIndex;
				else if(CurserIndex == MAINTENANCE_FAN_BELT)
					gMaintenanceItem = MAINTENANCE_BRAKE_COOLING_OIL_FILTER;
				else
					gMaintenanceItem = CurserIndex+1;
			}
			else
			{
				if(CurserIndex <= 11)
					gMaintenanceItem = CurserIndex;
				else
					gMaintenanceItem = MAINTENANCE_DPF_ASH_CLEANING;

			}			
			SetScreenIndex(ScreenIndex|0x00010000);
			break;	
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_TOP:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_TOP:
		//++, 221129 ysm, FSCU
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_TOP:
		//--, 221129 ysm, FSCU
			SetScreenIndex(ScreenIndex|0x00010000);
			break;		
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_CURRENT_TOP:				
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_TOP:				
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_DELETE_TOP:	
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_CURRENT_TOP:				
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_TOP: 			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_DELETE_TOP:	
		//++, 221129 ysm, FSCU
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_CURRENT_TOP:				
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_TOP: 			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_DELETE_TOP:	
		//--, 221129 ysm, FSCU
			SetScreenIndex(ScreenIndex|0x00001000);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_ANALOG_TOP:				
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALINPUT_TOP:				
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALOUTPUT_TOP:				
			SetScreenIndex(ScreenIndex|0x00010000);
			break;
			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_DELETE:
			Fault_Initialize();
			OldCurserIndex = 0xff;
			CurserIndex = 0;
			SetScreenIndex(ScreenIndex&0xFFFF0000);
			break;	
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_DELETE:	
			Fault_Initialize_FLT();
			OldCurserIndex = 0xff;
			CurserIndex = 0;
			SetScreenIndex(ScreenIndex&0xFFFF0000);
			break;			
		//++, 221129 ysm, FSCU
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_DELETE: 
			Fault_Initialize_FSCU();
			OldCurserIndex = 0xff;
			CurserIndex = 0;
			SetScreenIndex(ScreenIndex&0xFFFF0000);
			break;		
		//--, 221129 ysm, FSCU			
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_ANALOG_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALINPUT_LIST:		
		case SCREEN_STATE_MENU_MAINTENANCE_SIGNALSTATUS_DIGITALOUTPUT_LIST:
			OldCurserIndex = 0xff;
			CurserIndex = 0;
			SetScreenIndex(ScreenIndex&0xFFF00000);
			break;			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_CURRENT_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_LIST:	
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_CURRENT_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_LIST:	
		//++, 221129 ysm, FSCU	
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_CURRENT_LIST:			
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_LIST:
		//--, 221129 ysm, FSCU		
			if(nOldPageCount != 0)
				SetScreenIndex(ScreenIndex|0x00000100);
			break;			

		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_CURRENT_DETAIL:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_ECM_LOGGED_DETAIL:
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_CURRENT_DETAIL:					
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FLT_LOGGED_DETAIL:	
		//++, 221129 ysm, FSCU	
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_CURRENT_DETAIL:					
		case SCREEN_STATE_MENU_MAINTENANCE_FAULTHISTORY_FSCU_LOGGED_DETAIL:	
		//--, 221129 ysm, FSCU			
			SetScreenIndex(ScreenIndex&0xFFFFF000);
			break;				
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_HISTORY_DETAIL:
			SetScreenIndex(ScreenIndex&0xFFFF0000);
			break;			
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_NEW_POPUP:						
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_NEW);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_RETYPE_POPUP:	
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_RETYPE);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_COMPLETE:			
		case SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_NOT_COMPLETE:	
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_USERPWCHANGE_TOP);
			break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST_HISTORY:
			if((Maintenance_Data[gMaintenanceItem].Maintenance_Replacement_Count == 0xff)
				|| (Maintenance_Data[gMaintenanceItem].Maintenance_Replacement_Count == 0))
				break;
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST_REPLACE:
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_LIST_CYCLE:
			SetScreenIndex(ScreenIndex|0x00001000);
			break;		
			
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_CHANGE_CYCLE:
			SetScreenIndex(ScreenIndex|0x00000100);
			break;		
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_REPLACE_POPUP:
		case SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_CYCLE_POPUP:
			if(ScreenIndex == SCREEN_STATE_MENU_MAINTENANCE_MANAGEMENT_REPLACE_POPUP)
				Check_Maintenance_Info(REQUEST_REPLACMENT_CONFIRMATION);
			else
				Check_Maintenance_Info(REQUEST_INTERVAL_CHANGE);
			SetScreenIndex(ScreenIndex&0xFFFF0000);
			break;	
			
	}
}

