				else if(CurserIndex == 12)
					temp_ModelInfo = MODEL_35DN_9HDI;
				else if(CurserIndex == 13)
					temp_ModelInfo = MODEL_35D_9HDI;
				else if(CurserIndex == 14)
					temp_ModelInfo = MODEL_40D_9HDI;
				else if(CurserIndex == 15)
					temp_ModelInfo = MODEL_45D_9HDI;
				else if(CurserIndex == 16)
					temp_ModelInfo = MODEL_50DN_9HDI;
				
				#else
				if(CurserIndex > 0)
					CurserIndex--;
				else
					CurserIndex = 9;

				if(CurserIndex == 0)
					temp_ModelInfo = MODEL_35D_9S;
				else if(CurserIndex == 1)
					temp_ModelInfo = MODEL_40D_9S;
				else if(CurserIndex == 2)
					temp_ModelInfo = MODEL_45D_9S;
				else if(CurserIndex == 3)
					temp_ModelInfo = MODEL_50D_9S;
				else if(CurserIndex == 4)
					temp_ModelInfo = MODEL_25D_9VB;
				else if(CurserIndex == 5)
					temp_ModelInfo = MODEL_30D_9VB;
				else if(CurserIndex == 6)
					temp_ModelInfo = MODEL_35DN_9VB;
				else if(CurserIndex == 7)
					temp_ModelInfo = MODEL_25D_9VS;
				else if(CurserIndex == 8)
					temp_ModelInfo = MODEL_30D_9VS;
				else if(CurserIndex == 9)
					temp_ModelInfo = MODEL_35DN_9VS;
				else
					temp_ModelInfo = MODEL_35D_9S;
				#endif
				//--, 211016 ysm
			}
			else
			{
				//++, 211016 ysm
				#if 1
				if(CurserIndex > 0)
					CurserIndex--;
				else
					CurserIndex = 10;	

				if(CurserIndex == 0)
					temp_ModelInfo = MODEL_35L_9;
				else if(CurserIndex == 1)
					temp_ModelInfo = MODEL_40L_9;
				else if(CurserIndex == 2)
					temp_ModelInfo = MODEL_45L_9;
				else if(CurserIndex == 3)
					temp_ModelInfo = MODEL_50L_9;
				else if(CurserIndex == 4)
					temp_ModelInfo = MODEL_25LC_9;
				else if(CurserIndex == 5)
					temp_ModelInfo = MODEL_30LC_9;
				else if(CurserIndex == 6)
					temp_ModelInfo = MODEL_33LC_9;
				else if(CurserIndex == 7)
					temp_ModelInfo = MODEL_25L_9A;
				else if(CurserIndex == 8)
					temp_ModelInfo = MODEL_30L_9A;
				else if(CurserIndex == 9)
					temp_ModelInfo = MODEL_33L_9A;
				else if(CurserIndex == 10)
					temp_ModelInfo = MODEL_35LN_9A;
				#else
				if(CurserIndex > 0)
					CurserIndex--;
				else
					CurserIndex = 3;	

				if(CurserIndex == 0)
					temp_ModelInfo = MODEL_35L_9;
				else if(CurserIndex == 1)
					temp_ModelInfo = MODEL_40L_9;
				else if(CurserIndex == 2)
					temp_ModelInfo = MODEL_45L_9;
				else if(CurserIndex == 3)
					temp_ModelInfo = MODEL_50L_9;
				else
