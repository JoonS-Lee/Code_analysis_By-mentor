			if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_INFO)
			{
				if(((temp_ModelInfo >= MODEL_35L_9)&&(temp_ModelInfo <= MODEL_33LC_9))||
					((temp_ModelInfo >= MODEL_25L_9A)&&(temp_ModelInfo <= MODEL_35LN_9A)))
				{
					CurserIndex = LPG_TYPE;
				}
				else
					CurserIndex = DIESEL_TYPE;

				

				SetScreenIndex(ScreenIndex&0xFFF00000);
			}
			else if((ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_DCSR_MODE_SET)||(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_MODE_SET)||(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_MODE_SET))
			{
				if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_MODE_SET)
