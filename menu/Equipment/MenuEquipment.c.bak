void DisplayMenuTreeEquipmentNoMAST_9S_RMCU_FLT()
{
	switch(ScreenIndex)
	{
		case SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_ESL_TOP:
			if(OldScreenIndex != ScreenIndex)
			{
				if((OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_TOP)
					&& (OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_TOP)
					&& (OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_ESL_TOP))
				{
					if(COUNT_FLAG.ShowMenuMaster == 1)
						SetListString3(18, 20, 21);
					else
						SetListString3(210, 20, 21);					
					
					if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_TOP)
						DisplayListAll(1);
					else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_TOP)
						DisplayListAll(2);
					else
						DisplayListAll(3);


					DisplayListPage(1,4);					
					DrawMenuFull();
				}
				else if(OldScreenIndex != ScreenIndex)
				{
					if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_TOP)
						DisplayList(1);
					else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_TOP)
						DisplayList(2);
					else
						DisplayList(3); 	

				}
			}
			break;	
		case SCREEN_STATE_MENU_EQUIPMENT_DCSR_TOP:									
		case SCREEN_STATE_MENU_EQUIPMENT_MAXSPEEDLIMIT_TOP:				
		case SCREEN_STATE_MENU_EQUIPMENT_CLUTCHPROTECTION_TOP:
			if(OldScreenIndex != ScreenIndex)
			{
				if((OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_DCSR_TOP)
					&& (OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_MAXSPEEDLIMIT_TOP)
					&& (OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_CLUTCHPROTECTION_TOP))
				{
				
					if((InfoModel1.ModelInfo >= MODEL_35D_9S)&&(InfoModel1.ModelInfo <= MODEL_50D_9S))
						SetListString3(22, 205, 185);				
					else
						SetListString3(22, 24, 185);				
					
					if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_DCSR_TOP)
						DisplayListAll(1);
					else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_MAXSPEEDLIMIT_TOP)
						DisplayListAll(2);
					else
						DisplayListAll(3);	

					DisplayListPage(2,4);					
					DrawMenuFull();
				}
				else if(OldScreenIndex != ScreenIndex)
				{
					if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_DCSR_TOP)
						DisplayList(1);
					else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_MAXSPEEDLIMIT_TOP)
						DisplayList(2);
					else
						DisplayList(3);

				}
			}
			break;	
		}

		if(COUNT_FLAG.ShowMenuSbIl == 1)
		{
			switch(ScreenIndex)
			{
				case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_TOP:		
				case SCREEN_STATE_MENU_EQUIPMENT_SEATBELTINTERLOCK_TOP:
				case SCREEN_STATE_MENU_EQUIPMENT_RMCU_TOP:
					if(OldScreenIndex != ScreenIndex)
					{				
						if((OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_TOP)
							&& (OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_SEATBELTINTERLOCK_TOP)
							&& (OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_RMCU_TOP))
						{
							SetListString3(190, 189, 214);
							if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_TOP)
								DisplayListAll(1);
							else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_SEATBELTINTERLOCK_TOP)
								DisplayListAll(2);
							else
								DisplayListAll(3);
							
							DisplayListPage(3,4);
							DrawMenuFull();
						}
						else if(OldScreenIndex != ScreenIndex)
						{
							if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_TOP)
								DisplayList(1);
							else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_SEATBELTINTERLOCK_TOP)
								DisplayList(2);
							else
								DisplayList(3); 	
						}
						
	
					}
					break;
					
				case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_TOP:
				case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_TOP:
					if(OldScreenIndex != ScreenIndex)
					{				
						if((OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_TOP)
							&& (OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_TOP))
						{
							SetListString2(215, 25);
							if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_TOP)
								DisplayListAll(1);
							else
								DisplayListAll(2);
							
							DisplayListPage(4,4);
							DrawMenuFull();

						}
						else if(OldScreenIndex != ScreenIndex)
						{
							if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_TOP)
								DisplayList(1);
							else
								DisplayList(2); 

						}						
	
					}
					break;
				}
			}
			else
			{
				switch(ScreenIndex)
				{
					case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_TOP:
					case SCREEN_STATE_MENU_EQUIPMENT_RMCU_TOP:
					case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_TOP:			
						if(OldScreenIndex != ScreenIndex)
						{
							if((OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_TOP)								
								&& (OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_RMCU_TOP)
								&& (OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_TOP))
							{
								SetListString3(190, 214, 215);
								if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_TOP)
									DisplayListAll(1);		
								else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_RMCU_TOP)
									DisplayListAll(2);
								else
									DisplayListAll(3);
								
								DisplayListPage(3,4);
								DrawMenuFull();

							}
							else if(OldScreenIndex != ScreenIndex)
							{

								if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_TOP)
									DisplayList(1);
								else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_RMCU_TOP)
									DisplayList(2);	
								else
									DisplayList(3);	
							}
						}
						break;
					case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_TOP:
						if(OldScreenIndex != ScreenIndex)
						{				
							if(OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_TOP)	
							{
								SetListString1(25);
					
								DisplayListAll(1);
								
								DisplayListPage(4,4);
								DrawMenuFull();
							}
							else if(OldScreenIndex != ScreenIndex)
							{
								DisplayList(1);
							}						
					
						}
						break;						
					}
				}
}


