		case SCREEN_STATE_MENU_EQUIPMENT_DCSR_SPEED_RESTORE_COMPLETE:			
		case SCREEN_STATE_MENU_EQUIPMENT_DCSR_SPEED_BLOCKING_NOT_COMPLETE:			
		case SCREEN_STATE_MENU_EQUIPMENT_DCSR_SPEED_RESTORE_NOT_COMPLETE:                  
        case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_UP_SET:
        case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_DOWN_SET:
        case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_UP_COMPLETE:        
        case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_UP_NOT_COMPLETE:       
        case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_DOWN_COMPLETE:         
        case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_DOWN_NOT_COMPLETE: 
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_OVERLAP_UP_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_OVERLAP_UP_COMPLETE:
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_OVERLAP_UP_NOT_COMPLETE:
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_OVERLAP_DOWN_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_OVERLAP_DOWN_COMPLETE:
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_OVERLAP_DOWN_NOT_COMPLETE:
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SR_UP_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SR_UP_COMPLETE:
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SR_UP_NOT_COMPLETE:
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SR_DOWN_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SR_DOWN_COMPLETE:
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SR_DOWN_NOT_COMPLETE:	
			if((ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_TIRE)||(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_CHANGE_POPUP))
			{
				if(Engine_Type_Temp == LPG_TYPE)
				{

					if(temp_ModelInfo == MODEL_35L_9)
						CurserIndex = 0;
					else if(temp_ModelInfo == MODEL_40L_9)
						CurserIndex = 1;
					else if(temp_ModelInfo == MODEL_45L_9)
						CurserIndex = 2;
					else if(temp_ModelInfo == MODEL_50L_9)
						CurserIndex = 3;
					else if(temp_ModelInfo == MODEL_25LC_9)
						CurserIndex = 4;
					else if(temp_ModelInfo == MODEL_30LC_9)
