			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FLT_SW_VERSION);
			break;					
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FLT_SERIAL_NUMBER: 
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FLT_PART_NUMBER);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FLT_SW_VERSION: 
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FLT_SERIAL_NUMBER);
			break;

		//++, 220929 ysm, FSCU
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FSCU_PART_NUMBER:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FSCU_SW_VERSION);
			break;					
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FSCU_SERIAL_NUMBER: 
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FSCU_PART_NUMBER);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FSCU_SW_VERSION: 
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FSCU_SERIAL_NUMBER);
			break;
		//--, 220929 ysm, FSCU
			
	
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_PART_NUMBER:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_SW_VERSION);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_SW_VERSION: 
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_SERIAL_NUMBER);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_SERIAL_NUMBER: 
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_PART_NUMBER);
			break;

		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_RMCU_SERIAL_NUMBER:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_RMCU_SW_VERSION);
			break;		
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_RMCU_SW_VERSION: 
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_RMCU_SERIAL_NUMBER);
