	else if((angle == 1)&&(rmcu == 0)&&(fingertip == 1))
		DisplayMenuTreeEquipmentFull_LC_FLT();

	else if((angle == 1)&&(rmcu == 0)&&(fingertip == 0))
		DisplayMenuTreeEquipmentFull_LC();

	else if((angle == 0)&&(rmcu == 1)&&(fingertip == 1))
		DisplayMenuTreeEquipmentNoMAST_LC_RMCU_FLT();

	else if((angle == 0)&&(rmcu == 1)&&(fingertip == 0))
		DisplayMenuTreeEquipmentNoMAST_LC_RMCU();

	else if((angle == 0)&&(rmcu == 0)&&(fingertip == 1))
		DisplayMenuTreeEquipmentNoMAST_LC_FLT();

	else
		DisplayMenuTreeEquipmentNoMAST_LC();


}


void DisplayMenuTreeEquipment_9VS(unsigned char mast, unsigned char angle, unsigned char rmcu, unsigned char fingertip)
{

	if((angle == 1)&&(rmcu == 1)&&(fingertip == 1))
		DisplayMenuTreeEquipmentFull_9VS_RMCU_FLT();

	else if((angle == 1)&&(rmcu == 1)&&(fingertip == 0))
		DisplayMenuTreeEquipmentFull_9VS_RMCU();

	else if((angle == 1)&&(rmcu == 0)&&(fingertip == 1))
		DisplayMenuTreeEquipmentFull_9VS_FLT();

	else if((angle == 1)&&(rmcu == 0)&&(fingertip == 0))
		DisplayMenuTreeEquipmentFull_9VS();

	else if((angle == 0)&&(rmcu == 1)&&(fingertip == 1))
		DisplayMenuTreeEquipmentNoMAST_9V_RMCU_FLT();

	else if((angle == 0)&&(rmcu == 1)&&(fingertip == 0))
		DisplayMenuTreeEquipmentNoMAST_9V_RMCU();

	else if((angle == 0)&&(rmcu == 0)&&(fingertip == 1))
		DisplayMenuTreeEquipmentNoMAST_9V_FLT();

	else
		DisplayMenuTreeEquipmentNoMAST_9V();

}


void DisplayMenuTreeEquipment_9V(unsigned char mast, unsigned char angle, unsigned char rmcu, unsigned char fingertip)
{

	if((angle == 1)&&(rmcu == 1)&&(fingertip == 1))
		DisplayMenuTreeEquipmentFull_9V_RMCU_FLT();

	else if((angle == 1)&&(rmcu == 1)&&(fingertip == 0))
		DisplayMenuTreeEquipmentFull_9V_RMCU();

	else if((angle == 1)&&(rmcu == 0)&&(fingertip == 1))
		DisplayMenuTreeEquipmentFull_9V_FLT();

	else if((angle == 1)&&(rmcu == 0)&&(fingertip == 0))
		DisplayMenuTreeEquipmentFull_9V();

	else if((angle == 0)&&(rmcu == 1)&&(fingertip == 1))
		DisplayMenuTreeEquipmentNoMAST_9V_RMCU_FLT();

	else if((angle == 0)&&(rmcu == 1)&&(fingertip == 0))
		DisplayMenuTreeEquipmentNoMAST_9V_RMCU();

	else if((angle == 0)&&(rmcu == 0)&&(fingertip == 1))
		DisplayMenuTreeEquipmentNoMAST_9V_FLT();

	else
		DisplayMenuTreeEquipmentNoMAST_9V();

}



void DisplayMenuTreeEquipment()
{
	if((InfoModel1.ModelInfo >= MODEL_35D_9S)&&(InfoModel1.ModelInfo <= MODEL_50D_9S))
		DisplayMenuTreeEquipment_9S(MAST_EQUIPMENT, ANGLE_EQUIPMENT, RMCU_EQUIPMENT, FINGERTIP_EQUIPMENT); // ???? ???? X
	else if((InfoModel1.ModelInfo >= MODEL_35L_9)&&(InfoModel1.ModelInfo <= MODEL_50L_9))
		DisplayMenuTreeEquipment_L9(MAST_EQUIPMENT, ANGLE_EQUIPMENT, RMCU_EQUIPMENT, FINGERTIP_EQUIPMENT);
	else if((InfoModel1.ModelInfo >= MODEL_25LC_9)&&(InfoModel1.ModelInfo <= MODEL_33LC_9))
		DisplayMenuTreeEquipment_LC(MAST_EQUIPMENT, ANGLE_EQUIPMENT, RMCU_EQUIPMENT, FINGERTIP_EQUIPMENT);
	else if((InfoModel1.ModelInfo >= MODEL_25L_9A)&&(InfoModel1.ModelInfo <= MODEL_35LN_9A))
		DisplayMenuTreeEquipment_LC(MAST_EQUIPMENT, ANGLE_EQUIPMENT, RMCU_EQUIPMENT, FINGERTIP_EQUIPMENT); // ++,--, 230208 ysm, FSCU // DisplayMenuTreeEquipment_9A
	else if((InfoModel1.ModelInfo >= MODEL_25D_9HDI)&&(InfoModel1.ModelInfo <= MODEL_35DN_9HDI))
		DisplayMenuTreeEquipment_9V(MAST_EQUIPMENT, ANGLE_EQUIPMENT, RMCU_EQUIPMENT, FINGERTIP_EQUIPMENT);
	else if((InfoModel1.ModelInfo >= MODEL_35D_9HDI)&&(InfoModel1.ModelInfo <= MODEL_50DN_9HDI))
		DisplayMenuTreeEquipment_L9(MAST_EQUIPMENT, ANGLE_EQUIPMENT, RMCU_EQUIPMENT, FINGERTIP_EQUIPMENT);
	else
		DisplayMenuTreeEquipment_9VS(MAST_EQUIPMENT, ANGLE_EQUIPMENT, RMCU_EQUIPMENT, FINGERTIP_EQUIPMENT);
	
}

