			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX1_TOP);
			break;	
		
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_LIFT_UP_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_LIFT_DOWN_TOP);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_LIFT_DOWN_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_LIFT_UP_TOP);
			break;
			
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_TILT_A_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_TILT_B_TOP);
			break;	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_TILT_B_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_TILT_A_TOP);
			break;
		
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX1_A_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX1_B_TOP);
			break;	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX1_B_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX1_A_TOP);
			break;		
		
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX2_A_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX2_B_TOP);
			break;	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX2_B_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX2_A_TOP);
			break;


		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_LIFT_UP_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_LIFT_DOWN_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_TILT_A_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_TILT_B_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX1_A_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX1_B_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX2_A_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX2_B_SET:
			CurserIndex = CURSER_UP_LEFT;

			if(SubCurserIndex < 2)
			{			
				if(Control_FLT_Valve_Value >= 1)
					Control_FLT_Valve_Value -= 1;
				else
					Control_FLT_Valve_Value = 2000;
			}
			else
			{
				if(Control_FLT_Valve_Value >= 50)
					Control_FLT_Valve_Value -= 50;
				else
					Control_FLT_Valve_Value = 2000;

			}
			
			KeyUIcnt100ms = 0;

			break;

		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_LIFT_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_TILT_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_AUX1_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_AUX2_SET:	
			CurserIndex = CURSER_UP_LEFT;
			if(Control_FLT_DeadZone_Voltage > 20) // 0.20 V
				Control_FLT_DeadZone_Voltage -= 1;
			else
				Control_FLT_DeadZone_Voltage = 20;
			
			KeyUIcnt100ms = 0;
			break;
			

	}
}

void RightKeyEventMenuEquipment()
{
	switch(ScreenIndex)
	{
		case SCREEN_STATE_MENU_EQUIPMENT_TOP:		
			SetScreenIndex(SCREEN_STATE_MENU_MAINTENANCE_TOP);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_PW:					
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_CROSSSECTION_INPUT:					
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_LOADADJUST_LOAD_INPUT:		
			RightKeyEventNumberInput();
			break;

		case SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_TOP:	
			if(ANGLE_EQUIPMENT == 1) //++,--, 210524 ysm, ACC_TEST
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_TILTSETTING_TOP);
			else 
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_TOP);
			break;

		case SCREEN_STATE_MENU_EQUIPMENT_TILTSETTING_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_TOP);
			break;			
							
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_TOP:		
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_ESL_TOP);
			break;	
			
		case SCREEN_STATE_MENU_EQUIPMENT_ESL_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_DCSR_TOP);
			break;	

		case SCREEN_STATE_MENU_EQUIPMENT_DCSR_TOP:	
			if(ANGLE_EQUIPMENT == 1)
			{
				if((InfoModel1.ModelInfo <= MODEL_35DN_9VB)
				||((InfoModel1.ModelInfo >= MODEL_35D_9S)&&(InfoModel1.ModelInfo <= MODEL_50D_9S))
				||((InfoModel1.ModelInfo >= MODEL_25D_9VS)&&(InfoModel1.ModelInfo <= MODEL_35DN_9VS)))
					SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MAXSPEEDLIMIT_TOP);
				else
					SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_HAC_TOP);

			}
			else
			{
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MAXSPEEDLIMIT_TOP);						
			}
			break;
			
		case SCREEN_STATE_MENU_EQUIPMENT_HAC_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MAXSPEEDLIMIT_TOP);				
			break;

		case SCREEN_STATE_MENU_EQUIPMENT_MAXSPEEDLIMIT_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_CLUTCHPROTECTION_TOP);
			break;			
		
		case SCREEN_STATE_MENU_EQUIPMENT_CLUTCHPROTECTION_TOP:	
			//++, 230208 ysm, FSCU
			#if 0
			if(((InfoModel1.ModelInfo >= MODEL_35D_9S)&&(InfoModel1.ModelInfo <= MODEL_50L_9))
				||((InfoModel1.ModelInfo >= MODEL_35D_9HDI)&&(InfoModel1.ModelInfo <= MODEL_50DN_9HDI)))
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_TOP);
			else if((InfoModel1.ModelInfo >= MODEL_25L_9A)&&(InfoModel1.ModelInfo <= MODEL_35LN_9A))
			{
				if(COUNT_FLAG.ShowMenuSbIl == 1)
					SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_SEATBELTINTERLOCK_TOP);
				else if(RMCU_EQUIPMENT == 1)
					SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_RMCU_TOP);
				else if(FINGERTIP_EQUIPMENT == 1)
					SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_TOP);				
				else
					SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_TOP);

			}
			else
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_TOP);
			#else
			if(((InfoModel1.ModelInfo >= MODEL_35D_9S)&&(InfoModel1.ModelInfo <= MODEL_50L_9))
				||((InfoModel1.ModelInfo >= MODEL_35D_9HDI)&&(InfoModel1.ModelInfo <= MODEL_50DN_9HDI)))
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_TOP);
			else
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_TOP);
			#endif
			//--, 230208 ysm, FSCU
				
			break;

		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_TOP:	
			if((InfoModel1.ModelInfo >= MODEL_35D_9S)&&(InfoModel1.ModelInfo <= MODEL_50D_9S)) //++,--, 230208 ysm, FSCU
			{
				if(COUNT_FLAG.ShowMenuSbIl == 1)
					SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_SEATBELTINTERLOCK_TOP);
				else if(RMCU_EQUIPMENT == 1)
					SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_RMCU_TOP);
				else if(FINGERTIP_EQUIPMENT == 1)
					SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_TOP);				
				else
					SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_TOP);

			}
			else
			{
 				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_TOP);
			}				
			break;

		case SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_TOP:
			if(COUNT_FLAG.ShowMenuSbIl == 1)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_SEATBELTINTERLOCK_TOP);
			else if(RMCU_EQUIPMENT == 1)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_RMCU_TOP);
			else if(FINGERTIP_EQUIPMENT == 1)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_TOP);
			else
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_TOP);

			break;

		case SCREEN_STATE_MENU_EQUIPMENT_SEATBELTINTERLOCK_TOP:
			if(RMCU_EQUIPMENT == 1)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_RMCU_TOP);
			else if(FINGERTIP_EQUIPMENT == 1)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_TOP);
			else
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_TOP);			
			break;


		case SCREEN_STATE_MENU_EQUIPMENT_RMCU_TOP:
			if(FINGERTIP_EQUIPMENT == 1)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_TOP);
			else
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_TOP);
			break;

		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_TOP);
			break;

        case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_TOP);
			break;	
			
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_UP_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_DOWN_TOP);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_DOWN_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_UP_TOP);
			break;

		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_OVERLAP_UP_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_OVERLAP_DOWN_TOP);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_OVERLAP_DOWN_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_OVERLAP_UP_TOP);
			break;

		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SR_UP_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SR_DOWN_TOP);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SR_DOWN_TOP:	
