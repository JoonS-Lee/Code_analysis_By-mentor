			{
				//++, 211016 ysm
				#if DEBUG_MODE
				if(CurserIndex > 0)
					CurserIndex--;
				else
					CurserIndex = 16;

				if(CurserIndex == 0)
					temp_ModelInfo = MODEL_35D_9S;
				else if(CurserIndex == 1)
					temp_ModelInfo = MODEL_40D_9S;
				else if(CurserIndex == 2)
					temp_ModelInfo = MODEL_45D_9S;
				else if(CurserIndex == 3)
