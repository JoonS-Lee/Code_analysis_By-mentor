			temp_TireInfo = CurserIndex;
			break;
			
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_CROSSSECTION_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_BUZZER_TOP);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_LOADADJUST_TOP:					
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_DISPLAYSET_TOP:						
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_BUZZER_TOP:								
		case SCREEN_STATE_MENU_EQUIPMENT_DCSR_SPEED_TOP:						
			SetScreenIndex(((((ScreenIndex&0xFFF00000)>>20)-1)<<20));
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_LOADADJUST_UNLOAD_TOP:		
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_LOADADJUST_INITIAL_TOP);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_LOADADJUST_LOAD_TOP:				
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_LOADADJUST_INITIAL_TOP:	
		case SCREEN_STATE_MENU_EQUIPMENT_DCSR_SPEED_RESTORE_TOP:			
			SetScreenIndex(((((ScreenIndex&0xFFFF0000)>>16)-1)<<16));
			break;
			
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_LOADADJUST_UNLOAD_INFO:	
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_DISPLAYSET_UNIT:						
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_BUZZER_SET:								
		case SCREEN_STATE_MENU_EQUIPMENT_DCSR_MODE_SET:						
		case SCREEN_STATE_MENU_EQUIPMENT_MAXSPEEDLIMIT_FUNC_SET:		
		case SCREEN_STATE_MENU_EQUIPMENT_HAC_SET:					
		case SCREEN_STATE_MENU_EQUIPMENT_TILTSETTING_INITIAL:			
		case SCREEN_STATE_MENU_EQUIPMENT_CLUTCHPROTECTION_SET:
		//case SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_MODE_SET:	//++,--, 230125 ysm, FSCU
		case SCREEN_STATE_MENU_EQUIPMENT_SEATBELTINTERLOCK_SET:	// ++, --, 200914 bwk
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_MODE_SET:
			if(CurserIndex == 1)
				CurserIndex = 0;
			else
				CurserIndex = 1;
			break;           
		//++, 230125 ysm, FSCU	
		case SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_MODE_SET:	
			if(COUNT_FLAG.Flag_FSCU_Enable == 1)
			{
				CurserIndex = 1;
			}
			else
			{
				if(CurserIndex == 1)
					CurserIndex = 0;
				else
					CurserIndex = 1;
			}
			break;
		//--, 230125 ysm, FSCU			
                        
		case SCREEN_STATE_MENU_EQUIPMENT_ESL_CHANGE:									
			if(CurserIndex > 1)
				CurserIndex--;
			else
				CurserIndex = 3;
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_ESL_DELAYTIME_SELECT:			
			if(CurserIndex > 0)
				CurserIndex--;
			else
				CurserIndex = 8;
			break;

		case SCREEN_STATE_MENU_EQUIPMENT_DCSR_MODE_TOP:	
			if(InfoModel1.DCSR_Status == CURSER_ON)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_DCSR_SPEED_TOP);
			break;			
		case SCREEN_STATE_MENU_EQUIPMENT_DCSR_SPEED_BLOCKING_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_DCSR_SPEED_RESTORE_TOP);
			break;			
		case SCREEN_STATE_MENU_EQUIPMENT_DCSR_SPEED_BLOCKING_SET:	
			CurserIndex = CURSER_UP_LEFT;
			if(tempSpeed > MIN_BLOCK_SPEED_LIMIT)
				tempSpeed--;
			else
				tempSpeed = MAX_BLOCK_SPEED_LIMIT;
			KeyUIcnt100ms = 0;
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_DCSR_SPEED_RESTORE_SET:			
			CurserIndex = CURSER_UP_LEFT;
			if(tempSpeed > MIN_RESTORE_SPEED_LIMIT)
				tempSpeed--;
			else
				tempSpeed = MAX_RESTORE_SPEED_LIMIT;
			KeyUIcnt100ms = 0;
			break;


		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_UP_SET:	
			CurserIndex = CURSER_UP_LEFT;
			if(tempSpeed > MIN_AUTOSHIFT_UP_LIMIT)
				tempSpeed--;
			else
				tempSpeed = MAX_AUTOSHIFT_UP_LIMIT;
			KeyUIcnt100ms = 0;
			break;
		//++, 210825 ysm	
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_DOWN_SET:			
			CurserIndex = CURSER_UP_LEFT;
			if(tempSpeed > MIN_AUTOSHIFT_DOWN_LIMIT)
				tempSpeed--;
			else
			{
				if(InfoModel3.AutoShift_Status_Speed_UP <= MAX_AUTOSHIFT_DOWN_LIMIT)
					tempSpeed = InfoModel3.AutoShift_Status_Speed_UP - 1;
				else				
					tempSpeed = MAX_AUTOSHIFT_DOWN_LIMIT;
			}				
			KeyUIcnt100ms = 0;
			break;
		//--, 210825 ysm
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_OVERLAP_UP_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_OVERLAP_DOWN_SET:
			CurserIndex = CURSER_UP_LEFT;
			if(tempSpeed > 0)
				tempSpeed -= 5;
			else
				tempSpeed = 200;
			KeyUIcnt100ms = 0;
			break;

		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SR_UP_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SR_DOWN_SET:
			CurserIndex = CURSER_UP_LEFT;
			if(tempSpeed > 0)
				tempSpeed -= 1;
			else
				tempSpeed = 10;
			KeyUIcnt100ms = 0;
			break;
			

        case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_MODE_TOP:
			if(InfoModel3.AutoShift_Status == CURSER_ON)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_TOP);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_MODE_TOP);
			break;			
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_UP_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_DOWN_TOP);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_DOWN_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_UP_TOP);
			break;

		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_OVERLAP_UP_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_OVERLAP_DOWN_TOP);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_OVERLAP_DOWN_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_OVERLAP_UP_TOP);
			break;

		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SR_UP_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SR_DOWN_TOP);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SR_DOWN_TOP:	
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SR_UP_TOP);
			break;


		case SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_MODE_TOP:
			if(InfoModel2.ZeroStart== CURSER_ON)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_ACCEL_TOP);
			break;		
		case SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_ACCEL_TOP:			
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_MODE_TOP);
			break;	
		case SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_ACCEL_SET:			
			CurserIndex = CURSER_UP_LEFT;
			if(tempSpeed > 1)
				tempSpeed--;
			else
				tempSpeed = 12;	//++,--, 230202 ysm, FSCU 75->25->12
			KeyUIcnt100ms = 0;
			break;
			

		case SCREEN_STATE_MENU_EQUIPMENT_MAXSPEEDLIMIT_FUNC_TOP:		
			if(InfoModel2.SpeedLimitStatus == CURSER_ON)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MAXSPEEDLIMIT_SPEED_TOP);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MAXSPEEDLIMIT_SPEED_TOP:				
			SetScreenIndex(((((ScreenIndex&0xFFF00000)>>20)-1)<<20));
			break;
			
		case SCREEN_STATE_MENU_EQUIPMENT_MAXSPEEDLIMIT_SPEED_SET:				
			CurserIndex = CURSER_UP_LEFT;

			if((InfoModel1.ModelInfo >= MODEL_35D_9S)&&(InfoModel1.ModelInfo <= MODEL_50D_9S))
			{
				if(tempSpeed > 5)
					tempSpeed--;
				else
					tempSpeed = 25;

			}
			else
			{
			
				if(tempSpeed > MIN_SPEED_LIMIT)
					tempSpeed--;
				else
					tempSpeed = MAX_SPEED_LIMIT;

			}
			KeyUIcnt100ms = 0;
			break;

		//++, 220929 ysm, FSCU
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_ECM_TOP:
			if(COUNT_FLAG.Flag_FSCU_Enable== 1)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FSCU_TOP);			
			else if(COUNT_FLAG.Flag_FLT_Check == 1)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FLT_TOP);
			else if(COUNT_FLAG.Flag_RMCU_Check == 1)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_RMCU_TOP);
			else
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_TOP);
			break;
			
			
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_TOP:
			if(COUNT_FLAG.Flag_ECM_Check == 1)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_ECM_TOP);
			else if(COUNT_FLAG.Flag_FSCU_Enable== 1)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FSCU_TOP);			
			else if(COUNT_FLAG.Flag_FLT_Check == 1)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FLT_TOP);
			else if(COUNT_FLAG.Flag_RMCU_Check == 1)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_RMCU_TOP);
			break;


		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_RMCU_TOP:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_TOP);
			break;

		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FLT_TOP:
			if(COUNT_FLAG.Flag_RMCU_Check == 1)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_RMCU_TOP);
			else
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_TOP);
			break;

