				}
				else
					SetScreenIndex(ScreenIndex&0xFFF00000);			

			}
			else if((ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_MODE_COMPLETE)||(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_MODE_NOT_COMPLETE))
			{
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_TOP);
			}
			else
			{
				SetScreenIndex(ScreenIndex&0xFFF00000);
			}
			
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_ESL_SET:	
			if(ESL_Index == DELAYTIME)
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_ESL_DELAYTIME_SELECT);
			else
				SetScreenIndex(ScreenIndex&0xFFF00000);
			break;

		case SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_TIRE:	
