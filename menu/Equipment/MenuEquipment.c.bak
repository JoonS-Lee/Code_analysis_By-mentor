void DisplayMenuTreeEquipment_9S(unsigned char mast, unsigned char angle, unsigned char rmcu, unsigned char fingertip)
{

	if((angle == 1)&&(rmcu == 1)&&(fingertip == 1))
		DisplayMenuTreeEquipmentFull_9S_RMCU_FLT();

	else if((angle == 1)&&(rmcu == 1)&&(fingertip == 0))
		DisplayMenuTreeEquipmentFull_9S_RMCU();

	else if((angle == 1)&&(rmcu == 0)&&(fingertip == 1))
		DisplayMenuTreeEquipmentFull_9S_FLT();

	else if((angle == 1)&&(rmcu == 0)&&(fingertip == 0))
		DisplayMenuTreeEquipmentFull_9S();

	else if((angle == 0)&&(rmcu == 1)&&(fingertip == 1))
		DisplayMenuTreeEquipmentNoMAST_9S_RMCU_FLT();

	else if((angle == 0)&&(rmcu == 1)&&(fingertip == 0))
		DisplayMenuTreeEquipmentNoMAST_9S_RMCU();

	else if((angle == 0)&&(rmcu == 0)&&(fingertip == 1))
		DisplayMenuTreeEquipmentNoMAST_9S_FLT();

	else
		DisplayMenuTreeEquipmentNoMAST_9S();
		
}


void DisplayMenuTreeEquipment_L9(unsigned char mast, unsigned char angle, unsigned char rmcu, unsigned char fingertip)
{
	if((angle == 1)&&(rmcu == 1)&&(fingertip == 1))
		DisplayMenuTreeEquipmentFull_RMCU_FLT();

	else if((angle == 1)&&(rmcu == 1)&&(fingertip == 0))
		DisplayMenuTreeEquipmentFull_RMCU();

	else if((angle == 1)&&(rmcu == 0)&&(fingertip == 1))
		DisplayMenuTreeEquipmentFull_FLT();

	else if((angle == 1)&&(rmcu == 0)&&(fingertip == 0))
		DisplayMenuTreeEquipmentFull();

	else if((angle == 0)&&(rmcu == 1)&&(fingertip == 1))
		DisplayMenuTreeEquipmentNoMAST_RMCU_FLT();

	else if((angle == 0)&&(rmcu == 1)&&(fingertip == 0))
		DisplayMenuTreeEquipmentNoMAST_RMCU();

	else if((angle == 0)&&(rmcu == 0)&&(fingertip == 1))
		DisplayMenuTreeEquipmentNoMAST_FLT();

	else
		DisplayMenuTreeEquipmentNoMAST();



}


void DisplayMenuTreeEquipment_9A(unsigned char mast, unsigned char angle, unsigned char rmcu, unsigned char fingertip)
{

	if((angle == 1)&&(rmcu == 1)&&(fingertip == 1))
