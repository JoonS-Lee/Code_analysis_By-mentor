					else if(temp_ModelInfo == MODEL_33LC_9)
						CurserIndex = 6;
					else if(temp_ModelInfo == MODEL_25L_9A)
						CurserIndex = 7;					
					else if(temp_ModelInfo == MODEL_30L_9A)
						CurserIndex = 8;					
					else if(temp_ModelInfo == MODEL_33L_9A)
						CurserIndex = 9;
					else if(temp_ModelInfo == MODEL_35LN_9A)
						CurserIndex = 10;
					else
						CurserIndex = 0;
				}
				else
				{

					if(temp_ModelInfo == MODEL_35D_9S)
						CurserIndex = 0;
					else if(temp_ModelInfo == MODEL_40D_9S)
						CurserIndex = 1;
					else if(temp_ModelInfo == MODEL_45D_9S)
