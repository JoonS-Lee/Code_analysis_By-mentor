					else if(temp_ModelInfo == MODEL_30D_9HDI)
						CurserIndex = 11;
					else if(temp_ModelInfo == MODEL_35DN_9HDI)
						CurserIndex = 12;
					else if(temp_ModelInfo == MODEL_35D_9HDI)
						CurserIndex = 13;
					else if(temp_ModelInfo == MODEL_40D_9HDI)
						CurserIndex = 14;
					else if(temp_ModelInfo == MODEL_45D_9HDI)
						CurserIndex = 15;
					else if(temp_ModelInfo == MODEL_50DN_9HDI)
						CurserIndex = 16;
					else
						CurserIndex = 0;
				}

				
			}
			SetScreenIndex(ScreenIndex&0xFFFF0000);
			break;

		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_ECM_TOP:	
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_RMCU_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FLT_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FSCU_TOP: //++,--, 220929 ysm, FSCU
			SetScreenIndex(ScreenIndex&0xFF000000);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_ECM_PART_NUMBER:		
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_ECM_SERIAL_NUMBER:	
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_ECM_SW_VERSION:	
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_PART_NUMBER:		
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_SERIAL_NUMBER:	
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_SW_VERSION:			
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_DETAIL_HIDDEN:
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_RMCU_SERIAL_NUMBER:	
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_RMCU_SW_VERSION:
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FLT_PART_NUMBER:		
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FLT_SERIAL_NUMBER:	
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FLT_SW_VERSION:
		//++, 221012 ysm, FSCU_2
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FSCU_PART_NUMBER:		
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FSCU_SERIAL_NUMBER:	
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FSCU_SW_VERSION:	
		//--, 221012 ysm, FSCU_2	
			SetScreenIndex(ScreenIndex&0xFFF00000);
			break;

	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_POSITION_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_TOP:	
			SetScreenIndex(ScreenIndex&0xFF000000);
			break;
		
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_POSITION_LIFT_TOP: 
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_POSITION_TILT_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_POSITION_AUX1_TOP: 
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_POSITION_AUX2_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_LIFT_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_TILT_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_AUX1_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_AUX2_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_LIFT_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_TILT_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX1_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX2_TOP:	
			SetScreenIndex(ScreenIndex&0xFFF00000);
			break;	
		
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_POSITION_LIFT_SET: 
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_POSITION_TILT_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_POSITION_AUX1_SET: 
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_POSITION_AUX2_SET:
			if(COUNT_FLAG.Flag_FLT_Step == 2)
			{
				if(CurserIndex == 2)
				{
					Temp_FLT_Lever_Voltage[2] = FLT_Lever_Voltage[2];
					
				}
				else if(CurserIndex == 1)
				{
					Temp_FLT_Lever_Voltage[1] = FLT_Lever_Voltage[1];
				
				}
				else
				{
					Temp_FLT_Lever_Voltage[0] = FLT_Lever_Voltage[0];
						
				}
				
				if(CurserIndex == 0)
				{
					CurserIndex = 0;
					COUNT_FLAG.Flag_FLT_Step = 0;
					SetScreenIndex(ScreenIndex&0xFFFF0000);
				}
				else
					CurserIndex--;
			}
			else
			{
				CurserIndex = 0;
				COUNT_FLAG.Flag_FLT_Step = 0;
				SetScreenIndex(ScreenIndex&0xFFFF0000);

			}
			break;		
			
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_LIFT_COMPLETE: 
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_TILT_COMPLETE:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_AUX1_COMPLETE: 
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_AUX2_COMPLETE:
			
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_POSITION_LIFT_COMPLETE: 
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_POSITION_TILT_COMPLETE:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_POSITION_AUX1_COMPLETE: 
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_POSITION_AUX2_COMPLETE:
			SetScreenIndex(ScreenIndex&0xFFFF0000);
			break;	

		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_LIFT_SET: 
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_TILT_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_AUX1_SET: 
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_AUX2_SET: 
			if(COUNT_FLAG.Flag_FLT_Step == 2)
			{
				if(SubCurserIndex == 1)
				{
					SubCurserIndex--;
					Temp_FLT_DeadZone_Voltage[1] = FLT_DeadZone_Voltage[1];
				}
				else
				{
					Temp_FLT_DeadZone_Voltage[0] = FLT_DeadZone_Voltage[0];
					SubCurserIndex = 0;
					COUNT_FLAG.Flag_FLT_Step = 0;
					SetScreenIndex(ScreenIndex&0xFFFF0000);
				}
			}
			else
			{
				Temp_FLT_DeadZone_Voltage[0] = FLT_DeadZone_Voltage[0];
				SubCurserIndex = 0;
				COUNT_FLAG.Flag_FLT_Step = 0;
				SetScreenIndex(ScreenIndex&0xFFFF0000);

			}
			break;
			
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_LIFT_UP_TOP:	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_LIFT_DOWN_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_TILT_A_TOP:	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_TILT_B_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX1_A_TOP:	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX1_B_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX2_A_TOP:	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX2_B_TOP:	
			SetScreenIndex(ScreenIndex&0xFFFF0000);
			break;	
			
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_LIFT_UP_SET:	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_LIFT_DOWN_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_TILT_A_SET:	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_TILT_B_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX1_A_SET:	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX1_B_SET:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX2_A_SET:	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX2_B_SET:	
			if(COUNT_FLAG.Flag_FLT_Step == 2)
			{
				if(SubCurserIndex > 0)
				{
					Temp_FLT_Valve_Value[SubCurserIndex] = FLT_Valve_Value[SubCurserIndex];
					SubCurserIndex--;
					
				}
				else
				{
					SubCurserIndex = 0;
					Temp_FLT_Valve_Value[0] = FLT_Valve_Value[0];
					SetScreenIndex(ScreenIndex&0xFFFFF000);
				}
			}
			else
			{
				SubCurserIndex = 0;
				Temp_FLT_Valve_Value[0] = FLT_Valve_Value[0];
				SetScreenIndex(ScreenIndex&0xFFFFF000);

			}			
			break;	

		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_LIFT_POPUP:	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_TILT_POPUP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_AUX1_POPUP:	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_DEADZONE_AUX2_POPUP:
			SubCurserIndex = 1;
			SetScreenIndex(ScreenIndex&0xFFFFF000);
			break;	
		
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_POSITION_LIFT_POPUP:	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_POSITION_TILT_POPUP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_POSITION_AUX1_POPUP:	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_LEVER_POSITION_AUX2_POPUP:
			CurserIndex = 2;
			SetScreenIndex(ScreenIndex&0xFFFFF000);
			break;	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_LIFT_UP_POPUP: 
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_LIFT_DOWN_POPUP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_TILT_A_POPUP:	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_TILT_B_POPUP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX1_A_POPUP:	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX1_B_POPUP:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX2_A_POPUP:	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX2_B_POPUP:	
			SubCurserIndex = 3;
			SetScreenIndex(ScreenIndex&0xFFFFFF00);
			break;	
			
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_LIFT_UP_COMPLETE:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_LIFT_DOWN_COMPLETE:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_TILT_A_COMPLETE:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_TILT_B_COMPLETE:	
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX1_A_COMPLETE:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX1_B_COMPLETE:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX2_A_COMPLETE:
		case SCREEN_STATE_MENU_EQUIPMENT_FINGERTIP_VALVE_SETTING_AUX2_B_COMPLETE:	
			SetScreenIndex(ScreenIndex&0xFFFFF000); 		
			break;						

			
	}

}


void EnterKeyEventMenuEquipment()
{
	switch(ScreenIndex)
	{
		case SCREEN_STATE_MENU_EQUIPMENT_TOP:				
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_PW);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_PW:		
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_CROSSSECTION_INPUT:					
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_LOADADJUST_LOAD_INPUT:	
			EnterKeyEventNumberInput();
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_PW_POPUP:			
			SetScreenIndex(ScreenIndex&0xFFFFFFF0);
			break;
		
		case SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_TOP:			
		case SCREEN_STATE_MENU_EQUIPMENT_ESL_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_TOP:		
		case SCREEN_STATE_MENU_EQUIPMENT_DCSR_TOP:									
		case SCREEN_STATE_MENU_EQUIPMENT_MAXSPEEDLIMIT_TOP:	
		case SCREEN_STATE_MENU_EQUIPMENT_TILTSETTING_TOP:	
		case SCREEN_STATE_MENU_EQUIPMENT_HAC_TOP:		
		case SCREEN_STATE_MENU_EQUIPMENT_CLUTCHPROTECTION_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_SEATBELTINTERLOCK_TOP:		
        case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_TOP:         
			OldCurserIndex = 0xff;
			if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_TOP)
			{
				if(COUNT_FLAG.ShowMenuMaster == 1)
				{			
					if(((InfoModel1.ModelInfo >= MODEL_35L_9)&&(InfoModel1.ModelInfo <= MODEL_33LC_9))||
						((InfoModel1.ModelInfo >= MODEL_25L_9A)&&(InfoModel1.ModelInfo <= MODEL_35LN_9A)))
					{
						CurserIndex = LPG_TYPE;
					}
					else
						CurserIndex = DIESEL_TYPE;
					
					SetScreenIndex(ScreenIndex | 0x00100000);
				}
				else
				{
					SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_MODEL);
				}
			}
			else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_ESL_TOP)
			{
				CurserIndex = InfoModel2.ESL_Set_Status;
				SetScreenIndex(ScreenIndex | 0x00100000);
			}
			else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_HAC_TOP)
			{
				CurserIndex = InfoModel2.HAC_Status;
				SetScreenIndex(ScreenIndex | 0x00100000);
			}
			else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_CLUTCHPROTECTION_TOP)
			{
				CurserIndex = InfoModel2.ClutchProtectionAlarm;
				SetScreenIndex(ScreenIndex | 0x00100000);
			}
			else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_SEATBELTINTERLOCK_TOP)
			{
				CurserIndex = InfoModel2.SeatBeltInterlock;	
				SetScreenIndex(ScreenIndex | 0x00100000);
			}
			else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_DCSR_TOP)
			{					
				//CurserIndex = InfoModel1.DCSR_Status;
				SetScreenIndex(ScreenIndex | 0x00100000);
				
			}
			else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_TOP)
			{
				SetScreenIndex(ScreenIndex | 0x00100000);
			}
			else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_TOP)
			{		
				//++, 230202 ysm, FSCU
				#if 0
				CurserIndex = InfoModel2.ZeroStart;
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_MODE_SET);
				#else
				SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_MODE_TOP);
				#endif
				//--, 230202 ysm, FSCU
			}
			else
			{
				SetScreenIndex(ScreenIndex | 0x00100000);
			}	
			break;
			
		case SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_MODEL:
			SetScreenIndex(SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_TOP);
			break;
			
		case SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_TYPE:	
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_CROSSSECTION_TOP:						
		case SCREEN_STATE_MENU_EQUIPMENT_WEIGHTSENSOR_LOADADJUST_TOP:			
		case SCREEN_STATE_MENU_EQUIPMENT_DCSR_MODE_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_DCSR_SPEED_TOP:		
		case SCREEN_STATE_MENU_EQUIPMENT_MAXSPEEDLIMIT_FUNC_TOP:
        case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_MODE_TOP:
        case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SPEED_TOP: 
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_OVERLAP_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_SR_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_MODE_TOP:
		case SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_ACCEL_TOP:	
			if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_DCSR_MODE_TOP)
			{
				OldCurserIndex = 0xff;
				CurserIndex = InfoModel1.DCSR_Status;
			}
			else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_MAXSPEEDLIMIT_FUNC_TOP)
			{
				OldCurserIndex = 0xff;
				CurserIndex = InfoModel2.SpeedLimitStatus;
			}
			else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_AUTOSHIFT_MODE_TOP)
			{
				OldCurserIndex = 0xff;
				CurserIndex = InfoModel3.AutoShift_Status;
			}
			else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_TYPE)
			{
				OldCurserIndex = 0xff;

				Engine_Type_Temp = CurserIndex; // 0:Diesel, 1:LPG
				
				
				if(CurserIndex == 0) // DIESEL
				{
					if((InfoModel1.ModelInfo <= MODEL_50D_9S)||(InfoModel1.ModelInfo >= MODEL_25D_9VS))
					{
						//++, 211016 ysm
						#if DEBUG_MODE
						if(InfoModel1.ModelInfo == MODEL_35D_9S)
							CurserIndex = 0;
						else if(InfoModel1.ModelInfo == MODEL_40D_9S)
							CurserIndex = 1;
						else if(InfoModel1.ModelInfo == MODEL_45D_9S)
							CurserIndex = 2;
						else if(InfoModel1.ModelInfo == MODEL_50D_9S)
							CurserIndex = 3;
						else if(InfoModel1.ModelInfo == MODEL_25D_9VB)
							CurserIndex = 4;
						else if(InfoModel1.ModelInfo == MODEL_30D_9VB)
							CurserIndex = 5;
						else if(InfoModel1.ModelInfo == MODEL_35DN_9VB)
							CurserIndex = 6;
						else if(InfoModel1.ModelInfo == MODEL_25D_9VS)
							CurserIndex = 7;
						else if(InfoModel1.ModelInfo == MODEL_30D_9VS)
							CurserIndex = 8;
						else if(InfoModel1.ModelInfo == MODEL_35DN_9VS)
							CurserIndex = 9;
						else if(InfoModel1.ModelInfo == MODEL_25D_9HDI)
							CurserIndex = 10;
						else if(InfoModel1.ModelInfo == MODEL_30D_9HDI)
							CurserIndex = 11;
						else if(InfoModel1.ModelInfo == MODEL_35DN_9HDI)
							CurserIndex = 12;
						else if(InfoModel1.ModelInfo == MODEL_35D_9HDI)
							CurserIndex = 13;
						else if(InfoModel1.ModelInfo == MODEL_40D_9HDI)
							CurserIndex = 14;
						else if(InfoModel1.ModelInfo == MODEL_45D_9HDI)
							CurserIndex = 15;
						else if(InfoModel1.ModelInfo == MODEL_50DN_9HDI)
							CurserIndex = 16;						
						#else
						if(InfoModel1.ModelInfo == MODEL_35D_9S)
							CurserIndex = 0;
						else if(InfoModel1.ModelInfo == MODEL_40D_9S)
							CurserIndex = 1;
						else if(InfoModel1.ModelInfo == MODEL_45D_9S)
							CurserIndex = 2;
						else if(InfoModel1.ModelInfo == MODEL_50D_9S)
							CurserIndex = 3;
						else if(InfoModel1.ModelInfo == MODEL_25D_9VB)
							CurserIndex = 4;
						else if(InfoModel1.ModelInfo == MODEL_30D_9VB)
							CurserIndex = 5;
						else if(InfoModel1.ModelInfo == MODEL_35DN_9VB)
							CurserIndex = 6;
						else if(InfoModel1.ModelInfo == MODEL_25D_9VS)
							CurserIndex = 7;
						else if(InfoModel1.ModelInfo == MODEL_30D_9VS)
							CurserIndex = 8;
						else if(InfoModel1.ModelInfo == MODEL_35DN_9VS)
							CurserIndex = 9;
						else
							CurserIndex = 0;

						#endif
						//--, 211016 ysm
						
						temp_ModelInfo = InfoModel1.ModelInfo;
					}
					else
					{
						CurserIndex = temp_ModelInfo = 0;
						
					}

					
				}
				else // LPG
				{					
					if(((InfoModel1.ModelInfo >= MODEL_35L_9)&&(InfoModel1.ModelInfo <= MODEL_33LC_9))||
						((InfoModel1.ModelInfo >= MODEL_25L_9A)&&(InfoModel1.ModelInfo <= MODEL_35LN_9A)))
					{
						//++, 211016 ysm
						#if 1
						if(InfoModel1.ModelInfo == MODEL_35L_9)
							CurserIndex = 0;
						else if(InfoModel1.ModelInfo == MODEL_40L_9)
							CurserIndex = 1;
						else if(InfoModel1.ModelInfo == MODEL_45L_9)
							CurserIndex = 2;
						else if(InfoModel1.ModelInfo == MODEL_50L_9)
							CurserIndex = 3;
						else if(InfoModel1.ModelInfo == MODEL_25LC_9)
							CurserIndex = 4;
						else if(InfoModel1.ModelInfo == MODEL_30LC_9)
							CurserIndex = 5;
						else if(InfoModel1.ModelInfo == MODEL_33LC_9)
							CurserIndex = 6;
						else if(InfoModel1.ModelInfo == MODEL_25L_9A)
							CurserIndex = 7;
						else if(InfoModel1.ModelInfo == MODEL_30L_9A)
							CurserIndex = 8;
						else if(InfoModel1.ModelInfo == MODEL_33L_9A)
							CurserIndex = 9;
						else if(InfoModel1.ModelInfo == MODEL_35LN_9A)
							CurserIndex = 10;
						#else
						if(InfoModel1.ModelInfo == MODEL_35L_9)
							CurserIndex = 0;
						else if(InfoModel1.ModelInfo == MODEL_40L_9)
							CurserIndex = 1;
						else if(InfoModel1.ModelInfo == MODEL_45L_9)
							CurserIndex = 2;
						else if(InfoModel1.ModelInfo == MODEL_50L_9)
							CurserIndex = 3;
						else
							CurserIndex = 0;
						#endif
						//--, 211016 ysm
						
						temp_ModelInfo = InfoModel1.ModelInfo;
					}
					else
					{
						CurserIndex = temp_ModelInfo = 0;
					}

				

				}			

			}
			else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_MODE_TOP)
			{
				OldCurserIndex = 0xff;
				CurserIndex = InfoModel2.ZeroStart;
			}
			else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_ZEROSTART_ACCEL_TOP)
			{
				tempSpeed = InfoModel2.ZeroStart_AccelValue;
				
				if(tempSpeed < 1)
					tempSpeed = 1;
				else if(tempSpeed > 12)  //++,--, 230202 ysm, FSCU 75->25->12
					tempSpeed = 12;      //++,--, 230202 ysm, FSCU 75->25->12

				OldCurserIndex = 0xFF;

			}
			SetScreenIndex(ScreenIndex | 0x00010000);
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_INFO:			

			if(Engine_Type_Temp == DIESEL_TYPE)
			{	
				#if DEBUG_MODE
				if(CurserIndex == 0)
					temp_ModelInfo = MODEL_35D_9S;
				else if(CurserIndex == 1)
					temp_ModelInfo = MODEL_40D_9S;
				else if(CurserIndex == 2)
					temp_ModelInfo = MODEL_45D_9S;
				else if(CurserIndex == 3)
					temp_ModelInfo = MODEL_50D_9S;
				else if(CurserIndex == 4)
					temp_ModelInfo = MODEL_25D_9VB;
				else if(CurserIndex == 5)
					temp_ModelInfo = MODEL_30D_9VB;
				else if(CurserIndex == 6)
					temp_ModelInfo = MODEL_35DN_9VB;
				else if(CurserIndex == 7)
					temp_ModelInfo = MODEL_25D_9VS;
				else if(CurserIndex == 8)
					temp_ModelInfo = MODEL_30D_9VS;
				else if(CurserIndex == 9)
					temp_ModelInfo = MODEL_35DN_9VS;
