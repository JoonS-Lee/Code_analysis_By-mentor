	version_high =((_FLT_SW_Version>>4)&0xf);
	version_low = (_FLT_SW_Version & 0xf);
	version_sub_high = ((_FLT_SW_Sub_Version>>4)&0xf);
	version_sub_low = (_FLT_SW_Sub_Version & 0xf);

