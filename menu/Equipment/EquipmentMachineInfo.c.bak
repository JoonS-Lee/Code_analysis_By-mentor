void SetVersion()
{
	TX_VERSION_DATA_61423->SW_Version_High = VERSION_HIGH;
	TX_VERSION_DATA_61423->SW_Version_Low= VERSION_LOW;	
	TX_VERSION_DATA_61423->SW_Version_Sub_High= VERSION_SUB_HIGH;	
	//TX_VERSION_DATA_61423->SW_Version_Sub_Low= VERSION_SUB_LOW;	

	TX_VERSION_DATA_61423->Img_Version_High=Info_Version_Img.Version_High;
	TX_VERSION_DATA_61423->Img_Version_Low=Info_Version_Img.Version_Low;
	TX_VERSION_DATA_61423->Img_Version_Sub_High=Info_Version_Img.Version_Sub;

	//++, 211118 ysm
	#if 0
	if(gHardware_Version == RevA_01)
	{
		TX_VERSION_DATA_61423->HW_Version_High = 0x0A;
		TX_VERSION_DATA_61423->HW_Version_Low= 0x01;
		TX_VERSION_DATA_61423->HW_Version_SUB= 0x01;
	}
	else if((gHardware_Version > RevA_01)&&(gHardware_Version < RevB_05))
	{
		TX_VERSION_DATA_61423->HW_Version_High = 0x0B;
		TX_VERSION_DATA_61423->HW_Version_Low= 0x01;
		TX_VERSION_DATA_61423->HW_Version_SUB= 0x01;
	}
	else
	{
		TX_VERSION_DATA_61423->HW_Version_High = 0x0B;
		TX_VERSION_DATA_61423->HW_Version_Low= 0x05;
		TX_VERSION_DATA_61423->HW_Version_SUB= 0x01;

	}
	#else	
	if(gHardware_Version == RevA_01)
	{
		TX_VERSION_DATA_61423->HW_Version_High = 0x0A;
		TX_VERSION_DATA_61423->HW_Version_Low= 0x01;
		TX_VERSION_DATA_61423->HW_Version_SUB= 0x01;
	}
	else if(gHardware_Version == RevB_01)
	{
		TX_VERSION_DATA_61423->HW_Version_High = 0x0B;
		TX_VERSION_DATA_61423->HW_Version_Low= 0x01;
		TX_VERSION_DATA_61423->HW_Version_SUB= 0x01;
	}
	else if(gHardware_Version == RevB_02)
	{
		TX_VERSION_DATA_61423->HW_Version_High = 0x0B;
		TX_VERSION_DATA_61423->HW_Version_Low= 0x02;
		TX_VERSION_DATA_61423->HW_Version_SUB= 0x01;
	}	
	else if(gHardware_Version == RevB_03)
	{
		TX_VERSION_DATA_61423->HW_Version_High = 0x0B;
		TX_VERSION_DATA_61423->HW_Version_Low= 0x03;
		TX_VERSION_DATA_61423->HW_Version_SUB= 0x01;
	}
	else if(gHardware_Version == RevB_03_03)
	{
		TX_VERSION_DATA_61423->HW_Version_High = 0x0B;
		TX_VERSION_DATA_61423->HW_Version_Low= 0x03;
		TX_VERSION_DATA_61423->HW_Version_SUB= 0x03;
	}
	else if(gHardware_Version == RevB_04)
	{
		TX_VERSION_DATA_61423->HW_Version_High = 0x0B;
		TX_VERSION_DATA_61423->HW_Version_Low= 0x04;
		TX_VERSION_DATA_61423->HW_Version_SUB= 0x01;
	}
	else if(gHardware_Version == RevB_05)
	{
		TX_VERSION_DATA_61423->HW_Version_High = 0x0B;
		TX_VERSION_DATA_61423->HW_Version_Low= 0x05;
		TX_VERSION_DATA_61423->HW_Version_SUB= 0x01;
	}
	else if(gHardware_Version == RevB_05_02)
	{
		TX_VERSION_DATA_61423->HW_Version_High = 0x0B;
		TX_VERSION_DATA_61423->HW_Version_Low= 0x05;
		TX_VERSION_DATA_61423->HW_Version_SUB= 0x02;
	}
	else if(gHardware_Version == RevC_01)
	{
		TX_VERSION_DATA_61423->HW_Version_High = 0x0C;
		TX_VERSION_DATA_61423->HW_Version_Low= 0x01;
		TX_VERSION_DATA_61423->HW_Version_SUB= 0x00;
	}
	else
	{
		TX_VERSION_DATA_61423->HW_Version_High = 0x0C;
		TX_VERSION_DATA_61423->HW_Version_Low= 0x01;
		TX_VERSION_DATA_61423->HW_Version_SUB= 0x0;

	}	

	// ANGLE TEST MODE
	#if 1
	gHardware_Version = RevC_01;
	TX_VERSION_DATA_61423->HW_Version_High = 0x0C;
	TX_VERSION_DATA_61423->HW_Version_Low= 0x01;
	TX_VERSION_DATA_61423->HW_Version_SUB= 0x0;
	#endif
		
	#endif
	//--, 211118 ysm

}

//++, 221226 ysm, FSCU
void DisplayRMCUSerialNumber()
{
	USHORT covbuf[20]={0,};
	UCHAR  rmcu_serial_info = 0;

	for(int i=0;i<16;i++)
	{
		if(HCESPN.H1586[i] != 0xff)
		{
			covbuf[i] = HCESPN.H1586[i];
			rmcu_serial_info = 1;
		}		
	}
	if(rmcu_serial_info == 1)
	{
		GUI_DisplayCenterStringAt(&covbuf[0], 6, 140, 200, COLOR_WHITE, 23);
	}
	else
	{
		GUI_DisplayCenterStringAt(&string_NoInfo[0], 6, 140, 200, COLOR_WHITE, 23);
	}
	
	
}

void DisplayRMCUSWVersion()
{
	UCHAR buf[20];
	USHORT covbuf[20];
	//++, 220428 ysm, 9V_DPF
	UCHAR version_high,version_low;
	//--, 220428 ysm, 9V_DPF

	version_high =((HCESPN.H1583>>4)&0xf);
	version_low = (HCESPN.H1583 & 0xf);

	if((version_high != 0xf)&&(version_low != 0xf))
	{

		memset((&buf), 0x0, sizeof( buf));
		memset((&covbuf), 0x0, sizeof( covbuf));

		sprintf ( (char*)buf, "%d.%d",version_high,version_low);
		
		String_Func(covbuf, buf);
		GUI_DisplayCenterStringAt(&covbuf[0], 6, 140, 200, COLOR_WHITE, 23);
	}
	else
		GUI_DisplayCenterStringAt(&string_NoInfo[0], 6, 140, 200, COLOR_WHITE, 23);
}

