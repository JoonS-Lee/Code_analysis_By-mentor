//++, 220929 ysm, FSCU
void DisplayFSCUSWVersion()
{

	UCHAR buf[20];
	USHORT covbuf[20];
	UCHAR version_high,version_low;
	//UCHAR version_sub_high,version_sub_low;

	memset((&buf), 0x0, sizeof( buf));
	memset((&covbuf), 0x0, sizeof( covbuf));

	version_high =((_FSCU_SW_Version>>4)&0xf);
	version_low = (_FSCU_SW_Version & 0xf);
	//version_sub_high = ((_FSCU_SW_Sub_Version>>4)&0xf);
	//version_sub_low = (_FSCU_SW_Sub_Version & 0xf);

	if(_FSCU_SW_Version != 0xff)
	{
		#if 0
		if(_FSCU_SW_Sub_Version == 0xff)
			sprintf ( (char*)buf, "%d.%d",version_high,version_low);
		else
			sprintf ( (char*)buf, "%d.%d.%d.%d",version_high,version_low,version_sub_high,version_sub_low);	
		#else
		sprintf ( (char*)buf, "%d.%d",version_high,version_low);
		#endif
		String_Func(covbuf, buf);
		GUI_DisplayCenterStringAt(&covbuf[0], 6, 140, 200, COLOR_WHITE, 23);

	}
	else
	{
		GUI_DisplayCenterStringAt(&string_NoInfo[0], 6, 140, 200, COLOR_WHITE, 23);
	}

}
