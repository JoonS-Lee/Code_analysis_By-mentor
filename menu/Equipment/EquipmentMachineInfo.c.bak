#include "FLV_Cluster_APP.h"

#define	HW_TEST_ADDR		0x080A0000
#define	LOT_ADDR			0x080E0000

//// v0.0.1		(200116)
// 1. 초도품(화면설정, 메인, LED 완료)
//// v0.1.0		(200522)
// 1. Alt 기준 전압 12V -> 10V로 변경 
//// v0.2.0		(200522)
// 1. SpeedLimit MMI 연동해서 값 변경할 수 있도록 변경 
// 2. 속도제한 관련 표시 
//--------------------RevB---------------------------//
//// v.0.1.0		(200617)
// 1. RevB.01 적용
// 2. Engine Check -> 소모품 교환 등으로 변경 
// 3. TM Oil Temp, TM Oil Pressure 적용(DIN -> AIN)
//--------------------------------------
//// v.0.1.0		(200710)
// 1. DCSR 버그 수정(후진 안되는 현상 개선) 
// 2. ZERO START 기능 추가 
// 3. DPF 관련 메인화면 추가(기능확인 못함)
// 4. MAST 추가 하였으나 장비 시험 못함(아직 달리지 않음)
// 5. 클러치 보호기능 추가(기능 확인 못함)
//--------------------------------------
//// v.0.1.1		(200821)
// 1. AUTO LEVELING 구현 
// 2. RevB.02 추가
// 3. HAC 기능 추가
// 4. 속도 관련 0.9km/h 차이나는 것 개선(unsigned short -> float)
// 5. Cluster 품번 저장 추가
// 6. 각도관련 CAN TX 추가
// 7. FS5C2007D00005, FS5C2008D00006 프로토 장비로 인식 
//--------------------------------------
//// v.0.1.2		(200924)
// 1. LPG 모델
//// v.0.4.0		(201030)
// 1. LPG 모델정리
// 2. 이미지 및 색상 변경
// 3. 장비 설정 메뉴 트리 변경
// 4. ADC 함수 인터럽트로 이동
//// v.0.2.0        (210303)
// 1. TILT_LOCK 동작 변경
// 2. 타이어 모델 변경
// 3. 속도 제한 튜닝(45L-9)

//// v.0.3.0        (210303)
// 1. 9S, 9A 모델 추가

//// v.0.4.0        (210419)
// 1. LPG 모델 FUEL LEVEL LOW 램프 테스트(10초에서 즉시로 변경)
// 2. 35DN-9VB 속도제한 튜닝 완성

//// v.0.1.5        (210426)
// 1. PPAP 승인으로 인한 버전 수정
// 개발은 히든 버전만 수정하기로 

//// v.0.1.6        (210503)
// 1. LPG 연료 경고등 로직 수정(ON : 5초 지속, OFF : 10초 지속)
// 2. 25~33LC-9 수정
// 개발은 히든 버전만 수정하기로 

//// v.0.1.7        (210527)
// 1. HAC 기능 수정
// 2. AUTO SHIFT MODE 기능 수정(SR값 다시 적용)
// 3. 9S 용 최대 주행 속도 제한 문구 수정
// 개발은 히든 버전만 수정하기로

//// v.0.1.8        (210528)
// 1. LPG 모델의 FUEL EMPTY 램프는 PWD/STD 입력으로 수정
