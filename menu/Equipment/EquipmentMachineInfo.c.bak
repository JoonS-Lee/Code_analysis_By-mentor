void DisplayPartNumber()
{
	USHORT String_Cluster[20]={'2','Y','F','G','-','1','5','3','1','0',0x00,};
	if((_Cluster_Model[0] != 0) && (_Cluster_Model[0] != 0xff))
	{
		for(int i=0;i<10;i++)
		{
			if(_Cluster_Model[i] != 0xff)
				String_Cluster[i] = _Cluster_Model[i];
		}
	}

	GUI_DisplayCenterStringAt(&String_Cluster[0], 6, 140, 200, COLOR_WHITE, 23);

}

