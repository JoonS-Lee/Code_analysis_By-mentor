void DisplayHiddenPage()
{
	UCHAR buf[25]={0,};
	USHORT covbuf[25]={0,};

	sprintf ( (char*)buf, "%d.%d.%d / Img %d.%d.%d",VERSION_HIGH,VERSION_LOW,VERSION_SUB_HIGH//,VERSION_SUB_LOW
		,Info_Version_Img.Version_High,Info_Version_Img.Version_Low,Info_Version_Img.Version_Sub);
	
	String_Func(covbuf, buf);
	GUI_DisplayCenterStringAt(&covbuf[0], 6, 105, 200, COLOR_WHITE, 23);

	memset((&buf), 0x0, sizeof( buf));
	memset((&covbuf), 0x0, sizeof( covbuf));

	if(gHardware_Version == RevA_01)
		sprintf ( (char*)buf, "RevA.01") ;
	else if(gHardware_Version == RevB_01)
		sprintf ( (char*)buf, "RevB.01") ;
	else if(gHardware_Version == RevB_02)
		sprintf ( (char*)buf, "RevB.02") ;
	else if(gHardware_Version == RevB_03)
		sprintf ( (char*)buf, "RevB.03") ;
	else if(gHardware_Version == RevB_03_03)
		sprintf ( (char*)buf, "RevB.03") ;
	else if(gHardware_Version == RevB_04)
		sprintf ( (char*)buf, "RevB.04") ;
	else if(gHardware_Version == RevB_05)
		sprintf ( (char*)buf, "RevB.05") ;
	else if(gHardware_Version == RevB_05_02) //++, 211122 ysm
		sprintf ( (char*)buf, "RevB.05_02"); //--, 211122 ysm
	else if(gHardware_Version == RevC_01) //++, 211201 ysm
		sprintf ( (char*)buf, "RevC.01"); //--, 211201 ysm
	else
		sprintf ( (char*)buf, "HW Rev%d", gHardware_Version) ;
	
	String_Func(covbuf, buf);
	GUI_DisplayCenterStringAt(&covbuf[0], 6, 140, 200, COLOR_WHITE, 23);

}

void DisplayMachineInfo()
{
	DisplayMenuBackgroundBG();

	OldScreenIndex = ScreenIndex;

	USHORT String_ECM[]={'E','C','M',0};
	USHORT String_Cluster[]={'C','L','U','S','T','E','R',0};
	USHORT String_RMCU[]={'R','M','C','U',0};
	USHORT String_FLT[]={'F','I','N','G','E','R','-','T','I','P',0};
	USHORT String_FSCU[]={'F','S','C','U',0}; //++,--, 220929 ysm, FSCU
	
	unsigned short String_PN[] = {0x0050, 0x0061, 0x0072, 0x0074, 0x0020, 0x004e, 0x0075, 0x006d, 0x0062, 0x0065, 0x0072, 0x00 };
	unsigned short String_SN[] = {0x0053, 0x0065, 0x0072, 0x0069, 0x0061, 0x006c, 0x0020, 0x004e, 0x006f, 0x002e, 0x00 };
	unsigned short String_SW[] = {0x0053, 0x002f, 0x0057, 0x0020, 0x0056, 0x0065, 0x0072, 0x0073, 0x0069, 0x006f, 0x006e, 0x00 };
	unsigned short *String_Info[]={&String_PN[0],&String_SN[0],&String_SW[0]};
	unsigned char tempList;

	//++, 210928, ECM_Info
	#if 0
	if( (OldScreenIndex&0xFFF00000) == SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_ECM_TOP)
	{
		GUI_DisplayLeftStringAt(&String_ECM[0], 12, 55, 200, COLOR_MENU_ORANGE, 23);
		tempList = 2;
	}
	else if( (OldScreenIndex&0xFFF00000) == SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_TOP)
	{
		GUI_DisplayLeftStringAt(&String_Cluster[0], 12, 55, 200, COLOR_MENU_ORANGE, 23);
		tempList = 3;
	}
	else
	{
		GUI_DisplayLeftStringAt(&String_RMCU[0], 12, 55, 200, COLOR_MENU_ORANGE, 23);
		tempList = 2;

	}
	#else
	if( (OldScreenIndex&0xFFF00000) == SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_ECM_TOP)
	{
		GUI_DisplayLeftStringAt(&String_ECM[0], 12, 55, 200, COLOR_MENU_ORANGE, 23);
		tempList = 3;
	}
	else if( (OldScreenIndex&0xFFF00000) == SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_TOP)
	{
		GUI_DisplayLeftStringAt(&String_Cluster[0], 12, 55, 200, COLOR_MENU_ORANGE, 23);
		tempList = 3;
	}
	else if( (OldScreenIndex&0xFFF00000) == SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FLT_TOP)
	{
		GUI_DisplayLeftStringAt(&String_FLT[0], 12, 55, 200, COLOR_MENU_ORANGE, 23);
		tempList = 3;

	}
	//++, 220929 ysm, FSCU
	else if( (OldScreenIndex&0xFFF00000) == SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FSCU_TOP)
	{
		GUI_DisplayLeftStringAt(&String_FSCU[0], 12, 55, 200, COLOR_MENU_ORANGE, 23);
		tempList = 3;

	}
	//--, 220929 ysm, FSCU
	else
	{
		GUI_DisplayLeftStringAt(&String_RMCU[0], 12, 55, 200, COLOR_MENU_ORANGE, 23);
		tempList = 2;

	}
	#endif
	//--, 210928, ECM_Info

	
	LCD_Draw_Color(6, 90, 200, 80, COLOR_MENU_GRAY);

	if(OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_DETAIL_HIDDEN)
	{
		if(OldScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_RMCU_SERIAL_NUMBER)
			GUI_DisplayCenterStringAt(String_Info[1], 6, 105, 200, COLOR_ORANGE, 23);	
		else if(OldScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_RMCU_SW_VERSION)
			GUI_DisplayCenterStringAt(String_Info[2], 6, 105, 200, COLOR_ORANGE, 23);
		else
			GUI_DisplayCenterStringAt(String_Info[((OldScreenIndex&0x0000F000)>>12)-1], 6, 105, 200, COLOR_ORANGE, 23);

		DisplayListPage((OldScreenIndex&0x0000F000)>>12,tempList);
	}
	
	switch(OldScreenIndex)
	{
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_ECM_PART_NUMBER:
			DisplayECMPartNumber();
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_ECM_SERIAL_NUMBER:
			DisplayECMSerialNumber();
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_ECM_SW_VERSION:
			DisplayECMSWVersion();
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_PART_NUMBER:
			DisplayPartNumber();
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_SERIAL_NUMBER:
			DisplaySerialNumber();
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_SW_VERSION:
			DisplaySWVersion();
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_CLUSTER_DETAIL_HIDDEN:
			DisplayHiddenPage();
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_RMCU_SERIAL_NUMBER:
			DisplayRMCUSerialNumber();
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_RMCU_SW_VERSION:
			DisplayRMCUSWVersion();			
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FLT_PART_NUMBER:
			DisplayFLTPartNumber();
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FLT_SERIAL_NUMBER:
			DisplayFLTSerialNumber();
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FLT_SW_VERSION:
			DisplayFLTSWVersion();
			break;	
		//++, 220929 ysm, FSCU
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FSCU_PART_NUMBER:
			DisplayFSCUPartNumber();
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FSCU_SERIAL_NUMBER:
			DisplayFSCUSerialNumber();
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MACHINEINFO_FSCU_SW_VERSION:
			DisplayFSCUSWVersion();
			break;	
		//--, 220929 ysm, FSCU			
			
			
	}
	DrawMenuFull();
}

USHORT	step0[]={'S','e','a','r','c','h','i','n','g',' ','R','M','S','/','G','P','S',' ','A','n','t','e','n','n','a',0x00};
USHORT	step1[]={'U','p','d','a','t','i','n','g',' ','R','M','S','/','G','P','S',' ','C','o','m','m','.',0x00};
USHORT	step2[]={'S','e','n','d','i','n','g',' ','t','e','s','t',' ','m','s','g',0x00};
USHORT	step3[]={'R','e','c','e','i','v','i','n','g',' ','f','r','o','m',' ','s','e','r','v','e','r','(','C','G',')',0x00};
USHORT	step4[]={'W','a','i','t','i','n','g',' ','f','o','r',' ','i','n','s','t','r','u','c','t','i','o','n','s',0x00};
USHORT	step5[]={'D','e','l','i','v','e','r','y',' ','S','t','a','t','u','s',0x00};
USHORT	stepA[]={'C','o','m','p','l','e','t','e','d',' ','R','M','S',0x00};

USHORT	press0[]={'H','O','M','E','+','L','E','F','T','(','3','s',')',0x00};	
USHORT	press1[]={'H','O','M','E','+','R','I','G','H','T','(','3','s',')',0x00};
USHORT	press2[]={'H','O','M','E','+','E','N','T','E','R','(','3','s',')',0x00};

void DisplayRMCUSet()
{
	
	USHORT	step[]={'S','T','E','P',' ',0x00 ,0x00};


	if(ScreenIndex != OldScreenIndex)
	{
		
		LCD_Draw_Color(0, 48, LCD_WIDTH, LCD_HEIGHT-48, COLOR_BLACK);
		DisplayMenuPopup();
		
		if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_RMCU_STEP_0) 			step[5] = '0';
		else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_RMCU_STEP_1)		step[5] = '1';
		else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_RMCU_STEP_2)		step[5] = '2';
		else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_RMCU_STEP_3)		step[5] = '3';
		else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_RMCU_STEP_4)		step[5] = '4';
		else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_RMCU_STEP_5)		step[5] = '5';
		else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_RMCU_STEP_A)		step[5] = 'A';
			
		GUI_DisplayCenterStringAt(&step[0], 0, 55, LCD_WIDTH, COLOR_MENU_ORANGE, 23);

		if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_RMCU_STEP_0)
		{
			GUI_DisplayMultiStringAt(&step0[0], 11, 90, 200, 0, COLOR_WHITE, 23);

		}
		else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_RMCU_STEP_1)
		{
			GUI_DisplayMultiStringAt(&step1[0], 11, 90, 200, 0, COLOR_WHITE, 23);
		}
		else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_RMCU_STEP_2)
		{
			GUI_DisplayMultiStringAt(&step2[0], 11, 90, 200, 0, COLOR_WHITE, 23);
			GUI_DisplayCenterStringAt(&press0[0], 0, 150, LCD_WIDTH, COLOR_ORANGE, 23);
		}
		else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_RMCU_STEP_3)
		{
			GUI_DisplayMultiStringAt(&step3[0], 11, 90, 200, 0, COLOR_WHITE, 23);
			GUI_DisplayCenterStringAt(&press0[0], 0, 150, LCD_WIDTH, COLOR_ORANGE, 23);
		}
		else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_RMCU_STEP_4)
		{
			GUI_DisplayMultiStringAt(&step4[0], 11, 90, 200, 0, COLOR_WHITE, 23);
			GUI_DisplayCenterStringAt(&press1[0], 0, 150, LCD_WIDTH, COLOR_ORANGE, 23);
		}
		else if(ScreenIndex == SCREEN_STATE_MENU_EQUIPMENT_RMCU_STEP_5)
		{
			GUI_DisplayMultiStringAt(&step5[0], 11, 90, 200, 0, COLOR_WHITE, 23);
			GUI_DisplayCenterStringAt(&press2[0], 0, 150, LCD_WIDTH, COLOR_ORANGE, 23);
		}
		else
		{
			GUI_DisplayMultiStringAt(&stepA[0], 11, 90, 200, 0, COLOR_WHITE, 23);

		}
		
		DrawMenuFull();
	}
	

}


