void DisplayModelSetting()
{
	switch(ScreenIndex)
	{
		case SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_MODEL:
			if((OldScreenIndex != ScreenIndex) || (OldCurserIndex != CurserIndex))
				DisplayModelSettingModelInfo();
			break;
			
		case SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_TYPE:
			if((OldScreenIndex != ScreenIndex) || (OldCurserIndex != CurserIndex))
				DisplayModelSettingTypeList();
			break;
			
		case SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_INFO:		
			if((OldScreenIndex != ScreenIndex) || (OldCurserIndex != CurserIndex))
				DisplayModelSettingInfoList();
			break;

		case SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_TIRE:		
			if((OldScreenIndex != ScreenIndex) || (OldCurserIndex != CurserIndex))
				DisplayModelSettingTIREList();
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_CHANGE_POPUP:			
			if(OldScreenIndex != ScreenIndex)
				DisplayModelInitSetting();
			break;
		case SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_CHANGE_COMPLETE:	
		case SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_CHANGE_NOT_COMPLETE:
			DisplayPopupStringComplete();
			break;
			/*
		case SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_CHANGE_RESET:
					
			if(OldScreenIndex != ScreenIndex) 
				DisplayResetPopup();
			break;
			*/
	}
	
}
