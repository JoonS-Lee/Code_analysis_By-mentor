			PCXtoBMP_16bit(temp_posx, temp_posy, 98, 122, FL_Image.bg_setting_4_select);
			PCXtoBMP_16bit(temp_posx+18, temp_posy+94, 64, 18, FL_Image.diesel_orange);
			PCXtoBMP_16bit(temp_posx+27, temp_posy+16, 45, 65, FL_Image.menu_icon_diesel_selected);
			
			PCXtoBMP_16bit(temp_posx+102, temp_posy, 98, 122, FL_Image.bg_gray_4_nor);
			PCXtoBMP_16bit(temp_posx+102+31, temp_posy+94, 40, 17, FL_Image.lpg_gray);
			PCXtoBMP_16bit(temp_posx+129, temp_posy+16, 45, 65, FL_Image.menu_icon_lpg_nor);
		}
		else // LPG
		{
			PCXtoBMP_16bit(temp_posx, temp_posy, 98, 122, FL_Image.bg_gray_4_nor);
			PCXtoBMP_16bit(temp_posx+18, temp_posy+94, 64, 18, FL_Image.diesel_gray);
			PCXtoBMP_16bit(temp_posx+27, temp_posy+16, 45, 65, FL_Image.menu_icon_diesel_nor);
			
			PCXtoBMP_16bit(temp_posx+102, temp_posy, 98, 122, FL_Image.bg_setting_4_select);
			PCXtoBMP_16bit(temp_posx+102+31, temp_posy+94, 40, 17, FL_Image.lpg_orange);
