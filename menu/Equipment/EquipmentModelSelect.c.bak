void DisplayModelInitSetting()
{
	if(OldScreenIndex != ScreenIndex)
	{
		DisplayMenuPopup();
	
		USHORT y_Height = GetStringMultiLineHeight((USHORT*)*StringSentence[28], StringEtc[SIGN_NOSTRING], StringEtc[SIGN_NOSTRING], 200,  23);
		USHORT y_offset = 0, y_margin = 0;

		if(y_Height < 122)
		{
			y_offset = (122 - (y_Height) - 30)/2;
			if((122 - (y_Height) - 30) % 2 == 1)
				y_offset -= 1;
			y_margin = 30;
		}
		else
		{
			y_offset = (122 - (y_Height) - 10)/2;
			if((122 - (y_Height) - 10) % 2 == 1)
				y_offset -= 1;
			y_margin = 10;
		}

		y_offset += 48;


		DisplayStringAt(StringModel[temp_ModelInfo], 11, y_offset, gui_font23, COLOR_WHITE);

		y_offset+=y_margin;
		GUI_DisplayMultiStringAt((USHORT*)*StringSentence[26], 11, y_offset, 200, 0, COLOR_WHITE, 23);

		DrawMenuFull();
	}


}

