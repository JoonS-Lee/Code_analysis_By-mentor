void DisplayModelSettingModelInfo()
{
	if(OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_MODEL)
	{
		OldCurserIndex = CurserIndex;

		SetListString_1(StringModel[InfoModel1.ModelInfo]);
		DisplaySubListAll(1);		
		
		DrawMenuFull();
	}
	else if(OldCurserIndex != CurserIndex)
	{				

		DisplayList(1);
		OldCurserIndex = CurserIndex;
	}
}

void DisplayModelSettingTypeList()
{
