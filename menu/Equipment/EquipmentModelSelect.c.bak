void DisplayModelSettingTIREList()
{
	if(OldScreenIndex != SCREEN_STATE_MENU_EQUIPMENT_MODELSELECT_TIRE)
	{
		OldCurserIndex = CurserIndex;

		SetListString_2(StringTire[0], StringTire[1]);
		DisplaySubListAll(CurserIndex+1);		
		
		DrawMenuFull();
	}
	else if(OldCurserIndex != CurserIndex)
	{				
		if(CurserIndex == 0) 					
		{						
			DisplayList(1);
		}
		else
		{			
			DisplayList(2);
		
		}


		OldCurserIndex = CurserIndex;
	}


}

