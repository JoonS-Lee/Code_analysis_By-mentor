void Initialize_LED_Variable()
{
	unsigned char i;

	Symbol_state=0xffffff;

	for (i = 0; i < 10; i++)
	{
		Led_SIG_TEMP[i] = 0; 		
	}

	gEngineCheck_Status = gEngineCheck_Blinking_Cnt = gEngineCheck_Blinking_Disp = 0;
	gRegeneration_Status = gRegeneration_Blinking_Cnt = gRegeneration_Blinking_Disp = 0;

	Brake_Oil_Level_Low_Count = 0; //++,--, 230102 ysm, BRAKE_OIL

	
}

void LED_Delay(void)
{
	nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;
	nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;
	nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;
	nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;
	nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;
	nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;
	nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;
	nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;
	nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;nop () ;
}

void LED_Delay2(unsigned int delay)
{
	LED_Timing_Delay = delay;
	while(--LED_Timing_Delay != 0);
}


void LED_START(void)
{
	SDAOUT ;
	SDA1;    
	/* start */
	SDA1;
	SCL1 ;
	LED_Delay();
	SDA0;
	LED_Delay();
	SCL0 ;
}

void LED_END(void)
{
	/* stop */
	SDA0;
	LED_Delay();
	SCL1 ;
	LED_Delay();
	SDA1;    
	LED_Delay2(25);
}

void LED_PortChange(unsigned char dir)
{	
	GPIO_InitTypeDef GPIO_InitStruct;
	if(dir)	// Output
	{	
		/*Configure GPIO pins : C_EEP_SDA_Pin */
		GPIO_InitStruct.Pin = GPIO_PIN_2;
		GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_OD;
		GPIO_InitStruct.Pull = GPIO_NOPULL;
		GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_HIGH;
		HAL_GPIO_Init(GPIOE, &GPIO_InitStruct);
	}
	else	// Input
	{	
		/*Configure GPIO pins : C_EEP_SDA_Pin */
		GPIO_InitStruct.Pin = GPIO_PIN_2;
		GPIO_InitStruct.Mode = GPIO_MODE_INPUT;
		GPIO_InitStruct.Pull = GPIO_NOPULL;
		HAL_GPIO_Init(GPIOE, &GPIO_InitStruct);
	}
}

void LED_ByteWrite(unsigned char WData)
{
	unsigned char i, j;

	LED_Delay();

	for(i = 0; i < 8; i++)
	{
		j = ( WData & 0x80 ) ? 1 : 0;
		(j) ? SDA1 : SDA0;
		LED_Delay();
		SCL1;
		LED_Delay();
		WData <<= 1;
		SCL0;
		LED_Delay();
	}
}

unsigned char LED_ack(void)
{
	unsigned char i;

	unsigned char RData = 0;

	LED_Delay();
	SCL0;
	LED_Delay();
	SDAIN;

	for(i = 0; i < 1; i++)
	{
		SCL1;
		LED_Delay();
		RData = (RData << 1) | SDA_READ;
		SCL0;
		LED_Delay();
	}

	SDAOUT;
	SDA0;

	return(RData);
}
void LED_ON_OFF(char add, char on_off)
{
	LED_START();

	LED_ByteWrite(0x78);
	ack = LED_ack();
	SDAOUT;
	LED_ByteWrite(add);
	ack = LED_ack();
	SDAOUT;
	LED_ByteWrite(on_off);
	ack = LED_ack();

	LED_END();
}

void LED_Write(unsigned Add, unsigned char WData)
{ 

	LED_START();

	LED_ByteWrite(0x78);
	ack = LED_ack();
	SDAOUT;
	LED_ByteWrite(0X00);
	ack = LED_ack();
	SDAOUT;
	LED_ByteWrite(0x40);
	ack = LED_ack();

	LED_END();

	for(int i = 3; i < 0x26; i++)
	{
		LED_START();

		LED_ByteWrite(0x78);
		ack = LED_ack();
		SDAOUT;
		LED_ByteWrite(i);
		ack = LED_ack();
		SDAOUT;
		LED_ByteWrite(0xFE);
		ack = LED_ack();

		LED_END();
	}  

}

void Initialize_LEDSystem(void)
{
	LED_Write(0,1); 	//LED ? LP5024 ON! 
}

