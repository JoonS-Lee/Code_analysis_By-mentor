void CheckEnigneCheckLamp(void)
{
	if(gEngineCheck_Status==1) // fast blinking	// 500ms on, 500ms off
	{
		gEngineCheck_Blinking_Cnt++;
		if(gEngineCheck_Blinking_Cnt < 50)
			gEngineCheck_Blinking_Disp = 1;
		else if(gEngineCheck_Blinking_Cnt < 100)
			gEngineCheck_Blinking_Disp = 0;
		else
		{
			gEngineCheck_Blinking_Cnt = 0;
			gEngineCheck_Blinking_Disp = 0;
		}
	}
	else
	{
		gEngineCheck_Blinking_Cnt=0;
		gEngineCheck_Blinking_Disp=0;
	}
}


unsigned char Engine_Check_LampSystem(void)
{
	unsigned char Engine_Check_flag;

	if(Engine_Type == DIESEL_TYPE)
	{
		if((InfoModel1.ModelInfo >= MODEL_35D_9S)&&(InfoModel1.ModelInfo <= MODEL_50D_9S))
		{
			if(Make_EngineCheckLamp() < 100)
			{
				Engine_Check_flag = 1;
			}
			else
			{
				Engine_Check_flag=0;
			}

		}
		else if((InfoModel1.ModelInfo >= MODEL_25D_9HDI)&&(InfoModel1.ModelInfo <= MODEL_50DN_9HDI))
		{
		
			if(RX_ECU_DATA_65226.Flash_Protect_Lamp == 0)
				Engine_Check_flag = 2; // SLOW FLASH
			else
			{
				if(RX_ECU_DATA_65226.Protect_Lamp_Status == 1)
					Engine_Check_flag = 1;
				else
					Engine_Check_flag = 0;				
			}

		}		
		else
		{

			if(RX_ECU_DATA_65226.Amber_Warning_Lamp_Status_624 < 0x03)
				Engine_Check_flag = RX_ECU_DATA_65226.Amber_Warning_Lamp_Status_624 ;
			else
				Engine_Check_flag=0;
		}

	}
	else
	{
		if(RX_ECU_DATA_65226.Red_Stop_Lamp_Status == 0x00)
		{
			if(RX_ECU_DATA_65226.MIL_Status < 0x03)
				Engine_Check_flag = RX_ECU_DATA_65226.MIL_Status;
			else
				Engine_Check_flag = 0;
		}
		else
		{
			Engine_Check_flag = 0;				
		
		}

	}
	
	if(Engine_Check_flag == 2)
	{
		gEngineCheck_Status = 1;
		CheckEnigneCheckLamp();
		Engine_Check_flag = gEngineCheck_Blinking_Disp;
	}
	else
	{
		gEngineCheck_Status = gEngineCheck_Blinking_Cnt = gEngineCheck_Blinking_Disp = 0;
	}
	
	WarnningFlag[WARNING_ENGINE_CHECK] = Signal_Engine_Check_lamp = Engine_Check_flag;
	
	return Engine_Check_flag;
}

//++, 201123 ysm, ENG_OIL

short Temp_Engine_Oil_Pressure;
unsigned char Temp_Engine_Oil_Pressure_Flag;
unsigned char Engine_Oil_Pressure_LampSystem(void)
{
	unsigned char Engine_Oil_Pressure_Flag;
	short Engine_Oil_Pressure;

	if(Engine_Type == DIESEL_TYPE)
	{
		if((InfoModel1.ModelInfo >= MODEL_25D_9HDI)&&(InfoModel1.ModelInfo <= MODEL_50DN_9HDI))
		{

			if(HDI_Oil_Pressure_Lamp_Warning_Count >= 1)
			{
				Engine_Oil_Pressure_Flag=1;
			}
			else
				Engine_Oil_Pressure_Flag=0;
			
		}
		else
		{
			Engine_Oil_Pressure_Flag = Flag_DIN[INDEX_ENG_OIL_PRESSURE_SW];
		}

	}
	else
	{

	
		if(HCESPN.Engine_Oil_Pressure_LPG == 0xff)
			return 0;
		else
			Engine_Oil_Pressure = HCESPN.Engine_Oil_Pressure_LPG;

        Temp_Engine_Oil_Pressure= Engine_Oil_Pressure;

		if(((InfoModel1.ModelInfo >= MODEL_25LC_9)&&(InfoModel1.ModelInfo <= MODEL_33LC_9))||
			((InfoModel1.ModelInfo >= MODEL_25L_9A)&&(InfoModel1.ModelInfo <= MODEL_35LN_9A)))
		{
			if(Engine_Oil_Pressure < 0xAC) // 375kPA
				Engine_Oil_Pressure_Flag = 1;
			else
				Engine_Oil_Pressure_Flag=0;

		}
		else // L-9
		{
		
			if(Engine_Oil_Pressure == 0) // 0KPA
				Engine_Oil_Pressure_Flag = 1;
			else
				Engine_Oil_Pressure_Flag=0;
		}


	}

	WarnningFlag[WARNING_ENGINE_OIL_PRESSURE_LOW] = Signal_Engine_Oil_Check_lamp = Engine_Oil_Pressure_Flag;
	
	Signal_Engine_Oil_Check_lamp = Engine_Oil_Pressure_Flag;
    Temp_Engine_Oil_Pressure_Flag= Engine_Oil_Pressure_Flag;
	
	return Engine_Oil_Pressure_Flag;
}
//--, 201123 ysm, ENG_OIL

unsigned char Engine_Coolant_Overheat_LampSystem(void)
{
	unsigned char Engine_Coolant_Overheat_Flag;
	short CoolantTemp;

	#if 0
	if((InfoModel1.ModelInfo >= MODEL_35D_9S)&&(InfoModel1.ModelInfo <= MODEL_50D_9S))
	{
		CoolantTemp = 0;


	}
	else
	{		
		if(RX_ECU_DATA_65262.CoolantTemp_110 == 0xff)
			return 0;
		else
			CoolantTemp = RX_ECU_DATA_65262.CoolantTemp_110 -40;
	}
	#else
	HCESPN.H304_Coolant_temp = RX_ECU_DATA_65262.CoolantTemp_110;
	
	if(RX_ECU_DATA_65262.CoolantTemp_110 == 0xff)
	{
     	WarnningFlag[WARNING_ENGINE_COOLANT_TEMP] = 0;
		return 0;
	}
	else
	{
		CoolantTemp = RX_ECU_DATA_65262.CoolantTemp_110 -40;
	}

	
	#endif

	if(CoolantTemp >= 115) //210708 ysm, code_review
		Engine_Coolant_Overheat_Flag = 1;
	else
		Engine_Coolant_Overheat_Flag=0;

	 WarnningFlag[WARNING_ENGINE_COOLANT_TEMP] = Engine_Coolant_Overheat_Flag;

	return Engine_Coolant_Overheat_Flag;
}

