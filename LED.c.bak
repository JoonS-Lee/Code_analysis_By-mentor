void LED_Update_System(void)
{
	unsigned long temp;
	unsigned char i;
	unsigned char add_LED[]={LED0,LED1,LED2,LED3,LED4,LED5,LED6,LED7,LED8,LED9,LED10,LED11,LED12,LED13,LED14,LED15,LED16,LED17,LED18};

	// SIG
	temp = 0x00000001;
#if 1

	for ( i = 0 ; i < 19 ; i++)
	{  
		if ( Symbol_state & temp )
			LED_ON_OFF(add_LED[i],ON);
		else	
			LED_ON_OFF(add_LED[i],OFF);

		temp = temp << 1;
	}
#else
	if(Symbol_state == 0)
		LED_ALL_ON();
	else
		LED_ALL_OFF();
#endif
}


void Check_Warnning_Data(void)
{

	
	if(EngineStartFlag==1)
	{	

		if(WarnningFlag[WARNING_BAT_VOLTAGE_LOW] == 1)
			WarnningCounter[WARNING_BAT_VOLTAGE_LOW]++;
		else
		{
			WarnningCounter[WARNING_BAT_VOLTAGE_LOW] = 0;
			HCESPN.H706 = 0;
		}
		if((WarnningCounter[WARNING_BAT_VOLTAGE_LOW] >= 6000) && (WarnningFlag[WARNING_BAT_VOLTAGE_LOW] == 1))
		{
			WarnningCounter[WARNING_BAT_VOLTAGE_LOW] = 10000;
			HCESPN.H706 = 1;
		}

		if(WarnningFlag[WARNING_BRAKE_OIL_PRESSURE_LOW] == 1)
			WarnningCounter[WARNING_BRAKE_OIL_PRESSURE_LOW]++;
		else
		{
			WarnningCounter[WARNING_BRAKE_OIL_PRESSURE_LOW] = 0;
			HCESPN.H504 = 0;
		}
		if((WarnningCounter[WARNING_BRAKE_OIL_PRESSURE_LOW] >= 6000) && (WarnningFlag[WARNING_BRAKE_OIL_PRESSURE_LOW] == 1))
		{
			WarnningCounter[WARNING_BRAKE_OIL_PRESSURE_LOW] = 10000;
			HCESPN.H504 = 1;
		}		
    
		if(WarnningFlag[WARNING_ENGINE_COOLANT_TEMP] == 1)
			WarnningCounter[WARNING_ENGINE_COOLANT_TEMP]++;
		else  
		{
			WarnningCounter[WARNING_ENGINE_COOLANT_TEMP] = 0;
			HCESPN.H305 = 0;
		}  
		if((WarnningCounter[WARNING_ENGINE_COOLANT_TEMP] >= 6000) && (WarnningFlag[WARNING_ENGINE_COOLANT_TEMP] == 1))
		{
			WarnningCounter[WARNING_ENGINE_COOLANT_TEMP] = 10000;
			HCESPN.H305 = 1;
		}        
		

		if(WarnningFlag[WARNING_ENGINE_OIL_PRESSURE_LOW] == 1)
			WarnningCounter[WARNING_ENGINE_OIL_PRESSURE_LOW]++;
		else
		{
			WarnningCounter[WARNING_ENGINE_OIL_PRESSURE_LOW] = 0;
			HCESPN.H313 = 0;
		}
		if((WarnningCounter[WARNING_ENGINE_OIL_PRESSURE_LOW] >= 6000) && (WarnningFlag[WARNING_ENGINE_OIL_PRESSURE_LOW] == 1))
		{
			WarnningCounter[WARNING_ENGINE_OIL_PRESSURE_LOW] = 10000;
			HCESPN.H313 = 1;
		}		

		if(WarnningFlag[WARNING_TRANSMISSION_OIL_TEMP] == 1)
			WarnningCounter[WARNING_TRANSMISSION_OIL_TEMP]++;
		else
		{
			WarnningCounter[WARNING_TRANSMISSION_OIL_TEMP] = 0;
			HCESPN.H537 = 0;
		}
		if((WarnningCounter[WARNING_TRANSMISSION_OIL_TEMP] >= 6000) && (WarnningFlag[WARNING_TRANSMISSION_OIL_TEMP] == 1)) //++,--, 201214 ysm, MOBILE (6000->1)
		{
			WarnningCounter[WARNING_TRANSMISSION_OIL_TEMP] = 10000;
			HCESPN.H537 = 1;
		}
	

		if(WarnningFlag[WARNING_ENGINE_CHECK] == 1)
			WarnningCounter[WARNING_ENGINE_CHECK]++;
		else
		{
			WarnningCounter[WARNING_ENGINE_CHECK] = 0;
			HCESPN.H320 = 0;
		}		

		if((WarnningCounter[WARNING_ENGINE_CHECK] >= 6000) && (WarnningFlag[WARNING_ENGINE_CHECK] == 1))
		{
			WarnningCounter[WARNING_ENGINE_CHECK] = 10000;
			HCESPN.H320 = 1;
		}	
	}
	

	if(WarnningFlag[WARNING_FUEL_LEVEL_LOW] == 1)
		WarnningCounter[WARNING_FUEL_LEVEL_LOW]++;
	else
	{
		WarnningCounter[WARNING_FUEL_LEVEL_LOW] = 0;
		HCESPN.H303 = 0;
	}		
	if((WarnningCounter[WARNING_FUEL_LEVEL_LOW] >= 1) && (WarnningFlag[WARNING_FUEL_LEVEL_LOW] == 1))
	{
		WarnningCounter[WARNING_FUEL_LEVEL_LOW] = 10000;
		HCESPN.H303 = 1;
	}
	
	if(WarnningFlag[WARNING_AIR_CLEANER_CLOG] == 1)
		WarnningCounter[WARNING_AIR_CLEANER_CLOG]++;
	else
	{
		WarnningCounter[WARNING_AIR_CLEANER_CLOG] = 0;
		HCESPN.H317 = 0;
	}		
	if((WarnningCounter[WARNING_AIR_CLEANER_CLOG] >= 1) && (WarnningFlag[WARNING_AIR_CLEANER_CLOG] == 1))
	{
		WarnningCounter[WARNING_AIR_CLEANER_CLOG] = 10000;
		HCESPN.H317 = 1;
	}
	
	if(WarnningFlag[WARNING_WATER_IN_FUEL] == 1)
