void Calculate_Led(void)
{
	unsigned char i;

	for (i= 9;  i !=0; i--)
	{
		Led_SIG_TEMP[i] = Led_SIG_TEMP[i -1];
	}

	Led_SIG_TEMP[0]  = 0;

	if((Led_SIG_TEMP[9] == Led_SIG_TEMP[8]) && (Led_SIG_TEMP[8] == Led_SIG_TEMP[1]) && (Led_SIG_TEMP[1] == Led_SIG_TEMP[0])) 
	{
		Symbol_state = Led_SIG_TEMP[0];
	}

	Led_SIG_TEMP[0] += (Flag_DIN[INDEX_TURN_SIGNAL_LH])?(L_LEFT_TURN_SINGAL_INDICATOR):(0x00);		// 1
	Led_SIG_TEMP[0] += (Flag_DIN[INDEX_TURN_SIGNAL_RH])?(L_RIGHT_TURN_SIGNAL_INDICATOR):(0x00);		// 2
	Led_SIG_TEMP[0] += (Parking_Lamp_System())?(L_PARKING_SIGNAL):(0x00);				// 3
	
    if(Tab_Number == 0x04)		
       Led_SIG_TEMP[0] += (RX_JIG_DATA_65292.LED_1==1)?(L_FUEL_WARM_UP):(0x00);					// 4           
	else if((Engine_Type == LPG_TYPE)||((InfoModel1.ModelInfo >= MODEL_35D_9S)&&(InfoModel1.ModelInfo <= MODEL_50D_9S))	)
    {
       Led_SIG_TEMP[0] += 0x00;
    }
	else
		Led_SIG_TEMP[0] += (Flag_DIN[INDEX_FUEL_WARMER_SIG])?(L_FUEL_WARM_UP):(0x00);				// 4
		
	Led_SIG_TEMP[0] += (Fuel_LampSystem())?(L_LOW_FUEL):(0x00);										// 5
	Led_SIG_TEMP[0] += (Regeneration_LampSystem())?(L_REGENERATION):(0x00);							// 12		ok
	Led_SIG_TEMP[0] += (Regeneration_Inhibit_Lamp_LampSystem())?(L_REGENERATION_INHIBIT):(0x00);	// 13		ok

	Led_SIG_TEMP[0] += (TM_Oil_Temp_LampSystem())?(L_TM_OVERHEAT):(0x00);							// 6
	Led_SIG_TEMP[0] += (Engine_Check_LampSystem())?(L_ENGINE_CHECK):(0x00);							// 7			ok
	Led_SIG_TEMP[0] += (HEST_LampSystem())?(L_HEST):(0x00);											// 14		ok
	Led_SIG_TEMP[0] += (OPSS_Status==1)?(L_OPSS_OPERATION):(0x00);									// 15
	
	Led_SIG_TEMP[0] += (Engine_Coolant_Overheat_LampSystem())?(L_EG_COOLANT_OVERHEAT):(0x00);		// 8			ok
	
	Led_SIG_TEMP[0] += (Air_Filter_Warning_LampSystem())?(L_AIRCLEANER_FILTER):(0x00);			// 9
	Led_SIG_TEMP[0] += (Engine_Warm_Up_LampSystem())?(L_ENGINE_WARM_UP):(0x00);						// 16		ok
	Led_SIG_TEMP[0] += (Brake_Oil_Pressure_LampSystem())?(L_BRAKE_OIL):(0x00);						// 17

	//++, 201123 ysm, ENG_OIL
	#if 0
	Led_SIG_TEMP[0] += (Flag_DIN[INDEX_ENG_OIL_PRESSURE_SW])?(L_EG_OIL_PRESSURE):(0x00);			// 10
	#else
	Led_SIG_TEMP[0] += (Engine_Oil_Pressure_LampSystem())?(L_EG_OIL_PRESSURE):(0x00);	

	#endif
	//--, 201123 ysm, ENG_OIL
	// Engine Stop : Hyundai ?”ì§„???†ìŒ 
	//Led_SIG_TEMP[0] += (Engine_Stop_LampSystem())?(L_ENGINE_STOP):(0x00);							// 11
        
    // ++, 210904 ctw Auto JIG Final Test
	#if 1          
    if(Tab_Number == 0x04)
            Led_SIG_TEMP[0] += (RX_JIG_DATA_65292.LED_17==1)?(L_MAINTENANCE_CHECK):(0x00);						// 7			ok
    else
            Led_SIG_TEMP[0] += (Check_maintenance_Alarm==1)?(L_MAINTENANCE_CHECK):(0x00);						// 7			ok
	#else
    Led_SIG_TEMP[0] += (Check_maintenance_Alarm==1)?(L_MAINTENANCE_CHECK):(0x00);						// 7			ok
	#endif
    // --, 210904 ctw Auto JIG Final Test
        
	Led_SIG_TEMP[0] += (Water_In_Fuel_LampSystem())?(L_WATER_IN_FUEL):(0x00);						// 18		ok
	Led_SIG_TEMP[0] += (Battery_Low_LampSystem())?(L_BATTERY_CHARGE):(0x00);							// 19

	if((Led_SIG_TEMP[9] == Led_SIG_TEMP[8]) && (Led_SIG_TEMP[8] == Led_SIG_TEMP[1]) && (Led_SIG_TEMP[1] == Led_SIG_TEMP[0])) 
	{
		Symbol_state = Led_SIG_TEMP[0];
	}

	Check_Warnning_Data();
}


void ControlLCDBrightnessLevel(unsigned char nLevel)
{
	unsigned short BrightLevel[BRIGHTNESS_MAX+1] = {150, 165, 180, 195, 210, 225, 240, 255};

	LED_ON_OFF(0x0e, BrightLevel[nLevel]);
}


void ControlLEDBrightnessLevel(unsigned char nLevel)
{
	unsigned short BrightLevel[BRIGHTNESS_MAX+1] = {150, 165, 180, 195, 210, 225, 240, 255};

	for(UCHAR i=0x07;i<0x0e;i++)
	{
		LED_ON_OFF(i, BrightLevel[nLevel]);
	}
}


