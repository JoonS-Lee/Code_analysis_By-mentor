unsigned char Brake_Oil_Pressure_LampSystem(void)
{

	unsigned char brake_oil_level_flag;
	
	if(Flag_DIN[INDEX_BRAKE_OIL_LEVEL] == 1)
	{
		Brake_Oil_Level_Low_Count++;
	}
	else
	{
		Brake_Oil_Level_Low_Count = 0;
	}

	if(Tab_Number == 0x04)
	{
		if(Brake_Oil_Level_Low_Count >= 1)
		{
			Brake_Oil_Level_Low_Count = 1;
			brake_oil_level_flag = 1;
		}
		else
		{
			brake_oil_level_flag = 0;
		}

	}
	else
	{
		if(Brake_Oil_Level_Low_Count >= 6000)
		{
			Brake_Oil_Level_Low_Count = 10000;
			brake_oil_level_flag = 1;
		}
		else
		{
			brake_oil_level_flag = 0;
		}
	}
	
	WarnningFlag[WARNING_BRAKE_OIL_PRESSURE_LOW] = brake_oil_level_flag;

	//++, 221227 ysm, BRAKE_OIL
	if(((InfoModel1.ModelInfo >= MODEL_25D_9VS)&&(InfoModel1.ModelInfo <= MODEL_35DN_9VS))||(InfoModel1.ModelInfo <= MODEL_35DN_9VB)
		||((InfoModel1.ModelInfo >= MODEL_25LC_9)&&(InfoModel1.ModelInfo <= MODEL_33LC_9))||((InfoModel1.ModelInfo >= MODEL_25L_9A)&&(InfoModel1.ModelInfo <= MODEL_35LN_9A)))
	{
		BUZZER_FLAG.BrakeOilLevel = brake_oil_level_flag;

		if(BUZZER_FLAG.BrakeOilLevel == 0)
			BrakeOilLevelLow_BuzzerStop = 0;
	}
	else
	{
		BUZZER_FLAG.BrakeOilLevel = 0;
		BrakeOilLevelLow_BuzzerStop = 0;
	}
	//--, 221227 ysm, BRAKE_OIL


	return brake_oil_level_flag;

}


unsigned char Water_In_Fuel_LampSystem(void)
{
	unsigned char Water_In_Fuel_flag;

	if((InfoModel1.ModelInfo >= MODEL_35D_9S)&&(InfoModel1.ModelInfo <= MODEL_50D_9S))
	{
	
		if(WIF_Level_rowdata < 1000)
		{
			Water_In_Fuel_flag = 1;
		}
		else
			Water_In_Fuel_flag = 0;
	}
	else
	{

		if((InfoModel1.ModelInfo >= MODEL_25D_9HDI)&&(InfoModel1.ModelInfo <= MODEL_50DN_9HDI))
		{

			if((HDI_WIF_Warning_Count_Fmi14>= 1)||(HDI_WIF_Warning_Count_Fmi23>= 1))
			{
				Water_In_Fuel_flag=1;
			}
			else
				Water_In_Fuel_flag=0;
			
		}
		else
		{
			if(RX_ECU_DATA_65279.WaterInFuelINdicator_97 < 0x02)
				Water_In_Fuel_flag = RX_ECU_DATA_65279.WaterInFuelINdicator_97;
			else
				Water_In_Fuel_flag=0;
		}

	}

	WarnningFlag[WARNING_WATER_IN_FUEL] = Signal_WIF_lamp = Water_In_Fuel_flag;
	
	return Water_In_Fuel_flag;
}

