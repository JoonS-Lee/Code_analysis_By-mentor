// 100ms
unsigned char Parking_Lamp_System(void)
{
	unsigned char Parking_Flag;

	//++, 221013 ysm, FSCU_2
	#if 0
	Parking_Flag = Flag_DIN[INDEX_PARKING_PRESSURE_SW];
	#else
	if(COUNT_FLAG.Flag_FSCU_Enable == 1)
	{
		if(RX_FSCU_DATA_65525.Parking_Symbol_Demand < 0x03) 	
			Parking_Flag = 	((RX_FSCU_DATA_65525.Parking_Symbol_Demand == 0x01) ? 0x01 : 0x00);
		else 
			Parking_Flag = 0;		
	}
	else
		Parking_Flag = Flag_DIN[INDEX_PARKING_PRESSURE_SW];
	#endif
	//--, 221013 ysm, FSCU_2
	return Parking_Flag;

}

unsigned short LPG_Fuel_Low_Cnt=0;
unsigned char LPG_Fuel_Low_Flag=0;
unsigned char Fuel_LampSystem(void)
{
	unsigned char Fuel_flag, fuel_state;
	static unsigned short Fuel_Low_delay_cnt=0;
	unsigned short fuel_low_cnt;

	if(Engine_Type == DIESEL_TYPE)
	{
		fuel_low_cnt = 400;	
		
		if(HCESPN.Fuel_Level == 0)
			fuel_state = 1;
		else
			fuel_state = 0;
		
	}
	else
	{
		//++, 210419 ysm, FUEL LOW LAMP TEST
		#if 0
		fuel_low_cnt = 1000;
		#else
		fuel_low_cnt = 500; //++,--, 210427 ysm, FUEL LOW
		#endif
		//--, 210419 ysm, FUEL LOW LAMP TEST
		if(Flag_DIN[INDEX_FUEL_EMPTY_SIG]==1)
		{
			fuel_state = 1;
		}
		else
		{			
			fuel_state = 0;
		}
	}

	if(fuel_state == 1)      
	{
		if(++Fuel_Low_delay_cnt< fuel_low_cnt)
			Fuel_flag = 0;
		else
		{
			Fuel_Low_delay_cnt= (fuel_low_cnt+100);
			Fuel_flag = 1;

			if(Engine_Type == LPG_TYPE)
			{
				LPG_Fuel_Low_Flag = 1;
				LPG_Fuel_Low_Cnt = 0;

			}
		}
	}
	else
	{
		if(Engine_Type == LPG_TYPE)
		{
			if(LPG_Fuel_Low_Flag == 1)
			{
				if(++LPG_Fuel_Low_Cnt > 1000)
				{
					LPG_Fuel_Low_Flag = 0;
					LPG_Fuel_Low_Cnt = 0;
					Fuel_flag = 0;
					Fuel_Low_delay_cnt = 0;
				}
				else
				{
					Fuel_flag = 1;

				}
					
			}
			else
			{
				LPG_Fuel_Low_Flag = 0;
				LPG_Fuel_Low_Cnt = 0;
				Fuel_flag = 0;
				Fuel_Low_delay_cnt = 0;

			}
		
		}
		else
		{
			Fuel_flag = 0;
			Fuel_Low_delay_cnt = 0;

		}

	}

	WarnningFlag[WARNING_FUEL_LEVEL_LOW] = Fuel_flag;

	//++, 210902 ysm, RMS
	if(Engine_Type == LPG_TYPE)
	{
		if(Fuel_flag == 1)
			HCESPN.H301 = 0; // 0 %
		else
			HCESPN.H301 = 100; // 100 %
	}
	//--, 210902 ysm, RMS
	return Fuel_flag;
}

void CheckRegenerationLamp(void)
{
	if(gRegeneration_Status==1) // slow blinking	// 1000ms on, 1000ms off
	{
		gRegeneration_Blinking_Cnt++;
		if(gRegeneration_Blinking_Cnt < 100)
			gRegeneration_Blinking_Disp = 1;
		else if(gRegeneration_Blinking_Cnt < 200)
			gRegeneration_Blinking_Disp = 0;
		else
		{
			gRegeneration_Blinking_Cnt = 0;
			gRegeneration_Blinking_Disp = 0;
		}
	}
	else
	{
		gRegeneration_Blinking_Cnt=0;
		gRegeneration_Blinking_Disp=0;
	}
}

unsigned char Regeneration_LampSystem(void)
{
	unsigned char Regeneration_Lamp_flag;
	// 2 : 1000(ON) -> 1000(OFF) -> 1000(ON) -> 1000(OFF)
	// 1 : ON
	// 0 : OFF
	if(RX_ECU_DATA_64890.DPF_Regen_Request_Lamp_Status_3805 < 0x03)
		Regeneration_Lamp_flag = RX_ECU_DATA_64890.DPF_Regen_Request_Lamp_Status_3805 ;
	else
		Regeneration_Lamp_flag=0;

	if(Regeneration_Lamp_flag == 2)
	{
		gRegeneration_Status = 1;
		CheckRegenerationLamp();
		Regeneration_Lamp_flag = gRegeneration_Blinking_Disp;
	}
	else
	{
		gRegeneration_Status = gRegeneration_Blinking_Cnt = gRegeneration_Blinking_Disp = 0;
	}

	return Regeneration_Lamp_flag;

}

