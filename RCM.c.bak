unsigned char Machine_Model = 0;

unsigned short B2L2 (unsigned short value)
{
	unsigned short data;

	data = value;
	return data;
}

unsigned int B2L4 (unsigned int value)
{
	unsigned int data;
	
	data = value;
	return data;
}
void B2L2_(unsigned short value, unsigned char *data)
{
	data[0] = (value >> 0) & 0xff;
	data[1] = (value >> 8) & 0xff;
}

void B2L4_(unsigned int value, unsigned char *data)
{
	data[0] = (value >> 0) & 0xff;
	data[1] = (value >> 8) & 0xff;
	data[2] = (value >> 16) & 0xff;
	data[3] = (value >> 24) & 0xff;
}


void SatelliteCommInitial3(void)
{
	unsigned char TempData[160];	

	if(RCM3_Init_Flag == 1)
	{

		/*
		for(int i=0; i<11; i++)
		{
			HCESPN.H1292[i] = 0;
		}	

		for(int i=0; i<7; i++)
		{
			HCESPN.H1262[i] = 0;
		}	*/
		
		memset((unsigned char *)(&HCESPN.H1292), 0, 11);
		memset((unsigned char *)(&HCESPN.H1262), 0, 7);
		memset((unsigned char *)(&CoolantTempDistribution2_Total), 0, 4 * 12);

		HCESPN.H1621 = HCESPN_H1621_pre = 3;
		Wireless_Error_cnt = 6000;

		memset(TempData, 0, 120);
		read_Remote3PacketData_0x09((struct st_Remote3PacketData_0x09 *)TempData);

		HCESPN.H1603 = 12;

		//++, 220726 ysm, FAN_FINAL
		Last_H304_Data = 0xff;
		Last_H536_Data = 0xff;
		//--, 220726 ysm, FAN_FINAL

		Last_Daily_Reprot_Send_Time[0] = 0;
		Last_Daily_Reprot_Send_Time[1] = 1;
		Last_Daily_Reprot_Send_Time[2] = 1;
		Last_Daily_Reprot_Send_Time[3] = 0;
		Last_Daily_Reprot_Send_Time[4] = 0;
		Last_Daily_Reprot_Send_Time[5] = 0;

		Daily_Report_Send_Count_PowerOff = 0;

		HCESPN.H1402 = 0;
	}
	else
	{
		
		EepromRead(ADDRESS_RCM_H1262, (unsigned char*)(&TempData[0]), 7);
		memcpy((unsigned char *)(&HCESPN.H1262[0]), TempData, 7);	

		EepromRead(ADDRESS_RCM_H1292, (unsigned char*)(&TempData[0]), 11);
		memcpy((unsigned char *)(&HCESPN.H1292[0]), TempData, 11);
		
		EepromRead(ADDRESS_RCM_COOLANTTEMPDISTRIBUTION2_Total, (unsigned char*)(&TempData[0]), 32);	
		memcpy((unsigned char *)(&CoolantTempDistribution2_Total[0]), TempData, 32);

		EepromRead(ADDRESS_RCM_COOLANTTEMPDISTRIBUTION2_Total+32, (unsigned char*)(&TempData[0]), 16);
		memcpy((unsigned char *)(&CoolantTempDistribution2_Total[8]), TempData, 16);
		
		EepromRead(ADDRESS_H1621, (unsigned char*)(&TempData[0]), 1);
		HCESPN.H1621 = HCESPN_H1621_pre = TempData[0];
		
		if (HCESPN.H1621 > 3)
		{
			HCESPN.H1621 = HCESPN_H1621_pre = 3;
		}
		
		if(HCESPN.H1621 < 4)
		{
			Wireless_Error_cnt = 6000;	  //	20150623	WireLess Data Comm. Error Mobile
		}
	

		#if 1
		EepromRead(ADDRESS_RCM3_DAILYREPORT_DATA + ((unsigned short)DailyReport_Index * 128), TempData, 117); //++	190609	ECO Report 131 + 6 -> 137 Mobile	//--		
		#else
		EepromRead(ADDRESS_RCM3_DAILYREPORT_DATA + (unsigned short)(DailyReport_Index)*160, &TempData[0], 32);
		EepromRead(ADDRESS_RCM3_DAILYREPORT_DATA + 32 + (unsigned short)(DailyReport_Index)*160, &TempData[32], 32);
		EepromRead(ADDRESS_RCM3_DAILYREPORT_DATA + 64 + (unsigned short)(DailyReport_Index)*160, &TempData[64], 32);
		EepromRead(ADDRESS_RCM3_DAILYREPORT_DATA + 96 + (unsigned short)(DailyReport_Index)*160, &TempData[96], 21);
		#endif
		read_Remote3PacketData_0x09((struct st_Remote3PacketData_0x09 *)TempData);
		
				
		EepromRead(ADDRESS_H1603, (unsigned char*)(&TempData[0]), 1);
		HCESPN.H1603 = TempData[0];

		EepromRead(ADDRESS_LAST_DAILYREPORT_SEND_TIME, (unsigned char*)(&TempData[0]), 6);
		Last_Daily_Reprot_Send_Time[0] = TempData[0];
		Last_Daily_Reprot_Send_Time[1] = TempData[1];
		Last_Daily_Reprot_Send_Time[2] = TempData[2];
		Last_Daily_Reprot_Send_Time[3] = TempData[3];
		Last_Daily_Reprot_Send_Time[4] = TempData[4];
		Last_Daily_Reprot_Send_Time[5] = TempData[5];

		EepromRead(ADDRESS_DAILYREPORT_SEND_COUNT_POWEROFF, &Daily_Report_Send_Count_PowerOff, 1);
		
		EepromRead(ADDRESS_RCM_H1402, (unsigned char*)(&TempData[0]), 1);
		memcpy((unsigned char *)(&(HCESPN.H1402)), TempData, 1);

		//++, 220726 ysm, FAN_FINAL
		EepromRead(ADDRESS_RCM3_LAST_H304, (unsigned char*)(&TempData[0]), 1);
		Last_H304_Data = TempData[0];
		
		EepromRead(ADDRESS_RCM3_LAST_H536, (unsigned char*)(&TempData[0]), 1);
		Last_H536_Data = TempData[0];
		//--, 220726 ysm, FAN_FINAL 		

	}	

	H1623_No_Change_Count = 0;	

	RCM3_Send_Flag = 0;		
	RCM3_Ack_Status = 0;
	RCM3_Ack_Flag = 0;
	RCM3_StartCounter = 0;
	RCM3_Counter = 0;	

	RCM3_Timeout2_Occur = 0;
	RCM3_Timeout2_Check_Count = 0;
	RCM3_TimeoutS_Check_Count = 0;
	RCM3_Timeout1_Check_Count = 0;
	
	H1600_Scheduled_Data = 0;
	H1600_Scheduled_Flag = 0;
	RCM3_DailyReport_Index_Gap = 0;
	BD_Receive_Count3 = 0;
	RCM3_DailyReport_Count = 0;

	H852_Error_Count = 0;

	RCM3_0x41_Send_Flag = 0;
	RCM3_0x71_Send_Flag = 0;
	RCM3_0x75_0x76_Send_Flag = 0;	

	DailyReport_Send_Flag = 0;
	RMCU_CID_OK = 0;	
	Flag_Key_On = 0;
	RCM_Poweroff_Counter = 0;
	RCM3_Center_Command = 0;

	Daily_Report_Send_flag_PowerOff = 0;

	Machine_Security_Command = 0xff;
	
}

void FuelInitial(void)
{
	unsigned char i;
	
	for (i = 8; i >= 1; i--)
	{
              if (FuelRemain == FuelFactor[Machine_Model][i])
		{
			Fuel_Remain_Seg = i;
			return;
		}
	}

	Fuel_Remain_Seg = 0;
}



void SatelliteCommInitial(void)
{

	unsigned char i;	
	unsigned char TempData[48];
	unsigned int TempIntData[16];
	unsigned short TempShortData[8];	

	unsigned char Data1[4];	
	
	First_SDP_Process=0;
	DateChangeCount=0;	
	DateChange_SDP_Process = 0;
	RTC_Calibration_Count = 0xffffffff;
	EngineRunTimeCounter=0;
	First_ERTL=0;
	First_FL=0;
	FuelUsed_FL = 0.;
	FL_Count=0;
	FuelReadCount = 0;
	FuelSum = 0;
	Fuel_Seg_before=0;
	FuelEqualCount = 0;
	Fuel_OK_Seg=0;
	first_after_keyon_cal_fuel = 0;
	Fuel_OK_Seg_Before = 0;
	FuelOsc = 0;
	FuelInitial();

	First_OTL=0;
	ADDistance =0;
	
	for(i=0; i<8; i++)	
		ADActualGear[i] = 0;
	for(i=0; i<3; i++)	
		ADEnginePowerMode[i] =0;
	for(i=0; i<6; i++)
		ADFanSpeed[i] =0; 
	
	ADActualGearShift_Status=0;
	ADActualGearShift_Count =0;
	Weight_Temp = 0;
	Weight_Temp_Flag =0;
	

	RCMData_MaintenanceChange = 0;
	RCMData_MaintenanceItem = 0;
	RCMData_UserPasswordChange = 0;
	RCMData_ESLPasswordChange = 0;
	RCMData_ESLStatusChange = 0;
	RCMData_CallMachineSecurity = 0;
	RCMData_ServicePasswordChange = 0;
	
	LHO_Setting_Send_Status=0;
	RCM_Test_Step_Status = 0;	

	RCM_Test_Code_Data[0] = 0;
	RCM_Test_Code_Data[1] = 0;
	RCM_Test_Code_Data[2] = 0;

	Data1[0] = 0x55;
	Data1[1] = 0xbb;
	Data1[2] = 0x0c;
	Data1[3] = 0xc0;

	EepromRead(ADDRESS_RCM3_START, (unsigned char*)(&TempData[0]), 4);
	
	if ((memcmp(TempData, Data1, 4)) == 0)
	{		
		RCM3_Init_Flag = 0;
		
	}
	else
	{
		RCM3_Init_Flag = 1;
	}	

	if(RCM3_Init_Flag == 1)
	{

		for(int i = 0; i<32; i++)
			TempData[i] = 0;

		
		for(int i = 0 ; i < 15 ; i++) // 400 BYTES
		{
			EepromWrite(ADDRESS_RCM_START+i*32,  &TempData[0], 32);
		}
		
		for(int i = 0 ; i < 33 ; i++) // 800 BYTES
		{
			EepromWrite(ADDRESS_RCM3_START+i*32,  &TempData[0], 32);
		}

		
		TimeDelay_msec(5);
            
	}	

	memset(HCESPN.H952, 0x00, sizeof(HCESPN.H952));
	memset(HCESPN.H953, 0x00, sizeof(HCESPN.H953));
	//memset(HCESPN.H954, 0x00, sizeof(HCESPN.H954));
	//memset(HCESPN.H955, 0x00, sizeof(HCESPN.H955));
	memset(HCESPN.H961, 0x00, sizeof(HCESPN.H961));	
	memset(HCESPN.H975, 0x00, sizeof(HCESPN.H975));
	memset(HCESPN.H960, 0x00, sizeof(HCESPN.H960));		
	memset(HCESPN.H1586, 0x00, sizeof(HCESPN.H1586));
	
	HCESPN.Fuel_Level = 0;
	Fuel_Seg = 0;	
	

	HCESPN.H310_rpm = 0;
	SPN.H2880 = 0;

	HCESPN.Step_Status = 0x0a;
	
	EepromRead(ADDRESS_H951, (unsigned char*)(&TempData[0]), 1);

	if((TempData[0] > 200)||(TempData[0] < 1))
	{
		TempData[0] = 118;

	}
	HCESPN.H951 = TempData[0];

	
	EepromRead(ADDRESS_RCM_COMM_ERROR, (unsigned char*)(&TempData[0]), 6);
	memcpy((unsigned char *)(&TempShortData[0]), TempData, 6);

	HCESPN.H1551 = TempShortData[0];
	HCESPN.H1552 = TempShortData[1];
	HCESPN.H1555 = TempShortData[2];
	
		
		
	EepromRead(ADDRESS_RCM_DAILYREPORT_SEND_STATUS, &DailyReport_Send_Status, 1);
	EepromRead(ADDRESS_RCM_DAILYREPORT_INDEX, &DailyReport_Index, 1);

	//EepromRead(ADDRESS_RCM_DAILYREPORT_DATE + DailyReport_Index * 3, (unsigned char*)(&TempData[0]), 3);
	
	EepromRead(ADDRESS_RCM_DAILYREPORT_DATE + DailyReport_Index * 3, TempData, 3);
	memcpy((unsigned char *)(&DailyReport_Date), TempData, 3);

	

	EepromRead(ADDRESS_RCM_H1270 + 0 * 32, (unsigned char*)(&TempData[0]), 32);
	memcpy((unsigned char *)(&TempIntData[0]), TempData, 32);

	EepromRead(ADDRESS_RCM_H1270 + 1 * 32, (unsigned char*)(&TempData[0]), 32);
	memcpy((unsigned char *)(&TempIntData[8]), TempData, 32);	

	for (i = 0; i < 11; i++)
		HCESPN.H1270[i] = TempIntData[i];	
	

	EepromRead(ADDRESS_RCM_H1286 + 0 * 32, (unsigned char*)(&TempData[0]), 32);
	memcpy((unsigned char *)(&TempIntData[0]), TempData, 32);

	EepromRead(ADDRESS_RCM_H1286 + 1 * 32, (unsigned char*)(&TempData[0]), 32);
	memcpy((unsigned char *)(&TempIntData[8]), TempData, 32);
		
	for (i = 0; i < 16; i++)
		HCESPN.H1286[i] = TempIntData[i];
	

	EepromRead(ADDRESS_RCM_H1331, (unsigned char*)(&TempData[0]), 6);
	memcpy((unsigned char *)(&(HCESPN.H1331[0])), TempData, 6);		

	EepromRead(ADDRESS_RCM_H1341, (unsigned char*)(&TempData[0]), 6);
	memcpy((unsigned char *)(&(HCESPN.H1341[0])), TempData, 6);

		
	EepromRead(ADDRESS_RCM_TMOILTEMPDISTRIBUTION, (unsigned char*)(&TempData[0]), 32);
	memcpy((unsigned char *)(&TMTempDistribution[0]), TempData, 32);

	EepromRead(ADDRESS_RCM_H1332, (unsigned char*)(&TempData[0]), 6);
	memcpy((unsigned char *)(&(HCESPN.H1332[0])), TempData, 6);		

    
	EepromRead(ADDRESS_RCM_H1545, (unsigned char*)(&TempData[0]), 1);
	memcpy((unsigned char *)(&(HCESPN.H1545)), TempData, 1);	

	EepromRead(ADDRESS_RCM_H1546, (unsigned char*)(&TempData[0]), 1);
	memcpy((unsigned char *)(&(HCESPN.H1546)), TempData, 1);	

	EepromRead(ADDRESS_RCM_H1548, (unsigned char*)(&TempData[0]), 1);
	memcpy((unsigned char *)(&(HCESPN.H1548)), TempData, 1);	

	EepromRead(ADDRESS_RCM_H1551, (unsigned char*)(&TempShortData[0]), 2);
	HCESPN.H1551=TempShortData[0];

	EepromRead(ADDRESS_RCM_H1552, (unsigned char*)(&TempShortData[0]), 2);
	HCESPN.H1552=TempShortData[0];	

	EepromRead(ADDRESS_RCM_H1553, (unsigned char*)(&TempShortData[0]), 2);
	HCESPN.H1553=TempShortData[0];	

	EepromRead(ADDRESS_RCM_H1555, (unsigned char*)(&TempShortData[0]), 2);
	HCESPN.H1555=TempShortData[0];	

	EepromRead(ADDRESS_RCM_H1556, (unsigned char*)(&TempShortData[0]), 2);
	HCESPN.H1556=TempShortData[0];


	if (HCESPN.H1331[0] > 0xfa)
		HCESPN.H1331[0] = 0;

	if (HCESPN.H1332[0] > 0xfa)
		HCESPN.H1332[0] = 0;

	if (HCESPN.H1341[0] > 0xfa)
		HCESPN.H1341[0] = 0;

	EepromRead(ADDRESS_WARNING_FAULT_TODAY + 0, (unsigned char*)(&TempData[0]), 6);

	RCMData_WarmingCount_Today_Send = TempData[0];
	RCMData_ECMFaultCount_Today_Send = TempData[2];

	RCMData_WarmingCount_Today = TempData[3];
	RCMData_ECMFaultCount_Today = TempData[5];
    
	if (RCMData_WarmingCount_Today_Send > 5)
		RCMData_WarmingCount_Today_Send = 0;


	if (RCMData_ECMFaultCount_Today_Send > 5)
		RCMData_ECMFaultCount_Today_Send = 0;
		
	if (RCMData_WarmingCount_Today > 5)
		RCMData_WarmingCount_Today = 0;

	if (RCMData_ECMFaultCount_Today > 5)
		RCMData_ECMFaultCount_Today = 0;


	EepromRead(ADDRESS_WARNING_FAULT_TODAY + 16, (unsigned char*)(&TempData[0]), 10);
	memcpy((unsigned char *)(&RCMData_WarmingHCESPN_Today[0]), TempData, 10);

	EepromRead(ADDRESS_WARNING_FAULT_TODAY + 48, &RCMData_ECMFault_Today[0][0], 15);

	EepromRead(ADDRESS_WARNING_FAULT_TODAY2, (unsigned char*)(&TempData[0]), 2);
	RCMData_TCUFaultCount_Today_Send = TempData[0];
	RCMData_TCUFaultCount_Today = TempData[1];

	if (RCMData_TCUFaultCount_Today_Send > 5)
		RCMData_TCUFaultCount_Today_Send = 0;
	if (RCMData_TCUFaultCount_Today > 5)
		RCMData_TCUFaultCount_Today = 0;


	EepromRead(ADDRESS_WARNING_FAULT_TODAY2 + 3, &RCMData_TCUFault_Today[0][0], 15);

	EepromRead(ADDRESS_RCM_H854, (unsigned char*)(&TempData[0]), 8);
	memcpy(&(HCESPN.H854[0]), TempData, 8);

	EepromRead(ADDRESS_RCM_H822, (unsigned char*)(&TempData[0]), 3);
	HCESPN.H822 = TempData[0];
	HCESPN.H823 = HCESPN.H823_ = TempData[1];
	HCESPN.H824 = TempData[2];

	EepromRead(ADDRESS_LHO_SETTING_POSITION, LHO_Setting_Position, 8);

	EepromRead(ADDRESS_RCM_FUEL_CONSUMPTION, (unsigned char*)(&TempData[0]), 4);
	memcpy((unsigned char *)(&TempShortData[0]), TempData, 4);

	FuelRemain = TempShortData[0];
	FuelConsumption = TempShortData[1];   

	if ((DailyReport_Send_Status != 0) && ((DailyReport_Send_Status % 2) == 0))
		DailyReport_Send_Status--;
	
	Flag_RMCU_PBI=0;

	HCESPN.H1699 = 1;
	HCESPN.H1700 = 1;

	HCESPN.H1414 = 0xffff;
}


unsigned char SatelliteCommRun_Poweroff(void)
{

	st_DATA_RTC TempRTC1, TempRTC2;
	unsigned int TimeGap;
	unsigned char Sign;

	TempRTC1.Year = Last_Daily_Reprot_Send_Time[0];
	TempRTC1.Month = Last_Daily_Reprot_Send_Time[1];
	TempRTC1.Date = Last_Daily_Reprot_Send_Time[2];
	TempRTC1.Hours = Last_Daily_Reprot_Send_Time[3];
	TempRTC1.Minutes = Last_Daily_Reprot_Send_Time[4];
	TempRTC1.Seconds = Last_Daily_Reprot_Send_Time[5];

	TempRTC2.Year = HCESPN.H941[0];
	TempRTC2.Month = HCESPN.H941[1];
	TempRTC2.Date = HCESPN.H941[2];
	TempRTC2.Hours = HCESPN.H941[3];
	TempRTC2.Minutes = HCESPN.H941[4];
	TempRTC2.Seconds = HCESPN.H941[5];
	

	CalculateTimeGap(&TempRTC1, &TempRTC2, 1800, 0, &TimeGap, &Sign);

	if ((HCESPN.H1621 < 4) && (HCESPN.H941[3] >= 16) && (Daily_Report_Send_Count_PowerOff < 2) && (Sign == 1))
	{
		Daily_Report_Send_flag_PowerOff = 1;

		if (++RCM_Poweroff_Counter >= 100)
		{
			RCM_Poweroff_Counter = 200;
		}

		if (RCM_Poweroff_Counter == 1)
		{
			DailyReport_Send_Flag = 1;
			RCM3_DailyReport_Index_Gap = 0;

			HCESPN.H1598 = 0x01;
			HCESPN.H1600 = 0x09;
			RCM3_Send_Flag = 1;				

			HCESPN.H1401[0] = HCESPN.H941[3];
			HCESPN.H1401[1] = HCESPN.H941[4];
			HCESPN.H1401[2] = HCESPN.H941[5];

			Satellite_TransmitData3();

		}

		if (DailyReport_Send_Flag != 0)
		{
			if (RCM_Poweroff_Counter == 50)
			{
				DailyReport_Send_Flag = 1;
				RCM3_DailyReport_Index_Gap = 0;
				
				HCESPN.H1598 = 0x01;
				HCESPN.H1600 = 0x09;
				RCM3_Send_Flag = 1; 	

				HCESPN.H1401[0] = HCESPN.H941[3];
				HCESPN.H1401[1] = HCESPN.H941[4];
				HCESPN.H1401[2] = HCESPN.H941[5];

				Satellite_TransmitData3();

			}
		}
		else // 키오프시 송신 2회 체크 
		{
			if (++Daily_Report_Send_Count_PowerOff >= 2)
			{
				Daily_Report_Send_Count_PowerOff = 2;
			}

			return 1;
		}

		if (RCM_Poweroff_Counter == 70)
		{
			if (++Daily_Report_Send_Count_PowerOff >= 2)
			{
				Daily_Report_Send_Count_PowerOff = 2;
			}

			return 1;
		}
		else
		{
			return 0;
		}
	}
	else
	{
		return 1;
	}


}




void SatelliteCommEnd3(void)
{
	unsigned char Data1[4];	
	unsigned char TempData[160];	//++	190609	ECO Report 131 + 6 -> 137 Mobile	//--

	Data1[0] = 0x55;
	Data1[1] = 0xbb;
	Data1[2] = 0x0c;
	Data1[3] = 0xc0;

	if(RCM3_Init_Flag == 1)
	{				
		EepromWrite(ADDRESS_RCM3_START, Data1, 4); 		
		
	}

	HCESPN.H1401[0] = HCESPN.H941[3];
	HCESPN.H1401[1] = HCESPN.H941[4];
	HCESPN.H1401[2] = HCESPN.H941[5];

	if (RTC_Calibration_Count <= 0xfaffffff)
	{
		RTC_TEMP_DATA = Calculate_RTC_Offset(&RTC_Calibration_Data, RTC_Calibration_Count, 0);
		write_RTC(&RTC_TEMP_DATA);	
	}	

	memcpy(TempData, (unsigned char *)(&HCESPN.H1262[0]), 7);
	EepromWrite(ADDRESS_RCM_H1262, TempData, 7); 	
	
	memcpy(TempData, (unsigned char *)(&HCESPN.H1292[0]), 11);	
	EepromWrite(ADDRESS_RCM_H1292, TempData, 11); 

	memcpy(TempData, (unsigned char *)(&CoolantTempDistribution2_Total[0]), 32);
	EepromWrite(ADDRESS_RCM_COOLANTTEMPDISTRIBUTION2_Total, TempData, 32); 

	memcpy(TempData, (unsigned char *)(&CoolantTempDistribution2_Total[8]), 16);
	EepromWrite(ADDRESS_RCM_COOLANTTEMPDISTRIBUTION2_Total + 32, TempData, 16); 

	TempData[0] = HCESPN.H1621;	
	EepromWrite(ADDRESS_H1621, TempData, 1); 

	make_Remote3PacketData_0x09((struct st_Remote3PacketData_0x09 * )TempData);		

	#if 0
	EepromWrite(ADDRESS_RCM3_DAILYREPORT_DATA + (unsigned short)(DailyReport_Index) * 160, TempData, 117);
	#else
	EepromWrite(ADDRESS_RCM3_DAILYREPORT_DATA + (unsigned short)(DailyReport_Index) * 128, &TempData[0], 32);
	EepromWrite(ADDRESS_RCM3_DAILYREPORT_DATA + 32 + (unsigned short)(DailyReport_Index) * 128, &TempData[32], 32);
	EepromWrite(ADDRESS_RCM3_DAILYREPORT_DATA + 64 + (unsigned short)(DailyReport_Index) * 128, &TempData[64], 32);
	EepromWrite(ADDRESS_RCM3_DAILYREPORT_DATA + 96 + (unsigned short)(DailyReport_Index) * 128, &TempData[96], 21);
	#endif

	TempData[0] = HCESPN.H1603;

	EepromWrite(ADDRESS_H1603, TempData, 1); 
	EepromWrite(ADDRESS_LAST_DAILYREPORT_SEND_TIME, Last_Daily_Reprot_Send_Time, 6);
	EepromWrite(ADDRESS_DAILYREPORT_SEND_COUNT_POWEROFF, &Daily_Report_Send_Count_PowerOff, 1);

	memcpy(TempData, (unsigned char *)(&(HCESPN.H1402)), 1);
	EepromWrite(ADDRESS_RCM_H1402, TempData, 1); 
	
	Daily_Report_Send_flag_PowerOff = 0;

	//++, 220726 ysm, FAN_FINAL
	Last_H304_Data = HCESPN.H304_Coolant_temp;
	Last_H536_Data = HCESPN.TM_Oil_Temp;;	

	TempData[0] = Last_H304_Data;
	EepromWrite(ADDRESS_RCM3_LAST_H304, TempData, 1); 

	TempData[0] = Last_H536_Data;
	EepromWrite(ADDRESS_RCM3_LAST_H536, TempData, 1); 
	//--, 220726 ysm, FAN_FINAL
	
}


