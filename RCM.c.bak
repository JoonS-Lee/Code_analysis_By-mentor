			break;			

		case 43 :

			if(strlen(TempString[2]) >= 5)
			{
			
				HCESPN.H822 = 2;
				strcpy(HCESPN.H952, TempString[2]);
				Lock_Packet_Reason = 0;
				History_Machine_Lock_Change();
			}	
			else			// 굴삭기 와 다름 ...By Yim J.H
				return 2;
			break;

		case 61 :
			HCESPN.H820 = 0;			
			ESL.Mode = 0;	
			Lock_Packet_Reason = 4;
			break;

		case 62 :
			strcpy(HCESPN.H955, "00000");
			Lock_Packet_Reason = 4;
			History_User_Password_Change();
			break;

		default :
			Lock_Packet_Reason = 0;			
			break;
	}		

	return 0;
}
#endif


//++, 200902 ysm, MOBILE
void Event_RMCU_Change(void)		// 20110125
{

	if ((Last_RMCU_Change_Data1[0] != HCESPN.H1580)
		|| (Last_RMCU_Change_Data1[1] != HCESPN.H1581)
		|| (Last_RMCU_Change_Data1[2] != HCESPN.H1582)
		|| (Last_RMCU_Change_Data1[3] != HCESPN.H1583)
		|| (Last_RMCU_Change_Data1[4] != HCESPN.H1583_sub)	//	20151026	RMCU Sub version 추가.
		|| (strcmp(Last_RMCU_Change_Data2, HCESPN.H1586) != 0)
		|| (strcmp(Last_RMCU_Change_Data3, HCESPN.H1585) != 0))
	{
		Old_RMCU_Change_Data1[0] = Last_RMCU_Change_Data1[0];
		Old_RMCU_Change_Data1[1] = Last_RMCU_Change_Data1[1];
		Old_RMCU_Change_Data1[2] = Last_RMCU_Change_Data1[2];
		Old_RMCU_Change_Data1[3] = Last_RMCU_Change_Data1[3];
		Old_RMCU_Change_Data1[4] = Last_RMCU_Change_Data1[4]; 	//	20151026	RMCU Sub version 추가.

		strcpy(Old_RMCU_Change_Data2, Last_RMCU_Change_Data2);
		strcpy(Old_RMCU_Change_Data3, Last_RMCU_Change_Data3);

		Last_RMCU_Change_Data1[0] = HCESPN.H1580;
		Last_RMCU_Change_Data1[1] = HCESPN.H1581;
		Last_RMCU_Change_Data1[2] = HCESPN.H1582;
		Last_RMCU_Change_Data1[3] = HCESPN.H1583;
		Last_RMCU_Change_Data1[4] = HCESPN.H1583_sub;	//	20151026	RMCU Sub version 추가.

		strcpy(Last_RMCU_Change_Data2, HCESPN.H1586);
		strcpy(Last_RMCU_Change_Data3, HCESPN.H1585);

		RMCU_Change_Event_On = 1;
	}
}

void check_Comm_Remote_Frame3_CAN_Ack(void)
{
	RCM3_Ack_Status = 0;
	RCM3_Timeout1_Check_Count = 0;

	if ((DailyReport_Send_Status != 0) && ((DailyReport_Send_Status % 2) == 0))
	{
		DailyReport_Send_Status++;
	}
}



void check_Remote3PacketData_0x83(unsigned char size, struct st_Remote3PacketData_0x83 *src)
{
	unsigned char i;
	//unsigned char LHO_Result;
	st_DATA_RTC Temp_RTC;

	HCESPN.H1621 = src->H1621;

	for (i = 0; i < 6; i++)
	{
		HCESPN.H853[i] = src->H853[i];
	}

	HCESPN.H864 = src->H864;

	for (i = 0; i < 8; i++)
	{
		HCESPN.H854[i] = src->H854[i];
	}

	HCESPN.H862 = (unsigned short)(src->H862[1] * 256) + (unsigned short)(src->H862[0]);
	HCESPN.H863 = src->H863;
	HCESPN.H1570 = src->H1570;
	HCESPN.H855 = src->H855;
	HCESPN.H1590 = src->H1590;
	HCESPN.H1592 = src->H1592;
	HCESPN.H1594 = src->H1594;
	HCESPN.H1593 = src->H1593;
	HCESPN.H852 = src->H852;
	HCESPN.H1595 = src->H1595;
	HCESPN.H1568 = src->H1568;
	HCESPN.H1569 = src->H1569;

	for (i = 0; i < 6; i++)
	{
		HCESPN.H859[i] = src->H859[i];
	}

	HCESPN.H1622 = src->H1622;
	HCESPN.H865  = HCESPN.H1622;        //JHY
	HCESPN.H1623 = src->H1623;
	HCESPN.H1624 = src->H1624;
	HCESPN.H1625 = src->H1625;

	if(src->H1625)
	{
		HCESPN.H1596 = 0;    //JHY
	}
	else
	{
		HCESPN.H1596 = 1;    //JHY
	}

	HCESPN.H1626 = src->H1626;
	HCESPN.H1591 = src->H1626;                //JHY

	HCESPN.H1627 = src->H1627;
	HCESPN.H1628 = src->H1628;


	if (HCESPN.H852 == 0)
	{
		if (++H852_Error_Count == 10)
		{
			if (HCESPN.H1555 < 64255)
			{
				HCESPN.H1555++;
			}
		}
		else if (H852_Error_Count >= 10)
		{
			H852_Error_Count = 11;
		}
	}
	else
	{
		H852_Error_Count = 0;
	}

	#if 0
	if (HCESPN.H852 == 1)
	{
		if (RCM_Test_Step_Status >= 0x34)
		{
			if (LHOAutoSetting(LHO_Setting_Position, HCESPN.H854, &LHO_Result))
			{
				memcpy(LHO_Setting_Position, HCESPN.H854, 8);

				HCESPN.H951 = LHO_Result;

				if (HCESPN.H864 != LHO_Result)
				{
					LHO_Setting_Send_Status = 1;
				}
			}
		}
	}
	#endif

	if (HCESPN.H852 == 1)
	{

	  	if ( (HCESPN.H853[0] != 0) && (HCESPN.H853[0] != 0xff) &&           
			 (HCESPN.H853[1] != 0) && (HCESPN.H853[1] <= 12) &&
			 (HCESPN.H853[2] != 0) && (HCESPN.H853[2] <= 31) &&
			 (HCESPN.H853[3] <= 23) &&
			 (HCESPN.H853[4] <= 59) &&
			 (HCESPN.H853[5] <= 59) )
		{
	
			RTC_Calibration_Count = 0;
			
			Temp_RTC.Year = HCESPN.H853[0];
			Temp_RTC.Month = HCESPN.H853[1];
			Temp_RTC.Date = HCESPN.H853[2];
			Temp_RTC.Hours = HCESPN.H853[3];
			Temp_RTC.Minutes = HCESPN.H853[4];
			Temp_RTC.Seconds = HCESPN.H853[5];

			RTC_Calibration_Data = Calculate_RTC_LHO_Applied(&Temp_RTC, HCESPN.H864, 1);
		}
	}
}

void check_RMCU_Time(unsigned char select)
{
	//unsigned char LHO_Result;
	st_DATA_RTC Temp_RTC;

	//	20150623	Check GPS Error H852 10분간 0 수신시 (H1555++)
	if((select == 0) && (RMCU_CID_OK == 1))
	{
		if (HCESPN.H852 == 0)
		{
			if (++H852_Error_Count == 600)
			{
				if (HCESPN.H1555 < 64255)
				{
					HCESPN.H1555++;
				}
			}
			else if (H852_Error_Count >= 600)
			{
				H852_Error_Count = 601;
			}
		}
		else
		{
			H852_Error_Count = 0;
		}


		if (H1623_No_Change_Count != 0xffff)
		{
			if (HCESPN.H1623 == 1 )
			{
				H1623_No_Change_Count = 0;
			}
		}
	}
	else if(select == 1)
	{
		if( (HCESPN.H854[0] <= 99) && (HCESPN.H854[4] <= 99) &&
			(HCESPN.H854[1] <= 59) && (HCESPN.H854[5] <= 59) &&
			((HCESPN.H854[2] & 0x7f) <= 59) &&
			((HCESPN.H854[6] & 0x7f) <= 59) &&
			(HCESPN.H854[3] <= 90) && (HCESPN.H854[7] <= 180) )
		{		
			#if 0
			if (HCESPN.H852 == 1)
			{
				if (RCM_Test_Step_Status >= 0x34)
				{
					if (LHOAutoSetting(LHO_Setting_Position, HCESPN.H854, &LHO_Result))
					{
						memcpy(LHO_Setting_Position, HCESPN.H854, 8);

						HCESPN.H951 = LHO_Result;

						if (HCESPN.H864 != LHO_Result)
						{
							LHO_Setting_Send_Status = 1;
						}
					}
				}
			}
			#endif
		}
	}
	else if(select == 2)	//	20150410
	{
		if( (HCESPN.H853[0] != 0) && (HCESPN.H853[0] != 0xff) &&
			(HCESPN.H853[1] != 0) && (HCESPN.H853[1] <= 12) &&
			(HCESPN.H853[2] != 0) && (HCESPN.H853[2] <= 31) &&
			(HCESPN.H853[3] <= 23) &&
			(HCESPN.H853[4] <= 59) &&
			(HCESPN.H853[5] <= 59) )
		{

			if (HCESPN.H852 == 1)
			{
				RTC_Calibration_Count = 0;
				
				Temp_RTC.Year = HCESPN.H853[0];
				Temp_RTC.Month = HCESPN.H853[1];
				Temp_RTC.Date = HCESPN.H853[2];
				Temp_RTC.Hours = HCESPN.H853[3];
				Temp_RTC.Minutes = HCESPN.H853[4];
				Temp_RTC.Seconds = HCESPN.H853[5];

				RTC_Calibration_Data = Calculate_RTC_LHO_Applied(&Temp_RTC, HCESPN.H864, 1);
			}
		}
	}
}

unsigned char check_Comm_Remote_Frame3(unsigned char size, unsigned char *src)
{
	unsigned char i,index;

	switch (src[0])
	{
		case 0x00 :
			if (src[1] == 0x83)
			{
				check_Remote3PacketData_0x83(src[6] - 2, (struct st_Remote3PacketData_0x83 *)&src[2]);

				HCESPN.H1545 = 0;

				if (BD_Receive_Count3 < 3)
				{
					BD_Receive_Count3++;
				}
			}

			break;

		case 0x02 :
			RCM3_Ack_Status = 0;
			RCM3_Timeout1_Check_Count = 0;

			if ((DailyReport_Send_Status != 0) && ((DailyReport_Send_Status % 2) == 0))
			{
				DailyReport_Send_Status++;
			}

			break;

		case 0x03 :
			switch (src[1])
			{
				case 0xcc :
					//H1600_Scheduled_Data = 0x08;
					DailyReport_Send_Flag = 1;
					RCM3_DailyReport_Index_Gap = 0;
					break;

				case 0x0f :
					//H1600_Scheduled_Data = 0x08;
					DailyReport_Send_Flag = 1;
					RCM3_DailyReport_Index_Gap = 0;
					HCESPN.H1603 = src[2];
					RCM3_DailyReport_Count = 0;
					break;

				case 0xb1 :
				case 0xb2 :
				case 0xb3 :
				case 0xb4 :
				case 0xb5 :
					//H1600_Scheduled_Data = 0x08;
					DailyReport_Send_Flag = 1;
					RCM3_DailyReport_Index_Gap = src[1] - 0xb0;
					break;

				case 0xcf :	//	Active Warning/DTC Message

					H1600_Scheduled_Data = 0x29;
			
					RCM3_Center_Command = 1;	//	20150226 RCM3_Center_Command
					break;	

					
				case 0xd5 :
					//H1600_Scheduled_Data = 0xd5; //Machine Security

					if((src[2] == 0)||(src[2] == 42)||(src[2] == 61)||(src[2] == 62))
						Machine_Security_Command = src[2];
					else
						Machine_Security_Command = 0xff;

					index = 0;
						
					if(Machine_Security_Command == 0)
					{
						RCMData_CallMachineSecurity = 1;

					}
					else if(Machine_Security_Command == 42)
					{
						for(i=0; i<11; i++)
						{
							HCESPN.H954_[i] = 0xff;
						}					

						for(i=0; i<10; i++)
						{	
							if(src[4+i] == 0x2A)
							{
								break;
							}							
							else
							{
								if((src[4+i] < 0x30)||(src[4+i] > 0x39))
								{
									index = 0;
									break;
								}
								else
								{
									HCESPN.H954_[i] = src[4+i];
									index++;

								}		
							}
						}		
						if((index >= 5)&&(index <= 10))
						{
							Change_MasterPassword();
							RCMData_ServicePasswordChange = 1;
						}
					}
					else if(Machine_Security_Command == 61)
					{
						Flag_ESL = 0;
						InfoModel2.ESL_Status = INACTIVE;
						InfoModel2.ESL_Set_Status = INACTIVE;
						ESL_Setting();
					}
					else if(Machine_Security_Command == 62)
					{

						Reset_UserPassword();
					}
					
					break;
					
				case 0xd7 :	//	Local Time Setting
					HCESPN.H951 = src[2];
					H1600_Scheduled_Data = 0xd7;
					break;

				case 0xd9 :
					H1600_Scheduled_Data = 0xd0; //D4->D0
					break;
				
				default :

					H1600_Scheduled_Data = src[1];

					break;
			}

			RCM3_Ack_Flag = 1;

			break;

		case 0x05 :
			
			RCM_Test_Step_Status  = src[1];
			RCM_Test_Code_Data[0] = src[2];
			RCM_Test_Code_Data[1] = src[3];
			RCM_Test_Code_Data[2] = src[4];

			switch(RCM_Test_Step_Status)
			{
				case '0':
				case '1':
				case '2':
				case '3':
				case '4':
				case '5':	COUNT_FLAG.Flag_RMCU_Set = 1; break; // 통신 개통 필요(STEP 0~5)
				case 'A':	COUNT_FLAG.Flag_RMCU_Set = 2; break; // 통신 개통 완료(STEP A)
				default: 	COUNT_FLAG.Flag_RMCU_Set = 0; break;

			}			
			break;
	
		default :
			break;
	}

	return 0;
}
