	memcpy(TempData, (unsigned char *)(&HCESPN.H1332[0]), 6);	
	EepromWrite(ADDRESS_RCM_H1332, TempData, 6);	

	
	memcpy(TempData, (unsigned char *)(&HCESPN.H1341[0]), 6);
	EepromWrite(ADDRESS_RCM_H1341, TempData, 6);


	
	memcpy(TempData, (unsigned char *)(&HCESPN.H1545), 1);
	EepromWrite(ADDRESS_RCM_H1545, TempData, 1);	

	memcpy(TempData, (unsigned char *)(&HCESPN.H1546), 1);	
	EepromWrite(ADDRESS_RCM_H1546, TempData, 1);

	memcpy(TempData, (unsigned char *)(&HCESPN.H1548), 1);
	EepromWrite(ADDRESS_RCM_H1548, TempData, 1);


	TempShortData[0] =HCESPN.H1551;
	EepromWrite(ADDRESS_RCM_H1551, (unsigned char *)(&TempShortData[0]), 2);

	TempShortData[0] =HCESPN.H1552; 
	EepromWrite(ADDRESS_RCM_H1552, (unsigned char *)(&TempShortData[0]), 2);
	
	TempShortData[0] =HCESPN.H1553; 
	EepromWrite(ADDRESS_RCM_H1553, (unsigned char *)(&TempShortData[0]), 2);	

	TempShortData[0] =HCESPN.H1555; 
	EepromWrite(ADDRESS_RCM_H1555, (unsigned char *)(&TempShortData[0]), 2);

	TempShortData[0] =HCESPN.H1556; 
	EepromWrite(ADDRESS_RCM_H1556, (unsigned char *)(&TempShortData[0]), 2);

	TempData[0] = RCMData_WarmingCount_Today_Send;
	TempData[2] = RCMData_ECMFaultCount_Today_Send;

	TempData[3] = RCMData_WarmingCount_Today;
	TempData[5] = RCMData_ECMFaultCount_Today;

	
	EepromWrite(ADDRESS_WARNING_FAULT_TODAY + 0, TempData, 6);

	memcpy(TempData, (unsigned char *)(&RCMData_WarmingHCESPN_Today[0]), 10);
	EepromWrite(ADDRESS_WARNING_FAULT_TODAY + 16, TempData, 10);

	EepromWrite(ADDRESS_WARNING_FAULT_TODAY + 48, &RCMData_ECMFault_Today[0][0], 15);

	TempData[0] = RCMData_TCUFaultCount_Today_Send;
	TempData[1] = RCMData_TCUFaultCount_Today;
	TempData[2]= 0xff;

	EepromWrite(ADDRESS_WARNING_FAULT_TODAY2, &TempData[0], 3);
	EepromWrite(ADDRESS_WARNING_FAULT_TODAY2 + 3, &RCMData_TCUFault_Today[0][0], 15);
	
	memcpy(TempData, &(HCESPN.H854[0]), 8);
	EepromWrite(ADDRESS_RCM_H854, TempData, 8);
	
	TempData[0] = HCESPN.H822;
	TempData[1] = HCESPN.H823_;
	TempData[2] = HCESPN.H824;
		
	EepromWrite(ADDRESS_RCM_H822, TempData, 3);

	EepromWrite(ADDRESS_LHO_SETTING_POSITION, LHO_Setting_Position, 8);

	TempShortData[0] = FuelRemain;
	TempShortData[1] = FuelConsumption;

	memcpy(TempData, (unsigned char *)(&TempShortData[0]), 4);
	EepromWrite(ADDRESS_RCM_FUEL_CONSUMPTION, TempData, 4);

	memcpy(TempData, (unsigned char *)(&HCESPN.H951), 1);		
	EepromWrite(ADDRESS_H951, TempData, 1);


}



void History_Machine_Lock_Change(void)
{
	unsigned char i;

	for (i = 20; i >= 7; i--)
	{
		HCESPN.H1460[i] = HCESPN.H1460[i - 7];
	}

	for (i = 0; i < 5; i++)
	{
		HCESPN.H1460[i] = HCESPN.H941[i];
	}

	HCESPN.H1460[5] = (HCESPN.H823_ << 4) + (HCESPN.H822 << 2) + 0x03;
	HCESPN.H1460[6] = 0xf0 + HCESPN.H824;
}

void add_log_message_52(void)
{
	unsigned char i;		

	for (i = 59; i >= 6; i--)
		HCESPN.H1521[i] = HCESPN.H1521[i - 6];

	HCESPN.H1521[0] = 52;
	HCESPN.H1521[1] = HCESPN.H941[0];
	HCESPN.H1521[2] = HCESPN.H941[1];
	HCESPN.H1521[3] = HCESPN.H941[2];
	HCESPN.H1521[4] = HCESPN.H941[3];
	HCESPN.H1521[5] = HCESPN.H941[4];

	if (HCESPN.H1520 < 250)
		HCESPN.H1520++;
}

//++, 200902 ysm, MOBILE
unsigned char Check_Password(char *Input_Password)
{
	unsigned char WordSize;
	unsigned char i;

	WordSize = strlen(Input_Password);

	if (WordSize < 5)
	{
		return 0;
	}

	if (WordSize > 10)
	{
		return 0;
	}

	for (i = 0; i < WordSize; i++)
	{
		if ((Input_Password[i] != '#') && ((Input_Password[i] < '0') || (Input_Password[i] > '9')))
		{
			return 0;
		}
	}

	return 1;
}


void SatelliteCommRun3(void)
{
	st_DATA_RTC TempRTC1, TempRTC2;
	unsigned int TimeGap;
	unsigned char Sign;

	if((COUNT_FLAG.Flag_RMCU_Check == 1)&&(COUNT_FLAG.Flag_RMCU_Set== 1))
		RMCU_EQUIPMENT = 1;
	else
		RMCU_EQUIPMENT = 0;
	
	
	if (++RCM3_StartCounter >= 300)
	{
		RCM3_StartCounter = 300;

		if (++RCM3_Counter >= 36000)
		{
			RCM3_Counter = 0;
		}

		//	20150623	Check RMCU TimeoutS 90초 동안 CID 미수신시(H1551++, H1545++(if A.L == on))
		if ( !RMCU_CID_OK)
		{
			//++	200204	Chage HCESPN.H1551(RMCU TimeoutS) Counter Condition
			if(RCM3_TimeoutS_Check_Count < 1000)
			{
				RCM3_TimeoutS_Check_Count++;
			}
			//--	200204	Chage HCESPN.H1551(RMCU TimeoutS) Counter Condition
			if( RCM3_TimeoutS_Check_Count == 900 )//++	200204	Chage HCESPN.H1551(RMCU TimeoutS) Counter Condition	>= -> == //--
			{
				RCM3_TimeoutS_Check_Count = 910;	

				if (HCESPN.H1551 < 64255)
				{
					HCESPN.H1551++;
				}
				
				if (HCESPN.H822 == 1)
				{
					if (HCESPN.H1545 < 250)
					{
						HCESPN.H1545++;
					}

					if (HCESPN.H1545 >= 3)
					{
						HCESPN.H1545 = 0;
						HCESPN.H823_ = 1;
						HCESPN.H824 = 1;
						History_Machine_Lock_Change();
						add_log_message_52();
					}
				}
				
			}
		}

		//++	180818	//	20150623	Check RMCU Timeout2 90초 동안 메시지 미수신시(H1553++)
		if(RMCU_CID_OK == 1)
		{

			//MCU FAULT DATA 없음
			#if 1
			if(COUNT_FLAG.Flag_RMCUCommError == 1 )
			{
				if( RCM3_Timeout2_Occur == 0)
				{
				  	RCM3_Timeout2_Check_Count = 910;
					RCM3_Timeout2_Occur = 1;

					if (HCESPN.H1553 < 64255)
					{
						HCESPN.H1553++;
					}
				}
			}
			#endif

			//	20150623	WireLess Data Comm. Error Mobile
			if(HCESPN.H1621 != HCESPN_H1621_pre)
			{
				if(HCESPN.H1621 < 4)
				{
					Wireless_Error_cnt = 6000;
				}

				HCESPN_H1621_pre = HCESPN.H1621;
			}

			if (H1623_No_Change_Count < Wireless_Error_cnt)
			{
				H1623_No_Change_Count++;
			}
			else if (H1623_No_Change_Count == Wireless_Error_cnt)
			{
				H1623_No_Change_Count = 0xffff;

				if (HCESPN.H1556 < 64255)
				{
					HCESPN.H1556++;
				}

				if (HCESPN.H822 == 1)
				{
					if (HCESPN.H1546 < 250)
					{
						HCESPN.H1546++;
					}

					if (HCESPN.H1546 >= 3)
					{
						HCESPN.H823_ = 1;
						HCESPN.H824 = 1;
						History_Machine_Lock_Change();
						add_log_message_52();
					}
				}
			}//.	20150623	WireLess Data Comm. Error Mobile
		}

		if (RCM3_Ack_Flag)	//	Request Message
		{
			HCESPN.H1598 = 0x04;
			RCM3_Send_Flag = 3;			
			RCM3_Ack_Flag = 0;
		}
		else if (RCM3_Ack_Status)	//	20150623	Check RMCU Timeout1(H1552)
		{
			if(RMCU_CID_OK == 1)
			{
				if (((++RCM3_Timeout1_Check_Count) % 50) == 49)
				{
					if (RCM3_Timeout1_Check_Count < 201)
					{
						RCM3_Send_Flag = 1;
					}
					else
					{
						if (HCESPN.H1552 < 64255)
						{
							HCESPN.H1552++;
						}

						RCM3_Ack_Status = 0;
						RCM3_Timeout1_Check_Count = 0;
					}
				}
			}
		}
		else
		{
			if (!RCM3_Send_Flag)
			{
				if (H1600_Scheduled_Flag)
				{
					H1600_Scheduled_Flag = 0;
					HCESPN.H1600 = H1600_Scheduled_Data;
					H1600_Scheduled_Data = 0;
					RCM3_Send_Flag = 1;
					RCM3_Ack_Status = 1;
					RCM3_Timeout1_Check_Count = 0;
				}
			}

			if (!RCM3_Send_Flag)
			{
				if (DailyReport_Send_Flag == 1)
				{

					HCESPN.H1600 = 0x09;					

					RCM3_Send_Flag = 1;
					RCM3_Ack_Status = 1;
					RCM3_Timeout1_Check_Count = 0;

				}

			}

			if (!RCM3_Send_Flag)
			{
				if (RCMData_MaintenanceChange != 0)
				{
					if (RCMData_MaintenanceChange == 1)
					{
						HCESPN.H1600 = 0xda;	//	MAintenance Replacement
						RCM3_Send_Flag = 1;
						RCM3_Ack_Status = 1;
						RCM3_Timeout1_Check_Count = 0;
					}
					else if (RCMData_MaintenanceChange == 2)
					{
						HCESPN.H1600 = 0xdb;	//	Maintenance Interval Change
						RCM3_Send_Flag = 1;
						RCM3_Ack_Status = 1;
						RCM3_Timeout1_Check_Count = 0;
					}

					RCMData_MaintenanceChange = 0;
				}
			}
			
			if (!RCM3_Send_Flag)
			{
				if (RCMData_CallMachineSecurity != 0)
				{
					HCESPN.H1600 = 0xd5;	//Machine Security
					RCM3_Send_Flag = 1;
					RCM3_Ack_Status = 1;
					RCM3_Timeout1_Check_Count = 0;			
			
					Machine_Security_Command = 0;
			
					RCMData_CallMachineSecurity = 0;
				}
			}
			


			if (!RCM3_Send_Flag)
			{
				if (RCMData_UserPasswordChange != 0)
				{
					HCESPN.H1600 = 0xd5;	//Machine Security
					RCM3_Send_Flag = 1;
					RCM3_Ack_Status = 1;
					RCM3_Timeout1_Check_Count = 0;			

					Machine_Security_Command = 4;

					RCMData_UserPasswordChange = 0;
				}
			}

			if (!RCM3_Send_Flag)
			{
				if (RCMData_ESLStatusChange != 0)
				{
					HCESPN.H1600 = 0xd5;	//Machine Security
					RCM3_Send_Flag = 1;
					RCM3_Ack_Status = 1;
					RCM3_Timeout1_Check_Count = 0;			

					Machine_Security_Command = 4;

					RCMData_ESLStatusChange = 0;
				}
			}			

			if (!RCM3_Send_Flag)
			{
				if (RCMData_ServicePasswordChange != 0)
				{
					HCESPN.H1600 = 0xd5;	//Machine Security
					RCM3_Send_Flag = 1;
					RCM3_Ack_Status = 1;
					RCM3_Timeout1_Check_Count = 0;			
			
					Machine_Security_Command = 3;
			
					RCMData_ServicePasswordChange = 0;
				}
			}


			if ((HCESPN.H852 == 1) || (BD_Receive_Count3 >= 180))	//	20141120	BD_Receive_Count3
			{
				if (!RCM3_Send_Flag)
				{
					if (RCMData_WarmingCount_Today > RCMData_WarmingCount_Today_Send)
					{
						HCESPN.H1600 = 0x41;
						RCM3_Send_Flag = 1;
						RCM3_Ack_Status = 1;
						RCM3_Timeout1_Check_Count = 0;

						RCM3_0x41_Send_Flag = 1;
					}
				}

				if (!RCM3_Send_Flag)
				{
					if (RCMData_ECMFaultCount_Today > RCMData_ECMFaultCount_Today_Send)
					{
						HCESPN.H1600 = 0x71;
						RCM3_Send_Flag = 1;
						RCM3_Ack_Status = 1;
						RCM3_Timeout1_Check_Count = 0;

						RCM3_0x71_Send_Flag = 1;
					}
				}
		
				#if 0
				if (!RCM3_Send_Flag)
				{
					if (RCMData_TCUFaultCount_Today > RCMData_TCUFaultCount_Today_Send)
					{
						
						HCESPN.H1600 = 0x75;
						
						RCM3_Send_Flag = 1;
						RCM3_Ack_Status = 1;
						RCM3_Timeout1_Check_Count = 0;

						RCM3_0x75_0x76_Send_Flag = 1;	
					}
				}
				#endif
			}

			if (!RCM3_Send_Flag)
			{
				if (LHO_Setting_Send_Status == 1)
				{
					HCESPN.H1600 = 0xd7;
					RCM3_Send_Flag = 1;
					RCM3_Ack_Status = 1;
					RCM3_Timeout1_Check_Count = 0;

					LHO_Setting_Send_Status = 0;
				}
			}

			if (!RCM3_Send_Flag)
			{
				if (HCESPN.H1621 < 4)
				{
					if (DailyReport_Send_Status == 1)
					{
						HCESPN.H1600 = 0x09;
						RCM3_Send_Flag = 1;
						RCM3_Ack_Status = 1;
						RCM3_Timeout1_Check_Count = 0;
						RCM3_DailyReport_Index_Gap = 1;
						DailyReport_Send_Status = 2;
						DailyReport_Send_Flag = 1;
					}
					else if (DailyReport_Send_Status == 3)
					{
						HCESPN.H1600 = 0xe5;
						RCM3_Send_Flag = 1;
						RCM3_Ack_Status = 1;
						RCM3_Timeout1_Check_Count = 0;
						DailyReport_Send_Status = 4;
					}
					else if (DailyReport_Send_Status == 5)
					{
						HCESPN.H1600 = 0xe7;
						RCM3_Send_Flag = 1;
						RCM3_Ack_Status = 1;
						RCM3_Timeout1_Check_Count = 0;
						DailyReport_Send_Status = 6;
					}
					else if (DailyReport_Send_Status == 7)
					{
						HCESPN.H1600 = 0xe8;
						RCM3_Send_Flag = 1;
						RCM3_Ack_Status = 1;
						RCM3_Timeout1_Check_Count = 0;
						DailyReport_Send_Status = 8;
					}
					
				}
			}

			if(HCESPN.H1621 < 4)
			{
				if (!RCM3_Send_Flag)
				{
					if (((HCESPN.H941[3] == 10) || (HCESPN.H941[3] == 14) || (HCESPN.H941[3] == 18)) &&  //	20150824	RMS v5.0 적용. Daily Report 전송시간 18시 추가.
						(HCESPN.H941[4] == 0) && (HCESPN.H941[5] == 0))
					{
						if ((RCM3_Counter % 10) == 0)
						{
							HCESPN.H1600 = 0x09;
							RCM3_Send_Flag = 1;
                                                        
							RCM3_Ack_Status = 1;
							RCM3_Timeout1_Check_Count = 0;
							RCM3_DailyReport_Index_Gap = 0;
						}
					}
				}

				if (!RCM3_Send_Flag)	//	Active Warning / DTC Message
				{
					if (RCM3_Counter == 650)
					{
						if ((HCESPN.H1518 != 0) || (HCESPN.H1501 != 0) || (HCESPN.H1502 != 0) || (HCESPN.H1503 != 0) )
						{
							HCESPN.H1600 = 0x29;

							RCM3_Send_Flag = 1;
							RCM3_Ack_Status = 1;
							RCM3_Timeout1_Check_Count = 0;
						}
					}
				}		
			}

			if (HCESPN.H1621 < 4)
			{
				if (!RCM3_Send_Flag)
				{
					if ((RCM3_Counter % 6000) == 5900)
					{
						if (++RCM3_DailyReport_Count >= HCESPN.H1603)
						{
							RCM3_DailyReport_Count = 0;

							TempRTC1.Year = Last_Daily_Reprot_Send_Time[0];
							TempRTC1.Month = Last_Daily_Reprot_Send_Time[1];
							TempRTC1.Date = Last_Daily_Reprot_Send_Time[2];
							TempRTC1.Hours = Last_Daily_Reprot_Send_Time[3];
							TempRTC1.Minutes = Last_Daily_Reprot_Send_Time[4];
							TempRTC1.Seconds = Last_Daily_Reprot_Send_Time[5];

							TempRTC2.Year = HCESPN.H941[0];
							TempRTC2.Month = HCESPN.H941[1];
							TempRTC2.Date = HCESPN.H941[2];
							TempRTC2.Hours = HCESPN.H941[3];
							TempRTC2.Minutes = HCESPN.H941[4];
							TempRTC2.Seconds = HCESPN.H941[5];

							CalculateTimeGap(&TempRTC1, &TempRTC2, 1800, 0, &TimeGap, &Sign);

							if ((HCESPN.H1603 <= 3) || (Sign == 1))
							{
								//HCESPN.H1598 = 0x01;
								//HCESPN.H1600 = 0x08;
								DailyReport_Send_Flag = 1;
								RCM3_Ack_Status = 1;
								RCM3_Timeout1_Check_Count = 0;
								RCM3_DailyReport_Index_Gap = 0;
							}
						}
					}
				}
			}

			if (!RCM3_Send_Flag)
			{
				if ((RCM3_Counter % 600) == 5)
				{
					
					if(HCESPN.H1621 < 4)
					{
						HCESPN.H1600 = 0x09;
					}

					RCM3_Send_Flag = 2;
				}
			}
		}

		Satellite_TransmitData3();

		if (RCM3_0x41_Send_Flag)
		{
			RCMData_WarmingCount_Today_Send++;
			RCM3_0x41_Send_Flag = 0;
		}

		if (RCM3_0x71_Send_Flag)
		{
			RCMData_ECMFaultCount_Today_Send++;
			RCM3_0x71_Send_Flag = 0;
		}

		if (RCM3_0x75_0x76_Send_Flag)//++	191130	Change CVT Model TCU DTC RMS	//--	// 20120118
		{
			RCMData_TCUFaultCount_Today_Send++;
			RCM3_0x75_0x76_Send_Flag = 0;//++	191130	Change CVT Model TCU DTC RMS	//--
		}
		
	}
}

unsigned short make_RCM_Temp_Distribution_Total(struct st_RCM_Temp_Distribution *dst)
{

	unsigned char i;

	for (i = 0; i < 6; i++)
	{
		dst->H941[i] = HCESPN.H941[i];
	}

	dst->H941[0] |= 0x80;

	for (i = 0; i < 7; i++)
	{
		dst->H1261[i] = 0xff;//HCESPN.H1261[i]; //Hydraulic Oil Temperature Distribution %
	}

	for (i = 0; i < 11; i++)
	{
		dst->H1292[i] = HCESPN.H1292[i]; 
	}

	for (i = 0; i < 6; i++)
	{
		dst->H1331[i] = 0xff;//HCESPN.H1331[i]; //Hydraulic Oil Temperature (Date/Time)
	}

	dst->H1331[1] |= 0x80;

	for (i = 0; i < 6; i++)
	{
		dst->H1341[i] = HCESPN.H1341[i];
	}

	dst->H1341[1] |= 0x80;

	for (i = 0; i < 7; i++)
	{
		dst->H1262[i] = HCESPN.H1262[i];
	}

	for (i = 0; i < 6; i++)
	{
		//++, 210513 ysm, RMS
		#if 0
		if(i == 0)
		{
			if(HCESPN.H1332[i] == 0)
				HCESPN.H1332[i] = 0xff;
		}
		#endif		
		//--, 210513 ysm, RMS

		dst->H1332[i] = HCESPN.H1332[i];
		
	}

	dst->H1332[1] |= 0x80;

	return 49;
}

unsigned short make_Remote3PacketData_0x09(struct st_Remote3PacketData_0x09 *dst)
{
	unsigned char i;

	dst->H1603 = HCESPN.H1603;

	for (i = 0; i < 5; i++)
	{
		dst->H941[i] = HCESPN.H941[i];
	}

	B2L4_(HCESPN.H1601, dst->H1601);

	for (i = 0; i < 3; i++)
	{
		dst->H1400[i] = HCESPN.H1400[i];
	}

	for (i = 0; i < 3; i++)
	{
		dst->H1401[i] = HCESPN.H1401[i];
	}

	dst->H301 = HCESPN.H301;
	B2L2_(HCESPN.H302, dst->H302);	

	HCESPN.H1405 = HCESPN.H1403 = 0xFFFF; // 추후 구현
	
	B2L2_(HCESPN.H1405, dst->H1405);
	B2L2_(HCESPN.H1403, dst->H1403);

	dst->H1410[0] = (HCESPN.H1410_2 >> 0) & 0xff;
	dst->H1410[1] = (HCESPN.H1410_2 >> 8) & 0xff;
	dst->H1410[2] = (HCESPN.H1410_2 >> 16) & 0xff;

	dst->H1411[0] = (HCESPN.H1411_2 >> 0) & 0xff;
	dst->H1411[1] = (HCESPN.H1411_2 >> 8) & 0xff;
	dst->H1411[2] = (HCESPN.H1411_2 >> 16) & 0xff;

	dst->H1412[0] = (HCESPN.H1412_2 >> 0) & 0xff;
	dst->H1412[1] = (HCESPN.H1412_2 >> 8) & 0xff;
	dst->H1412[2] = (HCESPN.H1412_2 >> 16) & 0xff;

	dst->H1413[0] = (HCESPN.H1413_2 >> 0) & 0xff;
	dst->H1413[1] = (HCESPN.H1413_2 >> 8) & 0xff;
	dst->H1413[2] = (HCESPN.H1413_2 >> 16) & 0xff;

	for (i = 0; i < 6; i++)
	{
		dst->H1404[i] = HCESPN.H1404[i];
	}

	for (i = 0; i < 8; i++)
	{
		dst->H854[i] = HCESPN.H854[i];
	}

	dst->H951 = HCESPN.H951;
	dst->H820 = HCESPN.H820;  //WIP
	dst->H822 = HCESPN.H822;  //WIP 	
	dst->H823 = HCESPN.H823_; //WIP
	dst->H824 = HCESPN.H824; //WIP
	dst->dm0 = 0x0F;
	B2L2_(HCESPN.H1551, dst->H1551);
	B2L2_(HCESPN.H1552, dst->H1552);
	B2L2_(HCESPN.H1553, dst->H1553);
	B2L2_(HCESPN.H1555, dst->H1555);
	B2L2_(HCESPN.H1556, dst->H1556);
	dst->H1545 = HCESPN.H1545;
	dst->H1546 = HCESPN.H1546;
	dst->H1548 = HCESPN.H1548;
	dst->H1518 = HCESPN.H1518; //WIP
	dst->H1501 = HCESPN.H1501; //WIP
	dst->H1502 = HCESPN.H1502; //WIP
	dst->H1503 = HCESPN.H1503; //WIP
	dst->H101 = HCESPN.H101 = 0xFF;
	dst->H304 = HCESPN.H304_Coolant_temp;
	dst->H536 = HCESPN.TM_Oil_Temp;

	B2L2_(HCESPN.H1417, dst->H1417);

	for (i = 0; i < 14; i++)
	{
		dst->H1418[i] = HCESPN.H1418[i];
	}

	for (i = 0; i < 3; i++)
	{
		B2L2_(HCESPN.H1419[i], dst->H1419[i]);
	}

	for (i = 0; i < 6; i++)
	{
		HCESPN.H1422[i] = 0xffff; //Not Used
		B2L2_(HCESPN.H1422[i], dst->H1422[i]);
	}

	B2L4_(HCESPN.H1915, dst->H1915);
	dst->REV1 = 0xFF;
	dst->REV2 = 0xFF;
	dst->H1402 = HCESPN.H1402;

	HCESPN.H1414 = 0xffff;
	B2L2_(HCESPN.H1414, dst->H1414);
	
	dst->H575 = HCESPN.H575 = InfoModel2.SpeedLimitStatus;
	dst->dm1 = 0x3f;
	dst->H572 = HCESPN.H572 = InfoModel2.SpeedLimitValue;

	return 117;	
	
}

void read_Remote3PacketData_0x09(struct st_Remote3PacketData_0x09 *src)
{
	unsigned char i;

	HCESPN.H1603 = src->H1603;

	for (i = 0; i < 3; i++)
	{
		HCESPN.H1400[i] = src->H1400[i];
	}

	for (i = 0; i < 3; i++)
	{
		HCESPN.H1401[i] = src->H1401[i];
	}

	HCESPN.H1405 = (unsigned short)(src->H1405[1] * 256) + (unsigned short)(src->H1405[0]);
	HCESPN.H1403 = (unsigned short)(src->H1403[1] * 256) + (unsigned short)(src->H1403[0]);

	HCESPN.H1410_2 = ((unsigned int)(src->H1410[0]) << 0)
					 + ((unsigned int)(src->H1410[1]) << 8)
					 + ((unsigned int)(src->H1410[2]) << 16);

	HCESPN.H1411_2 = ((unsigned int)(src->H1411[0]) << 0)
					 + ((unsigned int)(src->H1411[1]) << 8)
					 + ((unsigned int)(src->H1411[2]) << 16);

	HCESPN.H1412_2 = ((unsigned int)(src->H1412[0]) << 0)
					 + ((unsigned int)(src->H1412[1]) << 8)
					 + ((unsigned int)(src->H1412[2]) << 16);

	HCESPN.H1413_2 = ((unsigned int)(src->H1413[0]) << 0)
					 + ((unsigned int)(src->H1413[1]) << 8)
					 + ((unsigned int)(src->H1413[2]) << 16);

	for (i = 0; i < 6; i++)
	{
		HCESPN.H1404[i] = src->H1404[i];
	}

	HCESPN.H1417 = (unsigned short)(src->H1417[1] * 256) + (unsigned short)(src->H1417[0]);

	for (i = 0; i < 14; i++)
	{
		HCESPN.H1418[i] = src->H1418[i];
	}

	for (i = 0; i < 3; i++)
	{
		HCESPN.H1419[i] = (unsigned short)(src->H1419[i][1] * 256) + (unsigned short)(src->H1419[i][0]);
	}


	for (i = 0; i < 6; i++)
	{
		HCESPN.H1422[i] = (unsigned short)(src->H1422[i][1] * 256) + (unsigned short)(src->H1422[i][0]);
	}

	HCESPN.H1915 = (unsigned int)(src->H1915[3] * 0xffffff)
				   + (unsigned int)(src->H1915[2] * 0xffff)
				   + (unsigned int)(src->H1915[1] * 0xff)
				   + (unsigned int)(src->H1915[0]);
	

}


void Satellite_TransmitData3(void)
{
	unsigned char SendData[512];
	unsigned short Index;
	unsigned int TempIntData;
	unsigned char i;
	unsigned char TempStrSize;
	unsigned char maintenance_index,maintenance_list_total;
		
	Index = 0;

	if( COUNT_FLAG.Comm_Error_RMCU > 10000)
	{
		RCM3_Send_Flag = 0;	//	190208 test
	}
		
	if (RCM3_Send_Flag == 1)
	{
		switch (HCESPN.H1600)
		{
			case 0x09 : // ENGINE FORKLIFT DAILY REPORT

				if (RCM3_DailyReport_Index_Gap == 0)
				{
					SendData[Index++] = HCESPN.H1598 = 1;
					SendData[Index++] = HCESPN.H1600;

					Index += make_Remote3PacketData_0x09((struct st_Remote3PacketData_0x09 *)&SendData[Index]);

				}			
				else
				{
					SendData[Index++] = HCESPN.H1598 = 1;
					SendData[Index++] = HCESPN.H1600;
					//++	190609	ECO Report 131 + 6 -> 137 Mobile			
					EepromRead(ADDRESS_RCM3_DAILYREPORT_DATA + ((DailyReport_Index + 6 - RCM3_DailyReport_Index_Gap) % 6) * 128, &SendData[Index], 117);
					Index += 117;
				}			
				SendData[Index - 116] |= 0x80;
					

				if (DailyReport_Send_Flag == 1)
				{
					DailyReport_Send_Flag = 0;

					Last_Daily_Reprot_Send_Time[0] = HCESPN.H941[0];
					Last_Daily_Reprot_Send_Time[1] = HCESPN.H941[1];
					Last_Daily_Reprot_Send_Time[2] = HCESPN.H941[2];
					Last_Daily_Reprot_Send_Time[3] = HCESPN.H941[3];
					Last_Daily_Reprot_Send_Time[4] = HCESPN.H941[4];
					Last_Daily_Reprot_Send_Time[5] = HCESPN.H941[5];
				}

				HCEPGN_61184_MSGT_250_Transmit_Data_Count = Index + 1;
				HCEPGN_61184_MSGT_250_Transmit_Data[0] = 250;
				memcpy((HCEPGN_61184_MSGT_250_Transmit_Data + 1), SendData, Index);
				HCEPGN_61184_MSGT_250_Transmit_Flag = 1;

				break;

			case 0x41 :	//	Warning
				SendData[Index++] = HCESPN.H1598 = 1;
				SendData[Index++] = HCESPN.H1600;

				memcpy((SendData + Index), (unsigned char *)(HCESPN.H941), 6);
				Index += 6;

				SendData[Index - 6] |= 0x80;

				TempIntData = B2L4(HCESPN.H1601);
				memcpy((SendData + Index), (unsigned char *)(&TempIntData), 4);
				Index += 4;

				memcpy((SendData + Index), (unsigned char *)(HCESPN.H854), 8);
				Index += 8;

				*(SendData + Index++) = (unsigned char)(RCMData_WarmingHCESPN_Today[RCMData_WarmingCount_Today_Send] % 256);
				*(SendData + Index++) = (unsigned char)(RCMData_WarmingHCESPN_Today[RCMData_WarmingCount_Today_Send] / 256);

				HCEPGN_61184_MSGT_250_Transmit_Data_Count = Index + 1;
				HCEPGN_61184_MSGT_250_Transmit_Data[0] = 250;
				memcpy((HCEPGN_61184_MSGT_250_Transmit_Data + 1), SendData, Index);
				HCEPGN_61184_MSGT_250_Transmit_Flag = 1;

				break;

			case 0x71 :	//	ECM DTC
				SendData[Index++] = HCESPN.H1598 = 1;
				SendData[Index++] = HCESPN.H1600;

				memcpy((SendData + Index), (unsigned char *)(HCESPN.H941), 6);
				Index += 6;

				// 120201
				SendData[Index - 6] |= 0x80;

				TempIntData = B2L4(HCESPN.H1601);
				memcpy((SendData + Index), (unsigned char *)(&TempIntData), 4);
				Index += 4;

				memcpy((SendData + Index), (unsigned char *)(HCESPN.H854), 8);
				Index += 8;

				*(SendData + Index++) = RCMData_ECMFault_Today[RCMData_ECMFaultCount_Today_Send][0];
				*(SendData + Index++) = RCMData_ECMFault_Today[RCMData_ECMFaultCount_Today_Send][1];
				*(SendData + Index++) = RCMData_ECMFault_Today[RCMData_ECMFaultCount_Today_Send][2];

				HCEPGN_61184_MSGT_250_Transmit_Data_Count = Index + 1;
				HCEPGN_61184_MSGT_250_Transmit_Data[0] = 250;
				memcpy((HCEPGN_61184_MSGT_250_Transmit_Data + 1), SendData, Index);
				HCEPGN_61184_MSGT_250_Transmit_Flag = 1;
				break;

			#if 0
			case 0x75 :	//	TCU DTC
				SendData[Index++] = HCESPN.H1598 = 1;
				SendData[Index++] = HCESPN.H1600;

				memcpy((SendData + Index), (unsigned char *)(HCESPN.H941), 6);
				Index += 6;

				// 120201
				SendData[Index - 6] |= 0x80;

				TempIntData = B2L4(HCESPN.H1601);
				memcpy((SendData + Index), (unsigned char *)(&TempIntData), 4);
				Index += 4;

				memcpy((SendData + Index), (unsigned char *)(HCESPN.H854), 8);
				Index += 8;

				*(SendData + Index++) = RCMData_TCUFault_Today[RCMData_TCUFaultCount_Today_Send][0];

				HCEPGN_61184_MSGT_250_Transmit_Data_Count = Index + 1;
				HCEPGN_61184_MSGT_250_Transmit_Data[0] = 250;
				memcpy((HCEPGN_61184_MSGT_250_Transmit_Data + 1), SendData, Index);
				HCEPGN_61184_MSGT_250_Transmit_Flag = 1;
				break;
			#endif	

			case 0x29 :	//	FORKLIFT Active Warning/DTC Message
				SendData[Index++] = HCESPN.H1598 = 1;
				SendData[Index++] = HCESPN.H1600;

				memcpy((SendData + Index), (unsigned char *)(HCESPN.H941), 6);
				Index += 6;

				// 120201
				SendData[Index - 6] |= 0x80;

				TempIntData = B2L4(HCESPN.H1601);
				memcpy((SendData + Index), (unsigned char *)(&TempIntData), 4);
				Index += 4;

				*(SendData + Index++) = HCESPN.H1518;
				*(SendData + Index++) = HCESPN.H1501;
				*(SendData + Index++) = HCESPN.H1502;
				*(SendData + Index++) = HCESPN.H1503;
			
				if(HCESPN.H1518 != 0)
				{
					for (i = 0; i < ((HCESPN.H1518 < 5) ? HCESPN.H1518 : 5); i++)
					{
						*(SendData + Index++) = (unsigned char)(RCMData_WarmingHCESPN[i] % 256);
						*(SendData + Index++) = (unsigned char)(RCMData_WarmingHCESPN[i] / 256);
					}
				}

				if(HCESPN.H1502 != 0)
				{
					for (i = 0; i < ((HCESPN.H1502 < 5) ? HCESPN.H1502 : 5); i++)
					{
						*(SendData + Index++) = RCMData_ECMFault[i][0];
						*(SendData + Index++) = RCMData_ECMFault[i][1];
						*(SendData + Index++) = RCMData_ECMFault[i][2];
					}
				}


				if(HCESPN.H1503 != 0)
				{
					for (i = 0; i < ((HCESPN.H1503 < 5) ? HCESPN.H1503 : 5); i++)
					{
						*(SendData + Index++) = RCMData_TCUFault[i][0];
					}
				}


				HCEPGN_61184_MSGT_250_Transmit_Data_Count = Index + 1;
				HCEPGN_61184_MSGT_250_Transmit_Data[0] = 250;
				memcpy((HCEPGN_61184_MSGT_250_Transmit_Data + 1), SendData, Index);

				if(RCM3_Center_Command == 1)
				{
					HCEPGN_61184_MSGT_250_Transmit_Flag = 1;
					RCM3_Center_Command = 0;
				}
			
				break;

			case 0xd5 :  //Machine Security
				SendData[Index++] = HCESPN.H1598 = 1;
				SendData[Index++] = HCESPN.H1600;

				memcpy((SendData + Index), (unsigned char *)(HCESPN.H941), 6);
				Index += 6;

				SendData[Index - 6] |= 0x80;			

				SendData[Index++] = Machine_Security_Command;
				SendData[Index++] = 0xfc + HCESPN.H820;		//ESL MODE
				SendData[Index++] = 0xff;

				SendData[Index++] = (unsigned char)(HCESPN.H1551 % 256);
				SendData[Index++] = (unsigned char)(HCESPN.H1551 / 256);

				SendData[Index++] = (unsigned char)(HCESPN.H1552 % 256);
				SendData[Index++] = (unsigned char)(HCESPN.H1552 / 256);

				SendData[Index++] = (unsigned char)(HCESPN.H1553 % 256);
				SendData[Index++] = (unsigned char)(HCESPN.H1553 / 256);

				SendData[Index++] = (unsigned char)(HCESPN.H1555 % 256);
				SendData[Index++] = (unsigned char)(HCESPN.H1555 / 256);

				SendData[Index++] = (unsigned char)(HCESPN.H1556 % 256);
				SendData[Index++] = (unsigned char)(HCESPN.H1556 / 256);

				SendData[Index++] = 0xff;
				SendData[Index++] = 0xff;
				SendData[Index++] = 0xff;
				
				SendData[Index++] = 0x2a; //H953
				
				for(i=0; i<11; i++)
				{
					SendData[Index++] = HCESPN.H954[i];

					if(HCESPN.H954[i] == 0x2a)
						break;
				}
				
				SendData[Index++] = 0x2a; //H952

				for(i=0; i<11; i++)
				{
					SendData[Index++] = HCESPN.H955[i];

					if(HCESPN.H955[i] == 0x2a)
						break;
				}
				

				SendData[Index++] = 0xff;
				SendData[Index++] = 0xff;

				SendData[Index++] = 0xff; //H959
				SendData[Index++] = 0xff;
				SendData[Index++] = 0xff;
				SendData[Index++] = 0xff;
				SendData[Index++] = 0xff;
				SendData[Index++] = 0xff;
				SendData[Index++] = 0xff;

				SendData[Index++] = 0x2a; //H965

				HCEPGN_61184_MSGT_250_Transmit_Data_Count = Index + 1;
				HCEPGN_61184_MSGT_250_Transmit_Data[0] = 250;
				memcpy((HCEPGN_61184_MSGT_250_Transmit_Data + 1), SendData, Index);
				HCEPGN_61184_MSGT_250_Transmit_Flag = 1;

				break;
				
			case 0xd7 :	//	Local Time Setting
				SendData[Index++] = HCESPN.H1598 = 1;
				SendData[Index++] = HCESPN.H1600;

				*(SendData + Index++) = HCESPN.H951;

				HCEPGN_61184_MSGT_250_Transmit_Data_Count = Index + 1;
				HCEPGN_61184_MSGT_250_Transmit_Data[0] = 250;
				memcpy((HCEPGN_61184_MSGT_250_Transmit_Data + 1), SendData, Index);
				HCEPGN_61184_MSGT_250_Transmit_Flag = 1;

				break;

			case 0xd0 : // ENGINE FORKLIFT Maintenance(D9->D0)
				SendData[Index++] = HCESPN.H1598 = 1;
				SendData[Index++] = HCESPN.H1600;
				
				SendData[Index++] = 0x04; // Machine Type(0x04 - Forklift)

				SendData[Index++] = HCESPN.H941[0];
				SendData[Index++] = HCESPN.H941[1];
				SendData[Index++] = HCESPN.H941[2];
				SendData[Index++] = HCESPN.H941[3];
				SendData[Index++] = HCESPN.H941[4];				
				
				TempIntData = B2L4(HCESPN.H1601);
				memcpy((SendData + Index), (unsigned char *)(&TempIntData), 4);
				Index += 4;

				maintenance_list_total = 0;
				for(i = 0; i < MAINTENANCE_TOTAL; i++)
				{
					if(Maintenance_Data[i].Maintenance_Interval != 0xff)
						maintenance_list_total++;
				}
				
				SendData[Index++] = maintenance_list_total;

				for(i = 0; i < MAINTENANCE_TOTAL; i++)
				{
					if(Maintenance_Data[i].Maintenance_Interval != 0xff)
					{				
						maintenance_index = Set_H1098(i);
						*(SendData + Index++) = maintenance_index + ((Maintenance_Data[i].Maintenance_Alarm)<<6);
						//*(SendData + Index++) = 0xfc + Maintenance_Data[i].Maintenance_Alarm;
						*(SendData + Index++) = Maintenance_Data[i].Maintenance_Interval;
						*(SendData + Index++) = Maintenance_Data[i].Maintenance_Replacement_Count;
						*(SendData + Index++) = (unsigned char)(Maintenance_Data[i].Maintenance_Hourmeter % 256);
						*(SendData + Index++) = (unsigned char)(Maintenance_Data[i].Maintenance_Hourmeter / 256);
					}
				}		
				
				HCEPGN_61184_MSGT_250_Transmit_Data_Count = Index + 1;
				HCEPGN_61184_MSGT_250_Transmit_Data[0] = 250;
				memcpy((HCEPGN_61184_MSGT_250_Transmit_Data + 1), SendData, Index);
				HCEPGN_61184_MSGT_250_Transmit_Flag = 1;

				break;

			case 0xda :
			case 0xdb :
				SendData[Index++] = HCESPN.H1598 = 1;
				SendData[Index++] = HCESPN.H1600;

				TempIntData = B2L4(HCESPN.H1601);
				memcpy((SendData + Index), (unsigned char *)(&TempIntData), 4);
				Index += 4;

				maintenance_index = Unset_H1098(RCMData_MaintenanceItem);

				*(SendData + Index++) = RCMData_MaintenanceItem;

				*(SendData + Index++) = 0xfc + Maintenance_Data[maintenance_index].Maintenance_Alarm;
				*(SendData + Index++) = Maintenance_Data[maintenance_index].Maintenance_Interval;
				*(SendData + Index++) = Maintenance_Data[maintenance_index].Maintenance_Replacement_Count;
				*(SendData + Index++) = (unsigned char)(Maintenance_Data[maintenance_index].Maintenance_Hourmeter % 256);
				*(SendData + Index++) = (unsigned char)(Maintenance_Data[maintenance_index].Maintenance_Hourmeter / 256);

				memcpy((SendData + Index), (unsigned char *)(HCESPN.H941), 5);
				Index += 5;

				SendData[Index - 5] |= 0x80;        // 20120120 date error

				HCEPGN_61184_MSGT_250_Transmit_Data_Count = Index + 1;
				HCEPGN_61184_MSGT_250_Transmit_Data[0] = 250;
				memcpy((HCEPGN_61184_MSGT_250_Transmit_Data + 1), SendData, Index);
				HCEPGN_61184_MSGT_250_Transmit_Flag = 1;

				break;

			//Shift Mode & Actual Gear Distribution 구현 하지 말라는 데 구현함!!
			case 0xe5 :
				SendData[Index++] = HCESPN.H1598 = 1;
				SendData[Index++] = HCESPN.H1600;

				memcpy((SendData + Index), (unsigned char *)(HCESPN.H941), 6);
				Index += 6;

				// 120201
				SendData[Index - 6] |= 0x80;

				if((HCESPN.H1621 < 4) && (DailyReport_Send_Status == 4))
				{
					for (i = 0; i < 11; i++)
					{
						TempIntData = B2L4(HCESPN.H1270[i]);
						memcpy((SendData + Index), (unsigned char *)(&TempIntData), 4);
						Index += 4;
					}
				}
				else
				{
					for (i = 0; i < 11; i++)
					{
						TempIntData = B2L4(HCESPN.H1270[i]);
						memcpy((SendData + Index), (unsigned char *)(&TempIntData), 4);
						Index += 4;
					}
				}

				HCEPGN_61184_MSGT_250_Transmit_Data_Count = Index + 1;
				HCEPGN_61184_MSGT_250_Transmit_Data[0] = 250;
				memcpy((HCEPGN_61184_MSGT_250_Transmit_Data + 1), SendData, Index);
				HCEPGN_61184_MSGT_250_Transmit_Flag = 1;
				break;

			case 0xe7 :
				SendData[Index++] = HCESPN.H1598 = 1;
				SendData[Index++] = HCESPN.H1600;

				memcpy((SendData + Index), (unsigned char *)(HCESPN.H941), 6);
				Index += 6;

				SendData[Index - 6] |= 0x80;

				if((HCESPN.H1621 < 4) && (DailyReport_Send_Status == 6))
				{
					for (i = 0; i < 16; i++)
					{
						if(HCESPN.Actual_Engine_Percent_Torque_513 < 0xffff)						
							TempIntData = B2L4(HCESPN.H1286[i]);
						else
							TempIntData = 0xffffffff;
						
						memcpy((SendData + Index), (unsigned char *)(&TempIntData), 4);
						Index += 4;
					}
				}
				else
				{
					for (i = 0; i < 16; i++)
					{
						TempIntData = B2L4(HCESPN.H1286[i]);
						memcpy((SendData + Index), (unsigned char *)(&TempIntData), 4);
						Index += 4;
					}
				}

				HCEPGN_61184_MSGT_250_Transmit_Data_Count = Index + 1;
				HCEPGN_61184_MSGT_250_Transmit_Data[0] = 250;
				memcpy((HCEPGN_61184_MSGT_250_Transmit_Data + 1), SendData, Index);
				HCEPGN_61184_MSGT_250_Transmit_Flag = 1;

				break;

			case 0xe8 :
				SendData[Index++] = HCESPN.H1598 = 1;
				SendData[Index++] = 0xed;//HCESPN.H1600;

				if((HCESPN.H1621 < 4) && (DailyReport_Send_Status == 8))
				{
					
					Index += make_RCM_Temp_Distribution_Total((struct st_RCM_Temp_Distribution *)&SendData[Index]);
				}
				else
				{
					Index += make_RCM_Temp_Distribution_Total((struct st_RCM_Temp_Distribution *)&SendData[Index]);
				}

				HCEPGN_61184_MSGT_250_Transmit_Data_Count = Index + 1;
				HCEPGN_61184_MSGT_250_Transmit_Data[0] = 250;
				memcpy((HCEPGN_61184_MSGT_250_Transmit_Data + 1), SendData, Index);
				HCEPGN_61184_MSGT_250_Transmit_Flag = 1;
				break;

			case 0x10 :
				SendData[Index++] = HCESPN.H1598 = 1;
				SendData[Index++] = HCESPN.H1600;

				memcpy((SendData + Index), (unsigned char *)(HCESPN.H941), 5);
				Index += 5;

				SendData[Index - 5] |= 0x80;

				*(SendData + Index++) = HCESPN.H971;
				*(SendData + Index++) = HCESPN.H972;
				*(SendData + Index++) = HCESPN.H973;
				*(SendData + Index++) = HCESPN.H974;

				TempStrSize = strlen(HCESPN.H975);

				if(TempStrSize<=3)
					TempStrSize = 0;

				for(i = 0; i < TempStrSize-3; i++)
				{
					*(SendData + Index++) = HCESPN.H975[i+3];
				}

				*(SendData + Index++) = '*';

				TempStrSize = strlen(HCESPN.H960);

				for(i = 0; i < TempStrSize; i++)
				{
					*(SendData + Index++) = HCESPN.H960[i];
				}

				*(SendData + Index++) = '*';

				*(SendData + Index++) = HCESPN.H977; //++,--, 210113 ysm, SATELITE

				HCEPGN_61184_MSGT_250_Transmit_Data_Count = Index + 1;
				HCEPGN_61184_MSGT_250_Transmit_Data[0] = 250;
				memcpy((HCEPGN_61184_MSGT_250_Transmit_Data + 1), SendData, Index);
				HCEPGN_61184_MSGT_250_Transmit_Flag = 1;

				break;

			default :
				
				break;
		}
	}
	else if (RCM3_Send_Flag == 2)
	{
		SendData[Index++] = HCESPN.H1598 = 0;
		SendData[Index++] = HCESPN.H1600;

		if(HCESPN.H1621 < 4)
		{
			Index += make_Remote3PacketData_0x09((struct st_Remote3PacketData_0x09 *)&SendData[Index]);
			SendData[Index - 116] |= 0x80;			

		}

		HCEPGN_61184_MSGT_250_Transmit_Data_Count = Index + 1;
		HCEPGN_61184_MSGT_250_Transmit_Data[0] = 250;
		memcpy((HCEPGN_61184_MSGT_250_Transmit_Data + 1), SendData, Index);
		HCEPGN_61184_MSGT_250_Transmit_Flag = 1;
	}
	else if (RCM3_Send_Flag == 3)
	{
		SendData[Index++] = HCESPN.H1598 = 4;

		HCEPGN_61184_MSGT_250_Transmit_Data_Count = Index + 1;
		HCEPGN_61184_MSGT_250_Transmit_Data[0] = 250;
		memcpy((HCEPGN_61184_MSGT_250_Transmit_Data + 1), SendData, Index);
		HCEPGN_61184_MSGT_250_Transmit_Flag = 1;

		if (H1600_Scheduled_Data)
		{
			H1600_Scheduled_Flag = 1;
		}
	}

	RCM3_Send_Flag = 0;
}

void SatelliteDataProcessing(void)
{	
	unsigned char DateChangeFlag;	
	
	if (First_SDP_Process < 20)
		First_SDP_Process++;

	//++, 220726 ysm, FAN_FINAL
	if ((HCESPN.H941[3] == 23) && (HCESPN.H941[4] == 59))
	{
		Last_H304_Data = HCESPN.H304_Coolant_temp;
		Last_H536_Data = HCESPN.TM_Oil_Temp;
	}
	//--, 220726 ysm, FAN_FINAL
	

	DateChangeFlag = CheckDateChange();	
	
	if (DateChangeFlag == 2)
	{
		if (First_SDP_Process == 20)
		{

			HCESPN.H1401[0] = 23;
			HCESPN.H1401[1] = 59;
			HCESPN.H1401[2] = 59;

		}	
		
		DailyReportDataSave();
		DailyReportDataInitial();

		DailyReport_Date.H940[0] = HCESPN.H940[0];
		DailyReport_Date.H940[1] = HCESPN.H940[1];
		DailyReport_Date.H940[2] = HCESPN.H940[2];

		DailyReport_Send_Status = 1;
		
		DateChange_SDP_Process = 1;
	}
	else
	{
		DailyReportDataProcessing(DateChange_SDP_Process);
		DateChange_SDP_Process = 0;
	}
	if (RTC_Calibration_Count < 0xfaffffff)
		RTC_Calibration_Count++;
}

void DailyReportDataProcessing(unsigned char DateChange_Process)
{
		
	EngineRunTimeLog();
	EngineRunTimesLog(DateChange_Process);
	//FuelLog(DateChange_Process);	//WIP
	
	OperatingTimeLog(DateChange_Process);
	DistributionLog();
}



void DistributionLog(void)
{		

	unsigned char i;
	
	if (( (HCESPN.rpm_310  < 8192 ) && (HCESPN.rpm_310 >= 500) )||(ALT_Level_Status == 1))
	{


		if (HCESPN.Actual_Engine_Percent_Torque_513 < 0xffff)
		{
			if (HCESPN.Actual_Engine_Percent_Torque_513 < (30))
				HCESPN.H1286[0]++;
			else if (HCESPN.Actual_Engine_Percent_Torque_513 < (40))
				HCESPN.H1286[1]++;
			else if (HCESPN.Actual_Engine_Percent_Torque_513 < (45))
				HCESPN.H1286[2]++;
			else if (HCESPN.Actual_Engine_Percent_Torque_513 < (50))
				HCESPN.H1286[3]++;
			else if (HCESPN.Actual_Engine_Percent_Torque_513 < (53))
				HCESPN.H1286[4]++;
			else if (HCESPN.Actual_Engine_Percent_Torque_513 < (56))
				HCESPN.H1286[5]++;
			else if (HCESPN.Actual_Engine_Percent_Torque_513 < (59))
				HCESPN.H1286[6]++;
			else if (HCESPN.Actual_Engine_Percent_Torque_513 < (62))
				HCESPN.H1286[7]++;
			else if (HCESPN.Actual_Engine_Percent_Torque_513 < (65))
				HCESPN.H1286[8]++;
			else if (HCESPN.Actual_Engine_Percent_Torque_513< (68))
				HCESPN.H1286[9]++;
			else if (HCESPN.Actual_Engine_Percent_Torque_513 < (71))
				HCESPN.H1286[10]++;
			else if (HCESPN.Actual_Engine_Percent_Torque_513< (74))
				HCESPN.H1286[11]++;
			else if (HCESPN.Actual_Engine_Percent_Torque_513 < (77))
				HCESPN.H1286[12]++;
			else if (HCESPN.Actual_Engine_Percent_Torque_513< (80))
				HCESPN.H1286[13]++;
			else if (HCESPN.Actual_Engine_Percent_Torque_513 < (90))
				HCESPN.H1286[14]++;
			else
				HCESPN.H1286[15]++;
		}


		//++, 200907 ysm, MOBILE
		#if 0
		if ( (HCESPN.H101 >= HCESPN.H1331[0]) && ( HCESPN.H101 <= 0xfa))
		{
			HCESPN.H1331[0] = HCESPN.H101;
			HCESPN.H1331[1] = HCESPN.H941[0];
			HCESPN.H1331[2] = HCESPN.H941[1];
			HCESPN.H1331[3] = HCESPN.H941[2];
			HCESPN.H1331[4] = HCESPN.H941[3];
			HCESPN.H1331[5] = HCESPN.H941[4];
		}
		#endif
		//--, 200907 ysm, MOBILE


		if (HCESPN.H304_Coolant_temp <= 0xfa)
		{

			//++, 200907 ysm, MOBILE
			CoolantTempDistribution2_Total[11]++;	//	Total Engine Coolant Temperature Distribution 2 Total

			if (HCESPN.H304_Coolant_temp < (40 + 30))
			{
				CoolantTempDistribution2_Total[0]++;
			}
			else if (HCESPN.H304_Coolant_temp < (40 + 60))
			{
				CoolantTempDistribution2_Total[1]++;
			}
			else if (HCESPN.H304_Coolant_temp < (40 + 70))
			{
				CoolantTempDistribution2_Total[2]++;
			}
			else if (HCESPN.H304_Coolant_temp < (40 + 80))
			{
				CoolantTempDistribution2_Total[3]++;
			}
			else if (HCESPN.H304_Coolant_temp < (40 + 84))
			{
				CoolantTempDistribution2_Total[4]++;
			}
			else if (HCESPN.H304_Coolant_temp < (40 + 87))
			{
				CoolantTempDistribution2_Total[5]++;
			}
			else if (HCESPN.H304_Coolant_temp < (40 + 90))
			{
				CoolantTempDistribution2_Total[6]++;
			}
			else if (HCESPN.H304_Coolant_temp < (40 + 93))
			{
				CoolantTempDistribution2_Total[7]++;
			}
			else if (HCESPN.H304_Coolant_temp < (40 + 96))
			{
				CoolantTempDistribution2_Total[8]++;
			}
			else if (HCESPN.H304_Coolant_temp < (40 + 100))
			{
				CoolantTempDistribution2_Total[9]++;
			}
			else
			{
				CoolantTempDistribution2_Total[10]++;
			}
			//--, 200907 ysm, MOBILE
		}		
		
		if (HCESPN.H304_Coolant_temp <= 0xfa)
		{
			if (HCESPN.H304_Coolant_temp >= HCESPN.H1341[0])
			{
				HCESPN.H1341[0] = HCESPN.H304_Coolant_temp;
				HCESPN.H1341[1] = HCESPN.H941[0];
				HCESPN.H1341[2] = HCESPN.H941[1];
				HCESPN.H1341[3] = HCESPN.H941[2];
				HCESPN.H1341[4] = HCESPN.H941[3];
				HCESPN.H1341[5] = HCESPN.H941[4];
			}
		}
		else
		{
				HCESPN.H1341[0] = 0xff;
				HCESPN.H1341[1] = HCESPN.H941[0];
				HCESPN.H1341[2] = HCESPN.H941[1];
				HCESPN.H1341[3] = HCESPN.H941[2];
				HCESPN.H1341[4] = HCESPN.H941[3];
				HCESPN.H1341[5] = HCESPN.H941[4];
		}

		if (HCESPN.TM_Oil_Temp <= 0xfa)
		{
			TMTempDistribution[7]++;

			if (HCESPN.TM_Oil_Temp < (50 + 30))
				TMTempDistribution[0]++;
			else if (HCESPN.TM_Oil_Temp < (50 + 60))
				TMTempDistribution[1]++;
			else if (HCESPN.TM_Oil_Temp< (50 + 70))
				TMTempDistribution[2]++;
			else if (HCESPN.TM_Oil_Temp< (50 + 80))
				TMTempDistribution[3]++;
			else if (HCESPN.TM_Oil_Temp < (50 + 90))
				TMTempDistribution[4]++;
			else if (HCESPN.TM_Oil_Temp < (50 + 100))
				TMTempDistribution[5]++;
			else
				TMTempDistribution[6]++;
		}			

		if (HCESPN.TM_Oil_Temp <= 0xfa)
		{
			if (HCESPN.TM_Oil_Temp >= HCESPN.H1332[0])
			{
				HCESPN.H1332[0] = HCESPN.TM_Oil_Temp;
				HCESPN.H1332[1] = HCESPN.H941[0];
				HCESPN.H1332[2] = HCESPN.H941[1];
				HCESPN.H1332[3] = HCESPN.H941[2];
				HCESPN.H1332[4] = HCESPN.H941[3];
				HCESPN.H1332[5] = HCESPN.H941[4];
			}
		}
		else
		{
				HCESPN.H1332[0] = 0xff;
				HCESPN.H1332[1] = 0xff;
				HCESPN.H1332[2] = 0xff;
				HCESPN.H1332[3] = 0xff;
				HCESPN.H1332[4] = 0xff;
				HCESPN.H1332[5] = 0xff;
		}


		#if 0
		
		if(HCESPN.H543 == 0)
			HCESPN.H1270[0]++;
		else if (HCESPN.H543 == 1 )
			HCESPN.H1270[1]++;
		else if (HCESPN.H543 == 2 )
			HCESPN.H1270[2]++;
              else if (HCESPN.H543 == 3 )
                     HCESPN.H1270[3]++;		

		if((HCESPN.H542 & 0x3f) == 0x11)
			HCESPN.H1270[4]++;
		else if((HCESPN.H542 & 0x3f) == 0x12)
			HCESPN.H1270[5]++;
		else if((HCESPN.H542 & 0x3f) == 0x13)
			HCESPN.H1270[6]++;
		else if((HCESPN.H542 & 0x3f) == 0x14)
			HCESPN.H1270[7]++;           
		else if((HCESPN.H542 & 0x3f) == 0x21)
			HCESPN.H1270[8]++;
		else if((HCESPN.H542 & 0x3f) == 0x22)
			HCESPN.H1270[9]++;
		else if((HCESPN.H542 & 0x3f) == 0x23)
			HCESPN.H1270[10]++;
			  
		#else

		for(i=0; i<11; i++)
		{
			HCESPN.H1270[i] = 0;
		}			  

		if((HCESPN.Gear_542 == GEAR_FORWARD)&&(AutoShiftMode_Gear == 1))
			HCESPN.H1270[4]++;
		else if((HCESPN.Gear_542 == GEAR_FORWARD)&&(AutoShiftMode_Gear == 2))
			HCESPN.H1270[5]++;
		else if((HCESPN.Gear_542 == GEAR_REVERSE)&&(AutoShiftMode_Gear == 1))
			HCESPN.H1270[8]++;
		else if((HCESPN.Gear_542 == GEAR_REVERSE)&&(AutoShiftMode_Gear == 2))
		{
			if((InfoModel1.ModelInfo >= MODEL_35D_9S)&&(InfoModel1.ModelInfo <= MODEL_50D_9S))
				HCESPN.H1270[9]++;					
		}
		
		#endif
		
	}

#if 0
	HCESPN.H1261[0] = (unsigned char)((float)(HYDTempDistribution[0]) * 100 / (float)(HYDTempDistribution[7]));
	HCESPN.H1261[1] = (unsigned char)((float)(HYDTempDistribution[1]) * 100 / (float)(HYDTempDistribution[7]));
	HCESPN.H1261[2] = (unsigned char)((float)(HYDTempDistribution[2]) * 100 / (float)(HYDTempDistribution[7]));
	HCESPN.H1261[3] = (unsigned char)((float)(HYDTempDistribution[3]) * 100 / (float)(HYDTempDistribution[7]));
	HCESPN.H1261[4] = (unsigned char)((float)(HYDTempDistribution[4]) * 100 / (float)(HYDTempDistribution[7]));
	HCESPN.H1261[5] = (unsigned char)((float)(HYDTempDistribution[5]) * 100 / (float)(HYDTempDistribution[7]));
	HCESPN.H1261[6] = (unsigned char)((float)(HYDTempDistribution[6]) * 100 / (float)(HYDTempDistribution[7]));
#endif



	//++, 200907 ysm, MOBILE
	if (CoolantTempDistribution2_Total[11] != 0)	//	20150501	RMS Distribution Aday, Aweek, Total transmit	Total Engine Coolant Temperature Distribution 2 Total
	{
		HCESPN.H1292[0] = (unsigned char)(((float)(CoolantTempDistribution2_Total[0]) * 100 / (float)(CoolantTempDistribution2_Total[11])) + 0.5);
		HCESPN.H1292[1] = (unsigned char)(((float)(CoolantTempDistribution2_Total[1]) * 100 / (float)(CoolantTempDistribution2_Total[11])) + 0.5);
		HCESPN.H1292[2] = (unsigned char)(((float)(CoolantTempDistribution2_Total[2]) * 100 / (float)(CoolantTempDistribution2_Total[11])) + 0.5);
		HCESPN.H1292[3] = (unsigned char)(((float)(CoolantTempDistribution2_Total[3]) * 100 / (float)(CoolantTempDistribution2_Total[11])) + 0.5);
		HCESPN.H1292[4] = (unsigned char)(((float)(CoolantTempDistribution2_Total[4]) * 100 / (float)(CoolantTempDistribution2_Total[11])) + 0.5);
		HCESPN.H1292[5] = (unsigned char)(((float)(CoolantTempDistribution2_Total[5]) * 100 / (float)(CoolantTempDistribution2_Total[11])) + 0.5);
		HCESPN.H1292[6] = (unsigned char)(((float)(CoolantTempDistribution2_Total[6]) * 100 / (float)(CoolantTempDistribution2_Total[11])) + 0.5);
		HCESPN.H1292[7] = (unsigned char)(((float)(CoolantTempDistribution2_Total[7]) * 100 / (float)(CoolantTempDistribution2_Total[11])) + 0.5);
		HCESPN.H1292[8] = (unsigned char)(((float)(CoolantTempDistribution2_Total[8]) * 100 / (float)(CoolantTempDistribution2_Total[11])) + 0.5);
		HCESPN.H1292[9] = (unsigned char)(((float)(CoolantTempDistribution2_Total[9]) * 100 / (float)(CoolantTempDistribution2_Total[11])) + 0.5);
		HCESPN.H1292[10] = (unsigned char)(((float)(CoolantTempDistribution2_Total[10]) * 100 / (float)(CoolantTempDistribution2_Total[11])) + 0.5);
	}
	//--, 200907 ysm, MOBILE
	

	HCESPN.H1262[0] = (unsigned char)((float)(TMTempDistribution[0]) * 100 / (float)(TMTempDistribution[7]));
	HCESPN.H1262[1] = (unsigned char)((float)(TMTempDistribution[1]) * 100 / (float)(TMTempDistribution[7]));
	HCESPN.H1262[2] = (unsigned char)((float)(TMTempDistribution[2]) * 100 / (float)(TMTempDistribution[7]));
	HCESPN.H1262[3] = (unsigned char)((float)(TMTempDistribution[3]) * 100 / (float)(TMTempDistribution[7]));
	HCESPN.H1262[4] = (unsigned char)((float)(TMTempDistribution[4]) * 100 / (float)(TMTempDistribution[7]));
	HCESPN.H1262[5] = (unsigned char)((float)(TMTempDistribution[5]) * 100 / (float)(TMTempDistribution[7]));
	HCESPN.H1262[6] = (unsigned char)((float)(TMTempDistribution[6]) * 100 / (float)(TMTempDistribution[7]));


	
	
}

void OperatingTimeLog(unsigned char DateChange_Process)
{	
	unsigned char i;	

	unsigned char Working_On;		
	unsigned char Traveling_On;	
    

	if ((First_OTL == 0) || (DateChange_Process == 1))
	{
		First_OTL = 1;

		ADDistance = (unsigned short)(HCESPN.H1417);

		ADActualGear[0] = (unsigned short)(HCESPN.H1418[0]) + (unsigned short)(HCESPN.H1418[1])*256 ;
		ADActualGear[1] = (unsigned short)(HCESPN.H1418[2]) + (unsigned short)(HCESPN.H1418[3])*256 ;
		ADActualGear[2] = (unsigned short)(HCESPN.H1418[4]) ;
		ADActualGear[3] = (unsigned short)(HCESPN.H1418[5]) + (unsigned short)(HCESPN.H1418[6])*256 ;
		ADActualGear[4] = (unsigned short)(HCESPN.H1418[7]) + (unsigned short)(HCESPN.H1418[8])*256 ;
		ADActualGear[5] = (unsigned short)(HCESPN.H1418[9]);
		ADActualGear[6] = (unsigned short)(HCESPN.H1418[10]) + (unsigned short)(HCESPN.H1418[11])*256 ;
		ADActualGear[7] = (unsigned short)(HCESPN.H1418[12]) + (unsigned short)(HCESPN.H1418[13])*256 ;

		for(i=0; i< 3; i++)		ADEnginePowerMode[i] = HCESPN.H1419[i];

        AD_Weight_Sum = 0;  
		AD_Weight_Count = 0;
		AD_Weight_Flag = 0;
	}
	
	if ( ((HCESPN.rpm_310  < 8192 ) && (HCESPN.rpm_310 >= 500))||(ALT_Level_Status == 1) )
	{


		if((HCESPN.Weight_Current >= 10.0)&&(AD_DATA.C_LOAD_SENSOR > AD_DATA.C_Tare_Volt)&&(AD_DATA.C_Load_Indicator < 0xfaff))
		{
			
			if(HCESPN.H1411_2 < 0xfaffff)

			{
				HCESPN.H1411_2++;
			}			

			Working_On = 1;
			
		}		
		else
		{
			Working_On = 0;
		}

		
		// Traveling Hour :  Vehicle  Speed 가 1km/h 이상이면 "Counting"
		if(  (HCESPN.H532  >=  256) && (HCESPN.H532 <= 0xfaff)	)
		{

			if(HCESPN.H1412_2 < 0xfaffff)

			{
				HCESPN.H1412_2++;
			}

			Traveling_On = 1;

		}
		else
		{
			Traveling_On = 0; //++,--, 200903 ysm, MOBILE
		}

		if ((Working_On == 0) && (Traveling_On == 0))       
		{
			if (HCESPN.H1413_2 < 0xfaffff)
			{
				HCESPN.H1413_2++;
			}
		}
		
		if( (ADDistance < 64255.0)  && (HCESPN.H532 <= 0xfaff)	)
			ADDistance += (((float)(HCESPN.H532)/(256.0/8)) /3600.0);
			
		HCESPN.H1417 = (unsigned short)ADDistance;
		
		if( (ADActualGearShift_Status != ActualGearStatus)  && (ActualGearStatus != 0) ) 
		{				
			                         
        		if( ADActualGear[7] < 64255)  ADActualGear[7]++;
                    

			if( (ADActualGearShift_Status >= 1) && (ADActualGearShift_Status < 7))
			{
				if( (ActualGearStatus >= 7) && (ActualGearStatus <= 12) )
				{
					if(ADActualGear[6] < 64255)  ADActualGear[6]++;			
				}
			}

			if( (ADActualGearShift_Status >= 7) && (ADActualGearShift_Status <= 12) )
			{
				if( (ActualGearStatus >= 1) && (ActualGearStatus < 7) )
				{
					if(ADActualGear[6] < 64255)  ADActualGear[6]++;			
				}
			}
	
			
			switch(ActualGearStatus)		
			{
				case 1: 	if(ADActualGear[0] < 64255) 	ADActualGear[0]++;	break;
				case 2: 	if(ADActualGear[1] < 64255) 	ADActualGear[1]++;	break;
				case 3: 	if(ADActualGear[2] < 250) 		ADActualGear[2]++;	break;
				case 7: 	if(ADActualGear[3] < 64255) 	ADActualGear[3]++;	break;
				case 8: 	if(ADActualGear[4] < 64255) 	ADActualGear[4]++;	break;
				case 9: 	if(ADActualGear[5] < 250) 	ADActualGear[5]++;	break;
			}
		}	

		HCESPN.H1418[0] = ADActualGear[0]%256 ;
 		HCESPN.H1418[1] =ADActualGear[0]/256 ;
 		HCESPN.H1418[2] =ADActualGear[1]%256 ;
 		HCESPN.H1418[3] =ADActualGear[1]/256  ;
 		HCESPN.H1418[4] =ADActualGear[2] ;
 		HCESPN.H1418[5] =ADActualGear[3]%256 ;
 		HCESPN.H1418[6] =ADActualGear[3]/256  ;
 		HCESPN.H1418[7] =ADActualGear[4]%256 ;
 		HCESPN.H1418[8] =ADActualGear[4]/256  ;
 		HCESPN.H1418[9] =ADActualGear[5] ;
 		HCESPN.H1418[10] =ADActualGear[6]%256 ;
 		HCESPN.H1418[11] =ADActualGear[6]/256  ;
 		HCESPN.H1418[12] =ADActualGear[7]%256 ;
 		HCESPN.H1418[13] =ADActualGear[7]/256  ;
		
		ADActualGearShift_Status = ActualGearStatus;


		#if 0
		if(Flag_DIN[INDEX_PWD_STD_MODE_SEL]==1) //POWER MODE
		{
			if(ADEnginePowerMode[0] < 64255)
				ADEnginePowerMode[0]++;

		}
		else
		{
			if(ADEnginePowerMode[1] < 64255)
				ADEnginePowerMode[1]++;
		}
		#else
		if(ADEnginePowerMode[1] < 64255)
			ADEnginePowerMode[1]++;

		#endif

		ADEnginePowerMode[2] = 0xffff;

		for(i=0; i<3; i++)
		{
			HCESPN.H1419[i] =ADEnginePowerMode[i];
		}
                              
		if ( (AD_Weight_Sum < 0xfaffffff)  )
		{
			if( (HCESPN.Weight_Current >= 10.0) && (HCESPN.Weight_Current < 0xfaff) )
			{
				AD_Weight_Sum +=(HCESPN.Weight_Current/10);
				AD_Weight_Count++;	
				AD_Weight_Flag = 1;
			}
			else if( (HCESPN.Weight_Current < 10.0) && (AD_Weight_Flag == 1)) // 300->10(0.1ton)
			{
				HCESPN.H1915 += AD_Weight_Sum/AD_Weight_Count;

				Weight_Temp = AD_Weight_Sum/AD_Weight_Count;

				Weight_Temp_Flag = 1;

				AD_Weight_Flag = 0;
				AD_Weight_Working_Count++;

				AD_Weight_Sum = 0;
				AD_Weight_Count = 0;

			}                                      
                    
     	  }

		  HCESPN.H1414 = 0xffff;
      }

}

void FuelLog(unsigned char DateChange_Process)
{
	if ((First_FL == 0) || (DateChange_Process == 1))
	{
		First_FL = 1;
		//FuelUsed_FL = (float)(DailyReport_Basic.H1405) * 3600.;
	}

	if (SPN.H183_Engine_Fuel_Rate < 0xfaff)
		FuelUsed_FL += (float)(SPN.H183_Engine_Fuel_Rate);
	
	//DailyReport_Basic.H1405 = (unsigned short)(FuelUsed_FL / 3600.);
	
	//HCESPN.H1405 = DailyReport_Basic.H1405;

	if (++FL_Count >= 60)	    
	{
		FL_Count = 0;
		
		FuelReadCount++;

		//++, 201231 ysm, MOBILE
		#if 0
		FuelSum += HCESPN.Fuel_Level;
		#else
		FuelSum += Fuel_Seg;
		#endif
		//--, 201231 ysm, MOBILE

		if (Fuel_Seg == Fuel_Seg_before)
		{
			if (++FuelEqualCount >= 15)			
			{
				FuelEqualCount = 0;
				FuelReadCount = 0;
				FuelSum = 0;
				Fuel_OK_Seg = Fuel_Seg;
				CalculateFuelConsumption();
			}
		}
		else
		{
			FuelEqualCount = 0;
		}

		if (FuelReadCount >= 40)	
		{
			FuelEqualCount = 0;
			FuelReadCount = 0;
			Fuel_OK_Seg = FuelSum / 40;			
			
			if ((FuelSum % 40) > 30)				
				Fuel_OK_Seg++;	
			
			FuelSum = 0;

			CalculateFuelConsumption();
		}

		Fuel_Seg_before = Fuel_Seg;
	}
}

void CalculateFuelConsumption(void)
{
	if (!first_after_keyon_cal_fuel)
	{
		first_after_keyon_cal_fuel = 1;
		Fuel_OK_Seg_Before = (Fuel_OK_Seg < Fuel_Remain_Seg) ? Fuel_Remain_Seg : Fuel_OK_Seg;
	}

	FuelRemain = FuelFactor[Machine_Model][Fuel_OK_Seg_Before];

	if (Fuel_OK_Seg < Fuel_OK_Seg_Before)
	{
		if ((Fuel_OK_Seg_Before - Fuel_OK_Seg) > 1)
		{
			Fuel_OK_Seg = Fuel_OK_Seg_Before - 1;
		}

		if (FuelOsc != 2)
		{
			FuelConsumption += (FuelRemain - FuelFactor[Machine_Model][Fuel_OK_Seg]);
		}
		
		FuelOsc = 1;	
	}
	else if (Fuel_OK_Seg > Fuel_OK_Seg_Before)
	{
		if ((FuelOsc == 1) && ((Fuel_OK_Seg - Fuel_OK_Seg_Before) == 1))
			FuelOsc = 2;
	}
	else
	{
		FuelOsc = 0;
		
		if ((Fuel_OK_Seg == 0) && (EngineStartFlag == 1))
		{
			FuelConsumption += FuelFactor[Machine_Model][Fuel_OK_Seg] / 10;
		}
	}

	Fuel_OK_Seg_Before = Fuel_OK_Seg;
	FuelRemain = FuelFactor[Machine_Model][Fuel_OK_Seg_Before];

	HCESPN.H1403 = FuelConsumption * 20; //++,--, 200903 ysm, MOBILE
}

void EngineRunTimeLog(void)
{
	if ( ((HCESPN.rpm_310  < 8192 ) && (HCESPN.rpm_310 >= 500) )|| (ALT_Level_Status == 1))
	{
		//++, 201214 ysm, MOBILE
		if(HCESPN.H1410_2 < 0xfaffff)
		{
			HCESPN.H1410_2++;
		}
		//--, 201214 ysm, MOBILE
		
		if (HCESPN.H941[5] == 0)
		{
			EngineRunTimeCounter++;
			
			if (First_ERTL == 0)
			{
				First_ERTL = 1;
				EngineRumTimeBitSet(HCESPN.H941[3] * 2 + ((HCESPN.H941[4] >= 30) ? 1 : 0));
			}

			if (EngineRunTimeCounter >= 11)
				EngineRumTimeBitSet(HCESPN.H941[3] * 2 + ((HCESPN.H941[4] >= 30) ? 1 : 0));
			
			if ((HCESPN.H941[4] == 29) || (HCESPN.H941[4] == 59))
			{
				EngineRunTimeCounter = 0;
			}
		}
	}

	
}


void EngineRunTimesLog(unsigned char First_ON)
{
	if(First_ON == 1)
	{
		HCESPN.H1402 = 0;
	}

	if ( (((HCESPN.rpm_310  < 8192 ) && (HCESPN.rpm_310 >= 500))||(ALT_Level_Status == 1))&& (Flag_Key_On == 0))
	{
		HCESPN.H1402++;
		Flag_Key_On = 1;
	}
}



void EngineRumTimeBitSet(unsigned char Position)
{
	HCESPN.H1404[Position / 8] |= (1 << (Position % 8));
}


void DailyReportDataInitial(void)
{
	unsigned char i;
	

	for (i = 0; i < 31; i++)
		DailyReport_PowerModeInfo[0][i] = 0;

	for (i = 0; i < 31; i++)
		DailyReport_PowerModeInfo[1][i] = 0;
	
	
	DailyReport_Index = (DailyReport_Index + 1) % 6;
	DailyReport_Send_Status = 0;


	HCESPN.H1400[0] = HCESPN.H941[3];
	HCESPN.H1400[1] = HCESPN.H941[4];
	HCESPN.H1400[2] = HCESPN.H941[5];

	HCESPN.H1401[0] = 0xff; 
	HCESPN.H1401[1] = 0xff;
	HCESPN.H1401[2] = 0xff;

	RCMData_WarmingCount_Today_Send = 0;
	RCMData_ECMFaultCount_Today_Send = 0;
	RCMData_TCUFaultCount_Today_Send = 0;

	RCMData_WarmingCount_Today = 0;
	RCMData_ECMFaultCount_Today = 0;
	RCMData_TCUFaultCount_Today = 0;

	memset(RCMData_WarmingHCESPN_Today, 0, 10);  //mem 15->10
	memset(RCMData_ECMFault_Today, 0, 15);
	memset(RCMData_TCUFault_Today, 0, 15);
	
	HCESPN.H854[3] |= (1 << 7);

	FuelConsumption = 0;
    AD_Weight_Sum =0;
	AD_Weight_Count =0;  
	AD_Weight_Flag = 0;
	AD_Weight_Working_Count = 0;

	//++, 200914 ysm, MOBILE
	Daily_Report_Send_Count_PowerOff = 0;

	HCESPN.H1405 = 0; // 20110511
	HCESPN.H1403 = 0; // 20110511

	HCESPN.H1410_2 = 0; // 20110511
	HCESPN.H1411_2 = 0; // 20110511
	HCESPN.H1412_2 = 0; // 20110511
	HCESPN.H1413_2 = 0;	 // 20110511

	HCESPN.H1414 = 0;

	for (i = 0; i < 6; i++)
	{
		HCESPN.H1404[i] = 0;
	}
	
	HCESPN.H1417 = 0;

	for (i = 0; i < 14; i++)
	{
		HCESPN.H1418[i] = 0;
	}

	for (i = 0; i < 3; i++)		// 20110511
	{
		HCESPN.H1419[i] = 0;
	}

	for (i = 0; i < 6; i++)		// 20110511
	{
		HCESPN.H1422[i] = 0xffff; // NOT USED
	}

	HCESPN.H1915 = 0;		// 20110511
	//--, 200914 ysm, MOBILE
}

void DailyReportDataSave(void)
{
	unsigned char TempData[140]; //++,--, 220720 ysm
	
	EepromWrite(ADDRESS_RCM_DAILYREPORT_DATE + DailyReport_Index * 3, (unsigned char *)(&DailyReport_Date), 3);	
	
	TempData[0] = (unsigned char)(FuelConsumption % 256);
	TempData[1] = (unsigned char)(FuelConsumption / 256);

	EepromWrite(ADDRESS_RCM_DAILYREPORT_FUEL + DailyReport_Index * 2, TempData, 2);	

	//++, 220720 ysm
	make_Remote3PacketData_0x09((struct st_Remote3PacketData_0x09 *)TempData);
	TempData[1] = DailyReport_Date.H940[0];
	TempData[2] = DailyReport_Date.H940[1];
	TempData[3] = DailyReport_Date.H940[2];
	TempData[4] = 23;
	TempData[5] = 59;

	//++, 220726 ysm, FAN_FINAL
	TempData[70] = Last_H304_Data;
	TempData[71] = Last_H536_Data;
	//--, 220726 ysm, FAN_FINAL
	
	EepromWrite(ADDRESS_RCM3_DAILYREPORT_DATA + (unsigned short)(DailyReport_Index) * 128, &TempData[0], 32);
	EepromWrite(ADDRESS_RCM3_DAILYREPORT_DATA + 32 + (unsigned short)(DailyReport_Index) * 128, &TempData[32], 32);
	EepromWrite(ADDRESS_RCM3_DAILYREPORT_DATA + 64 + (unsigned short)(DailyReport_Index) * 128, &TempData[64], 32);
	EepromWrite(ADDRESS_RCM3_DAILYREPORT_DATA + 96 + (unsigned short)(DailyReport_Index) * 128, &TempData[96], 21);
	//--, 220720 ysm


	
}

unsigned char CheckDateChange(void)
{	
	unsigned char DateChangeFlag;	
	
	if (HCESPN.H940[0] >= 8)
	{
		if ((DailyReport_Date.H940[0] != HCESPN.H940[0]) || (DailyReport_Date.H940[1] != HCESPN.H940[1])  || (DailyReport_Date.H940[2] != HCESPN.H940[2]))
		{
			DateChangeFlag = 1;
		}
		else
			DateChangeFlag = 0;
	}
	else
		DateChangeFlag = 0;

	if (DateChangeFlag == 1)
	{
		if (DateChangeCount == 0)
		{
			Date_Before_Change[0] = HCESPN.H940[0];
			Date_Before_Change[1] = HCESPN.H940[1];
			Date_Before_Change[2] = HCESPN.H940[2];

			DateChangeCount = 1;
		}
		else if (DateChangeCount < 3)
		{
			if ((Date_Before_Change[0] == HCESPN.H940[0]) && (Date_Before_Change[1] == HCESPN.H940[1]) && (Date_Before_Change[2] == HCESPN.H940[2]))
			{
				DateChangeCount++;
			}
			else
			{
				DateChangeCount = 0;
			}
		}
	}
	else
		DateChangeCount = 0;
	
	
    if (DateChangeCount >= 3) //++,--, 201218 ysm, MOBILE
	{
		DateChangeCount = 0;
		return 2;
	}
	else if (DateChangeFlag == 1)
		return 1;
	else
		return 0;
}


void History_User_Password_Change(void)
{
	unsigned char size;
	unsigned char i;

	size = strlen(HCESPN.H955);

	for (i = 47; i >= (6 + size); i--)
	{
		HCESPN.H1451[i] = HCESPN.H1451[i - (6 + size)];
	}

	for (i = 0; i < 5; i++)
	{
		HCESPN.H1451[i] = HCESPN.H941[i];
	}

	memcpy(&(HCESPN.H1451[5]), &(HCESPN.H955[0]), size);

	HCESPN.H1451[5 + size] = '*';
}

